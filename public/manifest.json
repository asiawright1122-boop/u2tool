{
  "name": "U2Tool - Free Online Tools",
  "short_name": "U2Tool",
  "description": "200+ free online tools for developers, designers, and creators",
  "start_url": "/en",
  "scope": "/",
  "id": "u2tool-pwa",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "background_color": "#000000",
  "theme_color": "#3b82f6",
  "orientation": "any",
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "handle_links": "preferred",
  "edge_side_panel": {
    "preferred_width": 400
  },
  "icons": [
    {
      "src": "/icons/icon-72x72.png",
      "sizes": "72x72",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/icons/icon-96x96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/icons/icon-128x128.png",
      "sizes": "128x128",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/icons/icon-144x144.png",
      "sizes": "144x144",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/icons/icon-152x152.png",
      "sizes": "152x152",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/icons/icon-384x384.png",
      "sizes": "384x384",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable any"
    }
  ],
  "categories": ["developer tools", "utilities", "productivity"],
  "lang": "en",
  "dir": "ltr",
  "prefer_related_applications": false,
  "related_applications": [],
  "shortcuts": [
    {
      "name": "JSON Formatter",
      "short_name": "JSON",
      "description": "Format and beautify JSON data",
      "url": "/en/tools/json-formatter",
      "icons": [{ "src": "/icons/icon-96x96.png", "sizes": "96x96" }]
    },
    {
      "name": "Base64 Encoder",
      "short_name": "Base64",
      "description": "Encode and decode Base64",
      "url": "/en/tools/base64",
      "icons": [{ "src": "/icons/icon-96x96.png", "sizes": "96x96" }]
    },
    {
      "name": "UUID Generator",
      "short_name": "UUID",
      "description": "Generate unique UUIDs",
      "url": "/en/tools/uuid-generator",
      "icons": [{ "src": "/icons/icon-96x96.png", "sizes": "96x96" }]
    },
    {
      "name": "Password Generator",
      "short_name": "Password",
      "description": "Generate secure passwords",
      "url": "/en/tools/password-generator",
      "icons": [{ "src": "/icons/icon-96x96.png", "sizes": "96x96" }]
    },
    {
      "name": "QR Code Generator",
      "short_name": "QR Code",
      "description": "Generate QR codes",
      "url": "/en/tools/qr-generator",
      "icons": [{ "src": "/icons/icon-96x96.png", "sizes": "96x96" }]
    },
    {
      "name": "Color Converter",
      "short_name": "Color",
      "description": "Convert colors between formats",
      "url": "/en/tools/color-converter",
      "icons": [{ "src": "/icons/icon-96x96.png", "sizes": "96x96" }]
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/desktop.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "U2Tool Desktop View"
    },
    {
      "src": "/screenshots/mobile.png",
      "sizes": "750x1334",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "U2Tool Mobile View"
    }
  ],
  "share_target": {
    "action": "/en/tools/text-statistics",
    "method": "GET",
    "params": {
      "text": "text"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+toolbox",
      "url": "/en/tools/%s"
    }
  ]
}
