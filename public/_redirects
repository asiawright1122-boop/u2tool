# Tool alias redirects - migrated from Next.js middleware TOOL_REDIRECTS
# These handle historical URLs and common misspellings/variations.
#
# Requirements: 5.7, 5.8

# Legacy non-localized routes now map to the default English locale.
/tools /en/tools/ 301
/tools/* /en/tools/:splat/ 301
/categories /en/tools/ 301
/categories/* /en/categories/:splat/ 301
/compare /en/compare/ 301
/compare/* /en/compare/:splat/ 301
/ai /en/ai/ 301

# Deprecated ranking pages no longer exist as standalone routes.
/:locale/tools/ranking/newest /:locale/tools/ 301
/:locale/tools/ranking/popular /:locale/tools/ 301

