{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "u2tool",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-04-09",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "u2tool.com/*",
      "zone_name": "u2tool.com"
    },
    {
      "pattern": "www.u2tool.com/*",
      "zone_name": "u2tool.com"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  // KV namespace named "SESSION" is auto-detected by @astrojs/cloudflare and
  // wired as the storage driver for Astro 6's Sessions API (Astro.session).
  // App code does not yet read/write sessions, but the binding is required
  // for the adapter to enable the API at all. Removing it would disable
  // Astro.session for the whole site. Keep until a deliberate decision is
  // made about whether to ship session-backed features.
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "5820eaf924a84d82b2d3a146d38c1fcd",
      "preview_id": "5820eaf924a84d82b2d3a146d38c1fcd"
    }
  ]
}
