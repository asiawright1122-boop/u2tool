---
/**
 * BaseLayout.astro
 *
 * Base HTML layout for all pages. Handles:
 * - HTML lang and dir attributes (RTL for Arabic)
 * - Meta charset, viewport, title, description, canonical URL
 * - Inline theme-detection script to prevent FOUC
 * - Global CSS import
 * - Named slots for head content and page body
 *
 * Requirements: 6.4, 6.5, 6.6
 */

import { isRTL, locales } from '@/lib/i18n';
import type { Locale } from '@/lib/i18n';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  locale: string;
  canonicalPath?: string;
}

const { title, description, locale, canonicalPath } = Astro.props;

const BASE_URL = import.meta.env.PUBLIC_SITE_URL || 'https://www.u2tool.com';

// Build canonical URL: base + /locale + path (without locale prefix)
const pathWithoutLocale = canonicalPath || Astro.url.pathname.replace(new RegExp(`^/${locale}`), '');
const canonical = `${BASE_URL}/${locale}${pathWithoutLocale}`;

const isRtl = isRTL(locale as Locale);

// Map locale to Open Graph locale format
const ogLocaleMap: Record<string, string> = {
  en: 'en_US',
  zh: 'zh_CN',
  ja: 'ja_JP',
  ko: 'ko_KR',
  es: 'es_ES',
  pt: 'pt_PT',
  fr: 'fr_FR',
  de: 'de_DE',
  ru: 'ru_RU',
  ar: 'ar_AR',
};
const ogLocale = ogLocaleMap[locale] || 'en_US';

// Generate alternate locales for og:locale:alternate
const alternateLocales = locales
  .filter(l => l !== locale)
  .map(l => ogLocaleMap[l] || l);
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'U2Tool',
  url: BASE_URL,
  logo: `${BASE_URL}/favicon.svg`,
  description:
    'Free online tools for developers and designers. 500+ tools including JSON formatter, QR code generator, password generator, and more.',
  sameAs: ['https://github.com/u2tool'],
};
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'U2Tool',
  url: BASE_URL,
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${BASE_URL}/${locale}/tools/?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};
---

<!doctype html>
<html lang={locale} dir={isRtl ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta property="og:locale" content={ogLocale} />
    {alternateLocales.map(altLocale => (
      <meta property="og:locale:alternate" content={altLocale} />
    ))}

    <!-- Organization Schema -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

    <!-- WebSite Schema with SearchAction -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

    <!-- Additional head content (hreflang, structured data, etc.) -->
    <slot name="head" />

    <!-- Inline theme-detection script: runs before render to prevent FOUC -->
    <script is:inline>
      (function () {
        var t = localStorage.getItem('theme');
        var d =
          t === 'dark' ||
          (!t && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', d);
      })();
    </script>
  </head>
  <body class="bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100">
    <slot />
  </body>
</html>
