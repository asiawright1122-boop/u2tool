---
/**
 * BaseLayout.astro
 *
 * Base HTML layout for all pages. Handles:
 * - HTML lang and dir attributes (RTL for Arabic)
 * - Meta charset, viewport, title, description, canonical URL
 * - Inline theme-detection script to prevent FOUC
 * - Global CSS import
 * - Named slots for head content and page body
 *
 * Requirements: 6.4, 6.5, 6.6
 */

import { isRTL, locales } from '@/lib/i18n';
import type { Locale } from '@/lib/i18n';
import { tools } from '@/config/tools';
import {
  buildCanonicalUrl,
  buildOrganizationSchema,
  buildWebsiteSchema,
  resolveMetaDescription,
  resolveSiteDescription,
  withBrand,
} from '@/lib/seo';
import { getPublicSiteUrl, getCfAnalyticsToken } from '@/lib/public-env';
import { buildThemeInitScript } from '@/lib/theme-contract';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  locale: string;
  canonicalPath?: string;
  siteDescription?: string;
  robots?: string;
}

// Enforce strict rendering contract: query routes default to noindex, nofollow
// to prevent duplicate content indexing and canonical URL drifts.
const hasSearchParams = Astro.url.searchParams.size > 0;
import { getDefaultRobots } from '@/lib/robots';
const defaultRobots = getDefaultRobots(hasSearchParams);

const {
  title,
  description,
  locale,
  canonicalPath,
  siteDescription,
  robots = defaultRobots,
} = Astro.props;

const safeDescription = resolveMetaDescription({
  description,
  locale,
  title,
});

const BASE_URL = getPublicSiteUrl();

const pathWithoutLocale = canonicalPath || Astro.url.pathname.replace(new RegExp(`^/${locale}`), '') || '/';
const canonical = buildCanonicalUrl({
  baseUrl: BASE_URL,
  locale: locale as Locale,
  requestUrl: Astro.url,
  canonicalPath,
});

const isRtl = isRTL(locale as Locale);

// Map locale to Open Graph locale format
const ogLocaleMap: Record<string, string> = {
  en: 'en_US',
  zh: 'zh_CN',
  ja: 'ja_JP',
  ko: 'ko_KR',
  es: 'es_ES',
  pt: 'pt_PT',
  fr: 'fr_FR',
  de: 'de_DE',
  ru: 'ru_RU',
  ar: 'ar_AR',
};
const ogLocale = ogLocaleMap[locale] || 'en_US';

// Generate alternate locales for og:locale:alternate
const alternateLocales = locales
  .filter(l => l !== locale)
  .map(l => ogLocaleMap[l] || l);
const isHomePage = pathWithoutLocale === '/' || pathWithoutLocale === '';
const resolvedSiteDescription = resolveSiteDescription(siteDescription, tools.length);
const organizationSchema = buildOrganizationSchema(BASE_URL, resolvedSiteDescription);
const websiteSchema = buildWebsiteSchema(BASE_URL, locale as Locale, resolvedSiteDescription, isHomePage);
const themeInitScript = buildThemeInitScript();
const cfAnalyticsToken = getCfAnalyticsToken();
---

<!doctype html>
<html lang={locale} dir={isRtl ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{withBrand(title)}</title>
    <meta name="description" content={safeDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20260512" />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta property="og:locale" content={ogLocale} />
    {alternateLocales.map(altLocale => (
      <meta property="og:locale:alternate" content={altLocale} />
    ))}

    <!-- Organization Schema -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

    <!-- WebSite Schema with SearchAction -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

    <!-- Additional head content (hreflang, structured data, etc.) -->
    <slot name="head" />

    <!-- Inline theme-detection script: runs before render to prevent FOUC -->
    <script is:inline set:html={themeInitScript} />

    {
      cfAnalyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: cfAnalyticsToken })}
        />
      )
    }
  </head>
  <body class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 min-h-screen relative">
    <!-- Immersive Background System -->
    <div class="ambient-aura"></div>
    
    <slot />
    <script>
      import '@/lib/prefetch-delegation';
    </script>
  </body>
</html>
