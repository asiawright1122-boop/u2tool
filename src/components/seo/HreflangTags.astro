---
/**
 * HreflangTags.astro
 *
 * Generates <link rel="alternate" hreflang="..."> tags for all 10 supported locales
 * plus x-default pointing to the English version.
 * Uses absolute URLs with the production base URL.
 *
 * Requirements: 5.2, 5.3
 */

import { locales } from '@/lib/i18n';
import { getPublicSiteUrl } from '@/lib/public-env';
import { getHreflang } from '@/lib/seo';

interface Props {
  /** Path without locale prefix, e.g. `/tools/json-formatter` */
  path: string;
}

const { path } = Astro.props;

const BASE_URL = getPublicSiteUrl();

// Ensure path starts with /
const normalizedPath = path.startsWith('/') ? path : `/${path}`;
const pathSuffix = normalizedPath === '/' ? '' : normalizedPath;

---

{locales.map((locale) => (
  <link
    rel="alternate"
    hreflang={getHreflang(locale)}
    href={`${BASE_URL}/${locale}${pathSuffix}`}
  />
))}
<link
  rel="alternate"
  hreflang="x-default"
  href={`${BASE_URL}/en${pathSuffix}`}
/>
