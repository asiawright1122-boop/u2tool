---
/**
 * HreflangTags.astro
 *
 * Generates the same eligible language alternate set used by sitemap XML.
 * x-default prefers English when available; an empty set emits no tags.
 * Uses absolute URLs with the production base URL.
 *
 * Requirements: 5.2, 5.3
 */

import { locales as allLocales } from '@/lib/i18n';
import type { Locale } from '@/lib/i18n';
import { getPublicSiteUrl } from '@/lib/public-env';
import { buildLocalizedAlternates } from '@/lib/seo';

interface Props {
  /** Path without locale prefix, e.g. `/tools/json-formatter` */
  path: string;
  /** Optional limited locale set for pages that are not published in every language. */
  locales?: readonly Locale[];
  /** Preferred x-default locale, only used when included in the locale set. */
  xDefaultLocale?: Locale;
}

const {
  path,
  locales = allLocales,
  xDefaultLocale = 'en',
} = Astro.props as Props;

const BASE_URL = getPublicSiteUrl();
const alternates = buildLocalizedAlternates(BASE_URL, path, locales, xDefaultLocale);

---

{alternates.map(({ hreflang, href }) => (
  <link
    rel="alternate"
    hreflang={hreflang}
    href={href}
  />
))}
