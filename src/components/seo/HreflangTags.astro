---
/**
 * HreflangTags.astro
 *
 * Generates <link rel="alternate" hreflang="..."> tags for all 10 supported locales
 * plus x-default pointing to the English version.
 * Uses absolute URLs with the production base URL.
 *
 * Requirements: 5.2, 5.3
 */

import { locales as allLocales } from '@/lib/i18n';
import type { Locale } from '@/lib/i18n';
import { getPublicSiteUrl } from '@/lib/public-env';
import { buildLocalizedPageUrl, getHreflang } from '@/lib/seo';

interface Props {
  /** Path without locale prefix, e.g. `/tools/json-formatter` */
  path: string;
  /** Optional limited locale set for pages that are not published in every language. */
  locales?: readonly Locale[];
  /** Locale used for the x-default alternate. */
  xDefaultLocale?: Locale;
}

const {
  path,
  locales = allLocales,
  xDefaultLocale = 'en',
} = Astro.props as Props;

const BASE_URL = getPublicSiteUrl();

---

{locales.map((locale) => (
  <link
    rel="alternate"
    hreflang={getHreflang(locale)}
    href={buildLocalizedPageUrl(BASE_URL, locale, path)}
  />
))}
<link
  rel="alternate"
  hreflang="x-default"
  href={buildLocalizedPageUrl(BASE_URL, xDefaultLocale, path)}
/>
