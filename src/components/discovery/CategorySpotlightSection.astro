---
import { getIconSvg } from '@/lib/icon-svg';
import type { CategoryDiscoverySpotlight } from '@/lib/discovery-surface';

interface Props {
  description?: string;
  eyebrow?: string;
  popularLabel: string;
  spotlights: CategoryDiscoverySpotlight[];
  title: string;
  toolsCountLabel: string;
}

const { description, eyebrow, popularLabel, spotlights, title, toolsCountLabel } = Astro.props as Props;
---

<section
  data-discovery-surface="category-spotlights"
  class="mb-8 rounded-3xl border border-slate-200/80 bg-gradient-to-br from-white via-slate-50 to-blue-50/70 p-6 shadow-sm dark:border-slate-700/60 dark:from-slate-900 dark:via-slate-900 dark:to-slate-800/80"
>
  <div class="max-w-4xl">
    {eyebrow && (
      <p class="mb-2 text-xs font-semibold uppercase tracking-[0.2em] text-blue-700 dark:text-blue-300">
        {eyebrow}
      </p>
    )}
    <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
      {title}
    </h2>
    {description && (
      <p class="mt-3 max-w-3xl text-sm leading-7 text-slate-700 dark:text-slate-300">
        {description}
      </p>
    )}
  </div>

  <div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
    {spotlights.map((spotlight) => (
      <article
        data-discovery-category={spotlight.category}
        class="rounded-2xl border border-slate-200/80 bg-white/90 p-5 dark:border-slate-700/60 dark:bg-slate-900/70"
      >
        <div class="flex items-start justify-between gap-3">
          <a
            href={spotlight.href}
            class="group min-w-0"
          >
            <div class="flex items-center gap-3">
              <span
                class="inline-flex text-blue-500 dark:text-blue-400"
                set:html={getIconSvg(spotlight.icon, 22)}
              />
              <h3 class="text-base font-semibold text-slate-900 transition-colors group-hover:text-blue-600 dark:text-white dark:group-hover:text-blue-300">
                {spotlight.name}
              </h3>
            </div>
          </a>
          <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-300">
            {spotlight.toolCount} {toolsCountLabel}
          </span>
        </div>

        <p class="mt-3 text-xs uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">
          {spotlight.popularCount} {popularLabel}
        </p>

        <div class="mt-4 flex flex-wrap gap-2">
          {spotlight.tools.map((tool) => (
            <a
              href={tool.href}
              data-discovery-tool={tool.slug}
              title={tool.description || tool.name}
              class="inline-flex items-center rounded-full border border-blue-200 bg-blue-50 px-3 py-1.5 text-xs font-medium text-blue-700 transition-colors hover:border-blue-300 hover:bg-blue-100 dark:border-blue-500/30 dark:bg-blue-500/10 dark:text-blue-200 dark:hover:border-blue-400/40 dark:hover:bg-blue-500/20"
            >
              {tool.name}
            </a>
          ))}
        </div>
      </article>
    ))}
  </div>
</section>
