---
import { getIconSvg } from '@/lib/icon-svg';
import type { CategoryDiscoverySpotlight } from '@/lib/discovery-surface';

interface Props {
  description?: string;
  eyebrow?: string;
  popularLabel: string;
  spotlights: CategoryDiscoverySpotlight[];
  title: string;
  toolsCountLabel: string;
}

const { description, eyebrow, popularLabel, spotlights, title, toolsCountLabel } = Astro.props as Props;
---

<section
  data-discovery-surface="category-spotlights"
  class="mb-10 rounded-3xl border border-slate-200/60 glass shadow-2xl
         dark:border-white/10 dark:bg-slate-900/40 p-8 backdrop-blur-xl relative overflow-hidden"
>
  <div class="absolute inset-0 bg-gradient-to-br from-amber-500/[0.03] to-transparent dark:from-amber-600/[0.05] dark:to-transparent pointer-events-none"></div>
  <div class="max-w-4xl">
    {eyebrow && (
      <p class="mb-3 text-[10px] font-black uppercase tracking-[0.3em] text-amber-600/80 dark:text-amber-500/60">
        {eyebrow}
      </p>
    )}
    <h2 class="text-3xl font-black text-slate-900 dark:text-white tracking-tight drop-shadow-sm">
      {title}
    </h2>
    {description && (
      <p class="mt-4 max-w-3xl text-sm leading-7 text-slate-500 dark:text-slate-400 font-medium">
        {description}
      </p>
    )}
  </div>

  <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
    {spotlights.map((spotlight) => (
      <article
        data-discovery-category={spotlight.category}
        class="glass-card p-6 relative group/card border-slate-200/50 dark:border-white/[0.05]"
      >
        <div class="absolute inset-0 bg-gradient-to-br from-amber-500/[0.02] to-transparent opacity-0 group-hover/card:opacity-100 transition-opacity duration-500 rounded-3xl"></div>
        <div class="relative z-10">
        <div class="flex items-start justify-between gap-3">
          <a
            href={spotlight.href}
            class="group min-w-0"
          >
            <div class="flex items-center gap-3.5">
              <span
                class="inline-flex text-slate-950 dark:text-amber-500 group-hover:scale-110 transition-transform duration-500 drop-shadow-sm dark:drop-shadow-[0_0_12px_rgba(245,158,11,0.4)]"
                set:html={getIconSvg(spotlight.icon, 20)}
              />
              <h3 class="text-base font-bold text-slate-900 transition-colors group-hover:text-amber-600 dark:text-white dark:group-hover:text-amber-400 tracking-tight">
                {spotlight.name}
              </h3>
            </div>
          </a>
          <span class="rounded-lg bg-slate-100 dark:bg-amber-500/5 px-2 py-1 text-[9px] font-black uppercase tracking-wider text-slate-500 dark:text-amber-500/80 border border-slate-200/60 dark:border-amber-500/20 shadow-sm">
            {spotlight.toolCount} {toolsCountLabel}
          </span>
        </div>

        <p class="mt-3 text-[10px] font-bold uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">
          {spotlight.popularCount} {popularLabel}
        </p>

        <div class="mt-4 flex flex-wrap gap-2">
          {spotlight.tools.map((tool) => (
            <a
              href={tool.href}
              data-discovery-tool={tool.slug}
              title={tool.description || tool.name}
              class="inline-flex items-center rounded-full border border-slate-200 bg-white/50 px-3 py-1.5 text-xs font-medium text-slate-700 transition-all hover:border-amber-400 hover:text-amber-600
                     dark:border-slate-700 dark:bg-slate-800/50 dark:text-slate-300 dark:hover:border-amber-500/50 dark:hover:text-amber-400"
            >
              {tool.name}
            </a>
          ))}
        </div>
        </div>
      </article>
    ))}
  </div>
</section>
