---
import { getIconSvg } from '@/lib/icon-svg';
import type { CategoryDiscoverySpotlight } from '@/lib/discovery-surface';

interface Props {
  description?: string;
  eyebrow?: string;
  popularLabel: string;
  spotlights: CategoryDiscoverySpotlight[];
  title: string;
  toolsCountLabel: string;
}

const { description, eyebrow, popularLabel, spotlights, title, toolsCountLabel } = Astro.props as Props;
---

<section
  data-discovery-surface="category-spotlights"
  class="mb-8 rounded-3xl border border-slate-200/60 bg-gradient-to-br from-slate-50 via-white to-slate-100 shadow-xl
         dark:border-slate-800 dark:from-slate-900 dark:via-zinc-900 dark:to-black p-6 backdrop-blur-sm"
>
  <div class="max-w-4xl">
    {eyebrow && (
      <p class="mb-2 text-xs font-semibold uppercase tracking-[0.2em] text-blue-600 dark:text-amber-500/80">
        {eyebrow}
      </p>
    )}
    <h2 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight">
      {title}
    </h2>
    {description && (
      <p class="mt-3 max-w-3xl text-sm leading-7 text-slate-600 dark:text-slate-400">
        {description}
      </p>
    )}
  </div>

  <div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
    {spotlights.map((spotlight) => (
      <article
        data-discovery-category={spotlight.category}
        class="rounded-2xl border border-slate-200/80 bg-white/40 p-5 backdrop-blur-md
               dark:border-slate-800 dark:bg-slate-900/40 hover:shadow-lg hover:border-slate-300 dark:hover:border-slate-700 transition-all duration-300"
      >
        <div class="flex items-start justify-between gap-3">
          <a
            href={spotlight.href}
            class="group min-w-0"
          >
            <div class="flex items-center gap-3">
              <span
                class="inline-flex text-blue-600 dark:text-amber-500"
                set:html={getIconSvg(spotlight.icon, 22)}
              />
              <h3 class="text-base font-semibold text-slate-900 transition-colors group-hover:text-blue-600 dark:text-white dark:group-hover:text-amber-400">
                {spotlight.name}
              </h3>
            </div>
          </a>
          <span class="rounded-full bg-slate-200/50 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-slate-600 dark:bg-slate-800 dark:text-slate-400 border border-slate-300/30 dark:border-slate-700/50">
            {spotlight.toolCount} {toolsCountLabel}
          </span>
        </div>

        <p class="mt-3 text-[10px] font-bold uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">
          {spotlight.popularCount} {popularLabel}
        </p>

        <div class="mt-4 flex flex-wrap gap-2">
          {spotlight.tools.map((tool) => (
            <a
              href={tool.href}
              data-discovery-tool={tool.slug}
              title={tool.description || tool.name}
              class="inline-flex items-center rounded-full border border-slate-200 bg-white/50 px-3 py-1.5 text-xs font-medium text-slate-700 transition-all hover:border-blue-400 hover:text-blue-600
                     dark:border-slate-700 dark:bg-slate-800/50 dark:text-slate-300 dark:hover:border-amber-500/50 dark:hover:text-amber-400"
            >
              {tool.name}
            </a>
          ))}
        </div>
      </article>
    ))}
  </div>
</section>
