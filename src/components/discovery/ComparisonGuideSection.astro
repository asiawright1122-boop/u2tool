---
import type { ComparisonSurfaceGuide } from '@/lib/comparison-surfaces';

interface Props {
  ctaLabel: string;
  description?: string;
  guides: ComparisonSurfaceGuide[];
  includedToolsLabel: string;
  title: string;
}

const { ctaLabel, description, guides, includedToolsLabel, title } = Astro.props as Props;
---

<section
  data-discovery-surface="comparison-guides"
  class="mb-8 rounded-3xl border border-slate-200/60 bg-gradient-to-br from-slate-50 via-white to-slate-100 shadow-xl
         dark:border-slate-800 dark:from-slate-900 dark:via-zinc-900 dark:to-black p-6 backdrop-blur-sm"
>
  <div class="max-w-4xl">
    <h2 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight">
      {title}
    </h2>
    {description && (
      <p class="mt-3 max-w-3xl text-sm leading-7 text-slate-600 dark:text-slate-400">
        {description}
      </p>
    )}
  </div>

  <div class="mt-6 grid gap-4 lg:grid-cols-3">
    {guides.map((guide) => (
      <article
        data-comparison-guide={guide.slug}
        class="flex flex-col h-full rounded-2xl border border-slate-200 bg-white/40 p-5 backdrop-blur-md
               dark:border-slate-800 dark:bg-slate-900/40 hover:shadow-lg hover:border-slate-300 dark:hover:border-slate-700 transition-all duration-300"
      >
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <a href={guide.href} class="group">
              <h3 class="text-base font-semibold text-slate-900 transition-colors group-hover:text-amber-600 dark:text-white dark:group-hover:text-amber-400">
                {guide.title}
              </h3>
            </a>
            <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-400">
              {guide.shortDescription}
            </p>
          </div>
        </div>

        <p class="mt-4 text-[10px] font-bold uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">
          {includedToolsLabel}
        </p>

        <div class="mt-3 flex flex-wrap gap-2">
          {guide.representativeTools.map((tool) => (
            <a
              href={tool.href}
              data-discovery-tool={tool.slug}
              title={tool.description || tool.name}
              class="inline-flex items-center rounded-full border border-slate-200 bg-white/50 px-3 py-1.5 text-xs font-medium text-slate-700 transition-all hover:border-amber-400 hover:text-amber-600
                     dark:border-slate-700 dark:bg-slate-800/50 dark:text-slate-300 dark:hover:border-amber-500/50 dark:hover:text-amber-400"
            >
              {tool.name}
            </a>
          ))}
        </div>

        <div class="mt-auto pt-6">
          <a
            href={guide.href}
            class="inline-flex items-center rounded-full bg-slate-950 px-5 py-2.5 text-sm font-bold border border-slate-800 text-white transition-all
                   hover:bg-black hover:shadow-[0_0_15px_rgba(245,158,11,0.3)] hover:border-amber-500/50
                   dark:bg-white dark:text-slate-900 dark:hover:bg-slate-100 dark:hover:shadow-[0_0_20px_rgba(255,255,255,0.2)]"
          >
            {ctaLabel}
          </a>
        </div>
      </article>
    ))}
  </div>
</section>
