---
import type { ComparisonSurfaceGuide } from '@/lib/comparison-surfaces';

interface Props {
  ctaLabel: string;
  description?: string;
  guides: ComparisonSurfaceGuide[];
  includedToolsLabel: string;
  title: string;
}

const { ctaLabel, description, guides, includedToolsLabel, title } = Astro.props as Props;
---

<section
  data-discovery-surface="comparison-guides"
  class="mb-10 rounded-3xl border border-slate-200/60 glass shadow-2xl
         dark:border-white/10 dark:bg-slate-900/40 p-8 backdrop-blur-xl relative overflow-hidden"
>
  <div class="absolute inset-0 bg-gradient-to-br from-amber-500/5 to-transparent dark:from-amber-600/10 dark:to-transparent pointer-events-none"></div>
  <div class="max-w-4xl">
    <h2 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight">
      {title}
    </h2>
    {description && (
      <p class="mt-3 max-w-3xl text-sm leading-7 text-slate-600 dark:text-slate-400">
        {description}
      </p>
    )}
  </div>

  <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {guides.map((guide) => (
      <article
        data-comparison-guide={guide.slug}
        class="glass-card flex flex-col h-full p-8 relative group/card border-slate-200/50 dark:border-white/[0.05]"
      >
        <div class="absolute inset-0 bg-gradient-to-br from-amber-500/[0.03] to-transparent dark:from-amber-600/[0.05] dark:to-transparent opacity-0 group-hover/card:opacity-100 transition-opacity duration-500 rounded-3xl"></div>
        <div class="relative z-10 flex flex-col h-full">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <a href={guide.href} class="group">
              <h3 class="text-xl font-black text-slate-900 transition-all group-hover:text-amber-600 dark:text-white dark:group-hover:text-amber-400 tracking-tight leading-7">
                {guide.title}
              </h3>
            </a>
            <p class="mt-4 text-sm leading-relaxed text-slate-500 dark:text-slate-400 font-medium">
              {guide.shortDescription}
            </p>
          </div>
        </div>

        <p class="mt-8 text-[10px] font-black uppercase tracking-[0.25em] text-slate-400 dark:text-slate-500/80">
          {includedToolsLabel}
        </p>

        <div class="mt-4 flex flex-wrap gap-2.5">
          {guide.representativeTools.map((tool) => (
            <a
              href={tool.href}
              data-discovery-tool={tool.slug}
              title={tool.description || tool.name}
              class="inline-flex items-center rounded-xl border border-slate-200 bg-white/60 px-4 py-2 text-[11px] font-bold text-slate-600 transition-all hover:border-amber-400 hover:text-amber-600
                     dark:border-white/5 dark:bg-white/[0.02] dark:text-slate-400 dark:hover:border-amber-500/50 dark:hover:text-amber-300 shadow-sm"
            >
              {tool.name}
            </a>
          ))}
        </div>

        <div class="mt-auto pt-10">
          <a
            href={guide.href}
            class="btn-primary !px-6 !py-3 !text-[11px] !rounded-2xl active:scale-95 shadow-lg dark:hover:shadow-amber-500/20"
          >
            {ctaLabel}
          </a>
        </div>
        </div>
      </article>
    ))}
  </div>
</section>
