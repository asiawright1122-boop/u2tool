---
import { getIconSvg } from '@/lib/icon-svg';
import type { OnlineCalculatorClusterGroup } from '@/lib/online-calculator-cluster';

interface Props {
  compact?: boolean;
  ctaLabel: string;
  description: string;
  eyebrow?: string;
  groups: OnlineCalculatorClusterGroup[];
  href: string;
  title: string;
  toolCountLabel: string;
}

const {
  compact = false,
  ctaLabel,
  description,
  eyebrow,
  groups,
  href,
  title,
  toolCountLabel,
} = Astro.props as Props;

const toolLimit = compact ? 4 : 6;
const toolCount = groups.reduce((count, group) => count + group.tools.length, 0);
---

{groups.length > 0 && (
  <section data-discovery-surface="online-calculator-cluster" class="mb-10">
    <div class="mb-6 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div class="max-w-3xl">
        {eyebrow && (
          <p class="mb-3 text-[10px] font-black uppercase tracking-[0.3em] text-emerald-600/80 dark:text-emerald-400/70">
            {eyebrow}
          </p>
        )}
        <h2 class="flex items-center gap-3 text-2xl font-black tracking-tight text-slate-900 dark:text-white md:text-3xl">
          <span class="h-8 w-1 rounded-full bg-emerald-500 dark:shadow-[0_0_12px_rgba(16,185,129,0.55)]"></span>
          {title}
        </h2>
        <p class="mt-3 text-sm font-medium leading-7 text-slate-500 dark:text-slate-400">
          {description}
        </p>
      </div>
      <a
        href={href}
        class="inline-flex items-center justify-center rounded-2xl border border-emerald-400/40 bg-emerald-600 px-5 py-3 text-xs font-black uppercase tracking-[0.18em] text-white shadow-lg shadow-emerald-500/20 transition-all hover:-translate-y-0.5 hover:bg-emerald-700 active:translate-y-0 dark:border-emerald-300/20 dark:bg-emerald-500 dark:hover:bg-emerald-400"
      >
        {ctaLabel}
      </a>
    </div>

    <div class="grid grid-cols-1 gap-4 lg:grid-cols-4">
      {groups.map((group) => (
        <article
          data-online-calculator-group={group.id}
          class="glass-card group/card relative flex min-h-[260px] flex-col overflow-hidden p-6"
        >
          <div class="absolute inset-0 bg-gradient-to-br from-transparent to-emerald-500/5 opacity-0 transition-opacity duration-500 group-hover/card:opacity-100 dark:to-emerald-500/10"></div>
          <div class="relative z-10 flex h-full flex-col">
            <div class="mb-5 flex items-start justify-between gap-4">
              <div class="min-w-0">
                <h3 class="text-base font-black tracking-tight text-slate-900 dark:text-white">
                  {group.title}
                </h3>
                <p class="mt-2 text-xs font-medium leading-6 text-slate-500 dark:text-slate-400">
                  {group.description}
                </p>
              </div>
              <span class="shrink-0 rounded-xl border border-slate-200 bg-white/60 px-2.5 py-1 text-[9px] font-black uppercase tracking-wider text-slate-500 shadow-sm dark:border-white/10 dark:bg-white/5 dark:text-slate-400">
                {group.tools.length} {toolCountLabel}
              </span>
            </div>

            <div class="grid gap-2">
              {group.tools.slice(0, toolLimit).map((tool) => (
                <a
                  href={tool.href}
                  data-online-calculator-tool={tool.slug}
                  title={tool.description || tool.name}
                  class="group/tool flex min-h-[48px] items-center gap-3 rounded-2xl border border-slate-200/60 bg-white/45 px-3 py-2.5 transition-all hover:border-emerald-400 hover:bg-white/80 dark:border-slate-700/80 dark:bg-slate-900/35 dark:hover:border-emerald-500/50 dark:hover:bg-white/5"
                >
                  <span
                    class="inline-flex shrink-0 text-slate-400 transition-all duration-300 group-hover/tool:scale-110 group-hover/tool:text-emerald-500 dark:text-slate-500"
                    set:html={getIconSvg(tool.icon, 18)}
                  />
                  <span class="min-w-0 flex-1 truncate text-xs font-bold text-slate-700 transition-colors group-hover/tool:text-emerald-700 dark:text-slate-200 dark:group-hover/tool:text-emerald-300">
                    {tool.name}
                  </span>
                </a>
              ))}
            </div>

            <a
              href={href}
              class="mt-auto pt-5 text-[10px] font-black uppercase tracking-[0.22em] text-emerald-600 transition-colors hover:text-emerald-700 dark:text-emerald-400 dark:hover:text-emerald-300"
              aria-label={`${ctaLabel}: ${title} (${toolCount} ${toolCountLabel})`}
            >
              {ctaLabel}
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
)}
