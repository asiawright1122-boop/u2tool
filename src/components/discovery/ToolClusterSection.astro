---
import { getIconSvg } from '@/lib/icon-svg';
import type { ClusterColorTheme, ToolClusterGroup } from '@/lib/tool-cluster-types';

interface Props {
  compact?: boolean;
  ctaLabel: string;
  description: string;
  eyebrow?: string;
  groups: ToolClusterGroup[];
  href: string;
  title: string;
  toolCountLabel: string;
  /**
   * Color theme controlling eyebrow, bar, CTA, gradient and hover accents.
   */
  theme: ClusterColorTheme;
  /**
   * Kebab-case identifier used in `data-discovery-surface`,
   * `data-tool-cluster-group` and `data-tool` attributes.
   */
  dataPrefix: string;
  /**
   * Number of grid columns at the `lg:` breakpoint. Defaults to 4.
   * Clusters with only 3 groups (creator-seo) pass 3.
   */
  gridCols?: 3 | 4;
}

const {
  compact = false,
  ctaLabel,
  description,
  eyebrow,
  groups,
  href,
  title,
  toolCountLabel,
  theme,
  dataPrefix,
  gridCols = 4,
} = Astro.props as Props;

const toolLimit = compact ? 4 : 6;
const toolCount = groups.reduce((count, group) => count + group.tools.length, 0);
const gridClass = gridCols === 3 ? 'lg:grid-cols-3' : 'lg:grid-cols-4';

/**
 * Tailwind color classes keyed by cluster theme.
 *
 * `eyebrow` / `bar` / `cta` mirror the cluster-card theme mapping so the hub
 * section and the per-tool discovery card stay visually consistent.
 * `cardLink`, `cardToolHover`, `cardIconHover`, `cardTextHover` and `gradient`
 * are specific to this multi-card section.
 */
const themeStyles: Record<ClusterColorTheme, {
  eyebrow: string;
  bar: string;
  cta: string;
  gradient: string;
  cardToolHover: string;
  cardIconHover: string;
  cardTextHover: string;
  cardLink: string;
}> = {
  amber: {
    eyebrow: 'text-amber-600/80 dark:text-amber-500/60',
    bar: 'bg-amber-500 dark:shadow-[0_0_12px_rgba(245,158,11,0.6)]',
    cta: 'border-amber-400/40 bg-amber-500 hover:bg-amber-600 active:translate-y-0 dark:border-amber-300/20 dark:bg-amber-500 dark:hover:bg-amber-400 shadow-amber-500/20',
    gradient: 'from-transparent to-amber-500/5 dark:to-amber-500/10',
    cardToolHover: 'hover:border-amber-400 hover:bg-white/80 dark:hover:border-amber-500/50 dark:hover:bg-white/5',
    cardIconHover: 'group-hover/tool:scale-110 group-hover/tool:text-amber-500',
    cardTextHover: 'group-hover/tool:text-amber-700 dark:group-hover/tool:text-amber-400',
    cardLink: 'text-amber-600 hover:text-amber-700 dark:text-amber-400 dark:hover:text-amber-300',
  },
  cyan: {
    eyebrow: 'text-cyan-600/80 dark:text-cyan-400/70',
    bar: 'bg-cyan-500 dark:shadow-[0_0_12px_rgba(6,182,212,0.55)]',
    cta: 'border-cyan-400/40 bg-cyan-600 hover:bg-cyan-700 active:translate-y-0 dark:border-cyan-300/20 dark:bg-cyan-500 dark:hover:bg-cyan-400 shadow-cyan-500/20',
    gradient: 'from-transparent to-cyan-500/5 dark:to-cyan-500/10',
    cardToolHover: 'hover:border-cyan-400 hover:bg-white/80 dark:hover:border-cyan-500/50 dark:hover:bg-white/5',
    cardIconHover: 'group-hover/tool:scale-110 group-hover/tool:text-cyan-500',
    cardTextHover: 'group-hover/tool:text-cyan-700 dark:group-hover/tool:text-cyan-300',
    cardLink: 'text-cyan-600 hover:text-cyan-700 dark:text-cyan-400 dark:hover:text-cyan-300',
  },
  emerald: {
    eyebrow: 'text-emerald-600/80 dark:text-emerald-400/70',
    bar: 'bg-emerald-500 dark:shadow-[0_0_12px_rgba(16,185,129,0.55)]',
    cta: 'border-emerald-400/40 bg-emerald-600 hover:bg-emerald-700 active:translate-y-0 dark:border-emerald-300/20 dark:bg-emerald-500 dark:hover:bg-emerald-400 shadow-emerald-500/20',
    gradient: 'from-transparent to-emerald-500/5 dark:to-emerald-500/10',
    cardToolHover: 'hover:border-emerald-400 hover:bg-white/80 dark:hover:border-emerald-500/50 dark:hover:bg-white/5',
    cardIconHover: 'group-hover/tool:scale-110 group-hover/tool:text-emerald-500',
    cardTextHover: 'group-hover/tool:text-emerald-700 dark:group-hover/tool:text-emerald-300',
    cardLink: 'text-emerald-600 hover:text-emerald-700 dark:text-emerald-400 dark:hover:text-emerald-300',
  },
  rose: {
    eyebrow: 'text-rose-600/80 dark:text-rose-400/70',
    bar: 'bg-rose-500 dark:shadow-[0_0_12px_rgba(244,63,94,0.55)]',
    cta: 'border-rose-400/40 bg-rose-600 hover:bg-rose-700 active:translate-y-0 dark:border-rose-300/20 dark:bg-rose-500 dark:hover:bg-rose-400 shadow-rose-500/20',
    gradient: 'from-transparent to-rose-500/5 dark:to-rose-500/10',
    cardToolHover: 'hover:border-rose-400 hover:bg-white/80 dark:hover:border-rose-500/50 dark:hover:bg-white/5',
    cardIconHover: 'group-hover/tool:scale-110 group-hover/tool:text-rose-500',
    cardTextHover: 'group-hover/tool:text-rose-700 dark:group-hover/tool:text-rose-300',
    cardLink: 'text-rose-600 hover:text-rose-700 dark:text-rose-400 dark:hover:text-rose-300',
  },
  sky: {
    eyebrow: 'text-sky-600/80 dark:text-sky-400/70',
    bar: 'bg-sky-500 dark:shadow-[0_0_12px_rgba(14,165,233,0.55)]',
    cta: 'border-sky-400/40 bg-sky-600 hover:bg-sky-700 active:translate-y-0 dark:border-sky-300/20 dark:bg-sky-500 dark:hover:bg-sky-400 shadow-sky-500/20',
    gradient: 'from-transparent to-sky-500/5 dark:to-sky-500/10',
    cardToolHover: 'hover:border-sky-400 hover:bg-white/80 dark:hover:border-sky-500/50 dark:hover:bg-white/5',
    cardIconHover: 'group-hover/tool:scale-110 group-hover/tool:text-sky-500',
    cardTextHover: 'group-hover/tool:text-sky-700 dark:group-hover/tool:text-sky-300',
    cardLink: 'text-sky-600 hover:text-sky-700 dark:text-sky-400 dark:hover:text-sky-300',
  },
};

const styles = themeStyles[theme];
---

{groups.length > 0 && (
  <section data-discovery-surface={dataPrefix} class="mb-10">
    <div class="mb-6 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div class="max-w-3xl">
        {eyebrow && (
          <p class:list={['mb-3 text-[10px] font-black uppercase tracking-[0.3em]', styles.eyebrow]}>
            {eyebrow}
          </p>
        )}
        <h2 class="flex items-center gap-3 text-2xl font-black tracking-tight text-slate-900 dark:text-white md:text-3xl">
          <span class:list={['h-8 w-1 rounded-full', styles.bar]}></span>
          {title}
        </h2>
        <p class="mt-3 text-sm font-medium leading-7 text-slate-500 dark:text-slate-400">
          {description}
        </p>
      </div>
      <a
        href={href}
        class:list={[
          'inline-flex items-center justify-center rounded-2xl border px-5 py-3 text-xs font-black uppercase tracking-[0.18em] text-white shadow-lg transition-all hover:-translate-y-0.5',
          styles.cta,
        ]}
      >
        {ctaLabel}
      </a>
    </div>

    <div class:list={['grid grid-cols-1 gap-4', gridClass]}>
      {groups.map((group) => (
        <article
          data-tool-cluster-group={group.id}
          class="glass-card group/card relative flex min-h-[260px] flex-col overflow-hidden p-6"
        >
          <div class:list={['absolute inset-0 bg-gradient-to-br opacity-0 transition-opacity duration-500 group-hover/card:opacity-100', styles.gradient]}></div>
          <div class="relative z-10 flex h-full flex-col">
            <div class="mb-5 flex items-start justify-between gap-4">
              <div class="min-w-0">
                <h3 class="text-base font-black tracking-tight text-slate-900 dark:text-white">
                  {group.title}
                </h3>
                <p class="mt-2 text-xs font-medium leading-6 text-slate-500 dark:text-slate-400">
                  {group.description}
                </p>
              </div>
              <span class="shrink-0 rounded-xl border border-slate-200 bg-white/60 px-2.5 py-1 text-[9px] font-black uppercase tracking-wider text-slate-500 shadow-sm dark:border-white/10 dark:bg-white/5 dark:text-slate-400">
                {group.tools.length} {toolCountLabel}
              </span>
            </div>

            <div class="grid gap-2">
              {group.tools.slice(0, toolLimit).map((tool) => (
                <a
                  href={tool.href}
                  data-tool={tool.slug}
                  title={tool.description || tool.name}
                  class:list={[
                    'group/tool flex min-h-[48px] items-center gap-3 rounded-2xl border border-slate-200/60 bg-white/45 px-3 py-2.5 transition-all dark:border-slate-700/80 dark:bg-slate-900/35',
                    styles.cardToolHover,
                  ]}
                >
                  <span
                    class:list={[
                      'inline-flex shrink-0 text-slate-400 transition-all duration-300 dark:text-slate-500',
                      styles.cardIconHover,
                    ]}
                    set:html={getIconSvg(tool.icon, 18)}
                  />
                  <span class:list={['min-w-0 flex-1 truncate text-xs font-bold text-slate-700 transition-colors dark:text-slate-200', styles.cardTextHover]}>
                    {tool.name}
                  </span>
                </a>
              ))}
            </div>

            <a
              href={href}
              class:list={['mt-auto pt-5 text-[10px] font-black uppercase tracking-[0.22em] transition-colors', styles.cardLink]}
              aria-label={`${ctaLabel}: ${title} (${toolCount} ${toolCountLabel})`}
            >
              {ctaLabel}
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
)}
