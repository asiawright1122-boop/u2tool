---
import { getLocalizedPath } from '@/lib/i18n';
import type { Locale } from '@/lib/i18n';
import type { CategorySupportContent } from '@/lib/category-support';

interface Props {
  content: CategorySupportContent;
  locale: Locale;
  toolDescriptions: Record<string, string>;
  toolNames: Record<string, string>;
}

const { content, locale, toolDescriptions, toolNames } = Astro.props as Props;
---

<section
  data-category-support="true"
  class="mb-8 rounded-3xl border border-slate-200/80 bg-gradient-to-br from-white via-slate-50 to-blue-50/70 p-6 shadow-sm dark:border-slate-700/60 dark:from-slate-900 dark:via-slate-900 dark:to-slate-800/80"
>
  <div class="max-w-5xl">
    <p class="mb-2 text-xs font-semibold uppercase tracking-[0.2em] text-blue-700 dark:text-blue-300">
      {content.eyebrow}
    </p>
    <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
      {content.title}
    </h2>
    <p class="mt-3 max-w-3xl text-sm leading-7 text-slate-700 dark:text-slate-300">
      {content.intro}
    </p>
  </div>

  <div class="mt-6 grid gap-6 lg:grid-cols-[1.1fr_1.9fr]">
    <div class="rounded-2xl border border-slate-200/80 bg-white/90 p-5 dark:border-slate-700/60 dark:bg-slate-900/70">
      <h3 class="text-sm font-semibold text-slate-900 dark:text-white">
        {content.highlightsTitle}
      </h3>
      <ul class="mt-3 space-y-3 text-sm leading-6 text-slate-700 dark:text-slate-300">
        {content.highlights.map((item) => (
          <li class="flex gap-3">
            <span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-blue-500 dark:bg-blue-400" />
            <span>{item}</span>
          </li>
        ))}
      </ul>

      <div class="mt-5 rounded-2xl bg-slate-100/80 p-4 dark:bg-slate-800/80">
        <h4 class="text-sm font-semibold text-slate-900 dark:text-white">
          {content.noteTitle}
        </h4>
        <p class="mt-2 text-sm leading-6 text-slate-700 dark:text-slate-300">
          {content.note}
        </p>
      </div>
    </div>

    <div>
      <h3 class="text-sm font-semibold text-slate-900 dark:text-white">
        {content.workflowsTitle}
      </h3>
      <div class="mt-3 grid gap-4 md:grid-cols-3">
        {content.workflows.map((workflow) => (
          <article
            data-support-workflow={workflow.title}
            class="rounded-2xl border border-slate-200/80 bg-white/90 p-5 dark:border-slate-700/60 dark:bg-slate-900/70"
          >
            <h4 class="text-base font-semibold text-slate-900 dark:text-white">
              {workflow.title}
            </h4>
            <p class="mt-2 text-sm leading-6 text-slate-700 dark:text-slate-300">
              {workflow.description}
            </p>

            <div class="mt-4 flex flex-wrap gap-2">
              {workflow.toolSlugs.map((slug) => (
                <a
                  href={getLocalizedPath(locale, `/tools/${slug}`)}
                  data-support-tool={slug}
                  class="inline-flex items-center rounded-full border border-blue-200 bg-blue-50 px-3 py-1.5 text-xs font-medium text-blue-700 transition-colors hover:border-blue-300 hover:bg-blue-100 dark:border-blue-500/30 dark:bg-blue-500/10 dark:text-blue-200 dark:hover:border-blue-400/40 dark:hover:bg-blue-500/20"
                  title={toolDescriptions[slug] || toolNames[slug] || slug}
                >
                  {toolNames[slug] || slug}
                </a>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
