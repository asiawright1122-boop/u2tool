---
/**
 * Breadcrumb.astro
 *
 * Renders breadcrumb navigation with JSON-LD BreadcrumbList structured data.
 * Pure static Astro component (no client-side JS).
 *
 * Requirements: 6.7
 */

import { getPublicSiteUrl } from '@/lib/public-env';

interface BreadcrumbItem {
  label: string;
  href: string;
}

interface Props {
  locale: string;
  items: BreadcrumbItem[];
}

const { items } = Astro.props;

const BASE_URL = getPublicSiteUrl();

// Generate JSON-LD BreadcrumbList structured data
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    item: item.href.startsWith('http') ? item.href : `${BASE_URL}${item.href}`,
  })),
};
---

<!-- JSON-LD Structured Data -->
<script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

<!-- Breadcrumb Navigation -->
<nav aria-label="Breadcrumb" class="py-3 px-0">
  <ol class="flex items-center flex-wrap gap-2 text-[10px] font-black uppercase tracking-[0.2em] text-slate-400 dark:text-slate-500">
    {items.map((item, index) => (
      <li class="flex items-center">
        {index > 0 && (
          <span class="mx-3.5 text-slate-300 dark:text-white/10 flex-shrink-0">
            <svg class="w-3 h-3" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <path d="m9 18 6-6-6-6"/>
            </svg>
          </span>
        )}
        {index === items.length - 1 ? (
          <span class="text-slate-900 dark:text-amber-500 font-bold truncate max-w-[150px] sm:max-w-xs md:max-w-md lg:max-w-none drop-shadow-[0_2px_8px_rgba(245,158,11,0.2)]">
            {item.label}
          </span>
        ) : (
          <a
            href={item.href}
            class="hover:text-amber-600 dark:hover:text-amber-400 transition-all duration-300 truncate max-w-[150px] sm:max-w-xs md:max-w-md lg:max-w-none hover:underline hover:underline-offset-4 decoration-amber-500/30"
          >
            {item.label}
          </a>
        )}
      </li>
    ))}
  </ol>
</nav>
