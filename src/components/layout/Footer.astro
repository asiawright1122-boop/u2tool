---
/**
 * Footer.astro
 *
 * Pure static Astro component (no client-side JS).
 * Shows copyright, links, and site info.
 *
 * Requirements: 6.1
 */

import { getLocalizedPath } from '@/lib/i18n';
import { getIconSvg } from '@/lib/icon-svg';
import type { Locale } from '@/lib/i18n';

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const currentYear = new Date().getFullYear();

const homePath = getLocalizedPath(locale as Locale, '/');
const toolsPath = getLocalizedPath(locale as Locale, '/tools');
const aboutPath = getLocalizedPath(locale as Locale, '/about');
const privacyPath = getLocalizedPath(locale as Locale, '/privacy');
const termsPath = getLocalizedPath(locale as Locale, '/terms');
const contactPath = getLocalizedPath(locale as Locale, '/contact');
---

<footer class="border-t border-slate-200 dark:border-white/5 bg-white dark:bg-slate-950 relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-b from-transparent to-amber-500/[0.02] dark:to-amber-500/[0.03] pointer-events-none"></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      <!-- Brand -->
      <div>
        <a href={homePath} class="flex items-center gap-2 text-xl font-bold text-slate-900 dark:text-white group">
          <span class="text-amber-500 transition-transform group-hover:scale-110 duration-500 drop-shadow-[0_0_15px_rgba(245,158,11,0.5)]" set:html={getIconSvg('gem', 24)} />
          <span class="tracking-tight">U2<span class="text-amber-500">Tool</span></span>
        </a>
        <p class="mt-4 text-sm text-slate-600 dark:text-slate-400 leading-relaxed max-w-xs font-medium">
          Premium online tool collection for developers and creative professionals. Built for speed and privacy.
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-xs font-black text-slate-900 dark:text-slate-300 uppercase tracking-[0.2em] mb-6">
          Navigation
        </h3>
        <ul class="space-y-4">
          <li>
            <a href={homePath}
               class="text-sm font-bold text-slate-400 hover:text-amber-600 dark:text-slate-600 dark:hover:text-amber-500 transition-all duration-300 flex items-center gap-2 group/link">
              <span class="w-1 h-1 rounded-full bg-slate-300 dark:bg-slate-800 transition-all group-hover/link:w-3 group-hover/link:bg-amber-500"></span>
              Home
            </a>
          </li>
          <li>
            <a href={toolsPath}
               class="text-sm font-bold text-slate-400 hover:text-amber-600 dark:text-slate-600 dark:hover:text-amber-500 transition-all duration-300 flex items-center gap-2 group/link">
              <span class="w-1 h-1 rounded-full bg-slate-300 dark:bg-slate-800 transition-all group-hover/link:w-3 group-hover/link:bg-amber-500"></span>
              All Tools
            </a>
          </li>
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h3 class="text-xs font-black text-slate-900 dark:text-slate-300 uppercase tracking-[0.2em] mb-6">
          Platform
        </h3>
        <ul class="space-y-4">
          <li>
            <a href={aboutPath}
               class="text-sm font-bold text-slate-400 hover:text-amber-600 dark:text-slate-600 dark:hover:text-amber-500 transition-all duration-300 flex items-center gap-2 group/link">
              <span class="w-1 h-1 rounded-full bg-slate-300 dark:bg-slate-800 transition-all group-hover/link:w-3 group-hover/link:bg-amber-500"></span>
              About
            </a>
          </li>
          <li>
            <a href={privacyPath}
               class="text-sm font-bold text-slate-400 hover:text-amber-600 dark:text-slate-600 dark:hover:text-amber-500 transition-all duration-300 flex items-center gap-2 group/link">
              <span class="w-1 h-1 rounded-full bg-slate-300 dark:bg-slate-800 transition-all group-hover/link:w-3 group-hover/link:bg-amber-500"></span>
              Privacy Policy
            </a>
          </li>
          <li>
            <a href={termsPath}
               class="text-sm font-bold text-slate-400 hover:text-amber-600 dark:text-slate-600 dark:hover:text-amber-500 transition-all duration-300 flex items-center gap-2 group/link">
              <span class="w-1 h-1 rounded-full bg-slate-300 dark:bg-slate-800 transition-all group-hover/link:w-3 group-hover/link:bg-amber-500"></span>
              Terms of Service
            </a>
          </li>
          <li>
            <a href={contactPath}
               class="text-sm font-bold text-slate-400 hover:text-amber-600 dark:text-slate-600 dark:hover:text-amber-500 transition-all duration-300 flex items-center gap-2 group/link">
              <span class="w-1 h-1 rounded-full bg-slate-300 dark:bg-slate-800 transition-all group-hover/link:w-3 group-hover/link:bg-amber-500"></span>
              Contact
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Copyright -->
    <div class="mt-12 pt-8 border-t border-slate-200 dark:border-white/5">
      <p class="text-center text-[11px] font-bold uppercase tracking-[0.1em] text-slate-500 dark:text-slate-600">
        &copy; {currentYear} <span class="text-slate-900 dark:text-slate-400">U2Tool</span>. Crafted for Excellence.
      </p>
    </div>
  </div>
</footer>
