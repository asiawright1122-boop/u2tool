---
import type { ToolCapabilityProfile } from '@/config/tool-capabilities';
import type { Locale } from '@/lib/i18n';
import { buildToolCapabilityDisclosure } from '@/lib/tool-capability-disclosure';

interface Props {
  profile: ToolCapabilityProfile;
  locale: Locale;
  messages: Record<string, unknown>;
}

const { profile, locale, messages } = Astro.props;
const disclosure = buildToolCapabilityDisclosure(profile, locale, messages);
const headingId = `tool-capability-${profile.slug}`;
const localCapabilities = [
  ...disclosure.localModes,
  ...disclosure.browserFeatures,
];
---

<section
  class="glass-card mb-10 overflow-hidden p-6 md:p-10"
  aria-labelledby={headingId}
  data-tool-capability={profile.slug}
  data-capability-version={profile.version}
  data-local-processing="true"
>
  <h2
    id={headingId}
    class="mb-8 flex items-center gap-3 text-2xl font-bold tracking-tight text-slate-900 dark:text-white md:text-3xl"
  >
    <span class="h-8 w-1 rounded-full bg-emerald-500"></span>
    {disclosure.title}
  </h2>

  <div class="grid gap-5 lg:grid-cols-2">
    <article class="rounded-2xl border border-emerald-200/70 bg-emerald-50/60 p-5 dark:border-emerald-400/20 dark:bg-emerald-950/20">
      <h3 class="text-sm font-black uppercase tracking-[0.14em] text-emerald-700 dark:text-emerald-300">
        {disclosure.runsLocally}
      </h3>
      {localCapabilities.length > 0 && (
        <ul class="mt-4 space-y-2 text-sm text-slate-700 dark:text-slate-300">
          {localCapabilities.map((capability) => (
            <li class="flex gap-2">
              <span aria-hidden="true" class="text-emerald-500">•</span>
              <span>{capability}</span>
            </li>
          ))}
        </ul>
      )}
      <p class="mt-4 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
        {disclosure.privacyLocal}
      </p>
    </article>

    {disclosure.optionalServer && (
      <article class="rounded-2xl border border-sky-200/70 bg-sky-50/60 p-5 dark:border-sky-400/20 dark:bg-sky-950/20">
        <h3 class="text-sm font-black uppercase tracking-[0.14em] text-sky-700 dark:text-sky-300">
          {disclosure.optionalServer.heading}
        </h3>
        {[...disclosure.optionalServer.modes, ...disclosure.optionalServer.features].length > 0 && (
          <ul class="mt-4 space-y-2 text-sm text-slate-700 dark:text-slate-300">
            {[...disclosure.optionalServer.modes, ...disclosure.optionalServer.features].map((capability) => (
              <li class="flex gap-2">
                <span aria-hidden="true" class="text-sky-500">•</span>
                <span>{capability}</span>
              </li>
            ))}
          </ul>
        )}
        <p class="mt-4 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
          {disclosure.optionalServer.privacy}
        </p>
      </article>
    )}
  </div>

  <div class="mt-5 grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
    <article class="rounded-2xl border border-slate-200/70 bg-white/50 p-5 dark:border-white/10 dark:bg-white/[0.02]">
      <h3 class="text-sm font-bold text-slate-900 dark:text-white">
        {disclosure.acceptedInputsLabel}
      </h3>
      <ul class="mt-3 space-y-2 text-sm text-slate-600 dark:text-slate-400">
        {disclosure.acceptedInputs.map((input) => <li>{input}</li>)}
      </ul>
    </article>

    <article class="rounded-2xl border border-slate-200/70 bg-white/50 p-5 dark:border-white/10 dark:bg-white/[0.02]">
      <h3 class="text-sm font-bold text-slate-900 dark:text-white">
        {disclosure.producedOutputsLabel}
      </h3>
      <ul class="mt-3 space-y-2 text-sm text-slate-600 dark:text-slate-400">
        {disclosure.producedOutputs.map((output) => <li>{output}</li>)}
      </ul>
    </article>

    <article class="rounded-2xl border border-slate-200/70 bg-white/50 p-5 dark:border-white/10 dark:bg-white/[0.02]">
      <h3 class="text-sm font-bold text-slate-900 dark:text-white">
        {disclosure.supportedLanguageLabel}
      </h3>
      <ul class="mt-3 space-y-2 text-sm text-slate-600 dark:text-slate-400">
        {disclosure.supportedLanguages.map((language) => <li>{language}</li>)}
      </ul>
    </article>

    <article class="rounded-2xl border border-slate-200/70 bg-white/50 p-5 dark:border-white/10 dark:bg-white/[0.02]">
      <h3 class="text-sm font-bold text-slate-900 dark:text-white">
        {disclosure.limitsLabel}
      </h3>
      <ul class="mt-3 space-y-2 text-sm text-slate-600 dark:text-slate-400">
        {disclosure.limits.map((limit) => <li>{limit}</li>)}
      </ul>
    </article>
  </div>
</section>
