---
import { getIconSvg } from '@/lib/icon-svg';
import type { ToolClusterCardCopy, ToolClusterGroup, ClusterColorTheme } from '@/lib/tool-cluster-types';

interface Props {
  clusterHref: string;
  copy: ToolClusterCardCopy;
  currentSlug: string;
  group: ToolClusterGroup;
  /** Kebab-case identifier used in `data-tool-cluster` and `data-sibling-tool` attributes. */
  dataPrefix: string;
  theme: ClusterColorTheme;
}

const { clusterHref, copy, currentSlug, dataPrefix, group, theme } = Astro.props as Props;
const siblingTools = group.tools.filter((tool) => tool.slug !== currentSlug).slice(0, 5);

/** Tailwind color classes keyed by cluster theme. */
const themeStyles: Record<ClusterColorTheme, {
  eyebrow: string;
  bar: string;
  cta: string;
  pillHover: string;
}> = {
  amber: {
    eyebrow: 'text-amber-600/80 dark:text-amber-500/70',
    bar: 'bg-amber-500 dark:shadow-[0_0_12px_rgba(245,158,11,0.6)]',
    cta: 'border-amber-400/40 bg-amber-500 hover:bg-amber-600 active:translate-y-0 dark:border-amber-300/20 dark:bg-amber-500 dark:hover:bg-amber-400 shadow-amber-500/20',
    pillHover: 'hover:border-amber-400 hover:text-amber-700 dark:hover:border-amber-500/50 dark:hover:text-amber-400',
  },
  cyan: {
    eyebrow: 'text-cyan-600/80 dark:text-cyan-400/70',
    bar: 'bg-cyan-500 dark:shadow-[0_0_12px_rgba(6,182,212,0.55)]',
    cta: 'border-cyan-400/40 bg-cyan-600 hover:bg-cyan-700 active:translate-y-0 dark:border-cyan-300/20 dark:bg-cyan-500 dark:hover:bg-cyan-400 shadow-cyan-500/20',
    pillHover: 'hover:border-cyan-400 hover:text-cyan-700 dark:hover:border-cyan-500/50 dark:hover:text-cyan-300',
  },
  emerald: {
    eyebrow: 'text-emerald-600/80 dark:text-emerald-400/70',
    bar: 'bg-emerald-500 dark:shadow-[0_0_12px_rgba(16,185,129,0.55)]',
    cta: 'border-emerald-400/40 bg-emerald-600 hover:bg-emerald-700 active:translate-y-0 dark:border-emerald-300/20 dark:bg-emerald-500 dark:hover:bg-emerald-400 shadow-emerald-500/20',
    pillHover: 'hover:border-emerald-400 hover:text-emerald-700 dark:hover:border-emerald-500/50 dark:hover:text-emerald-300',
  },
  rose: {
    eyebrow: 'text-rose-600/80 dark:text-rose-400/70',
    bar: 'bg-rose-500 dark:shadow-[0_0_12px_rgba(244,63,94,0.55)]',
    cta: 'border-rose-400/40 bg-rose-600 hover:bg-rose-700 active:translate-y-0 dark:border-rose-300/20 dark:bg-rose-500 dark:hover:bg-rose-400 shadow-rose-500/20',
    pillHover: 'hover:border-rose-400 hover:text-rose-700 dark:hover:border-rose-500/50 dark:hover:text-rose-300',
  },
  sky: {
    eyebrow: 'text-sky-600/80 dark:text-sky-400/70',
    bar: 'bg-sky-500 dark:shadow-[0_0_12px_rgba(14,165,233,0.55)]',
    cta: 'border-sky-400/40 bg-sky-600 hover:bg-sky-700 active:translate-y-0 dark:border-sky-300/20 dark:bg-sky-500 dark:hover:bg-sky-400 shadow-sky-500/20',
    pillHover: 'hover:border-sky-400 hover:text-sky-700 dark:hover:border-sky-500/50 dark:hover:text-sky-300',
  },
};

const styles = themeStyles[theme];
---

<section
  data-tool-cluster={dataPrefix}
  data-tool-cluster-group={group.id}
  class="glass-card mb-10 overflow-hidden p-6 md:p-8"
>
  <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
    <div class="max-w-4xl">
      <p class:list={['mb-3 text-[10px] font-black uppercase tracking-[0.24em]', styles.eyebrow]}>
        {copy.eyebrow}
      </p>
      <h2 class="flex items-center gap-3 text-2xl font-black tracking-tight text-slate-900 dark:text-white md:text-3xl">
        <span class:list={['h-8 w-1 rounded-full', styles.bar]}></span>
        {group.title}
      </h2>
      <p class="mt-3 text-sm font-medium leading-7 text-slate-500 dark:text-slate-400">
        {group.description}
      </p>
    </div>

    <a
      href={clusterHref}
      class:list={[
        'inline-flex shrink-0 items-center justify-center rounded-2xl px-5 py-3 text-xs font-black uppercase tracking-[0.18em] text-white shadow-lg transition-all hover:-translate-y-0.5',
        styles.cta,
      ]}
    >
      {copy.ctaLabel}
    </a>
  </div>

  {siblingTools.length > 0 && (
    <div class="mt-6 flex flex-wrap gap-2">
      {siblingTools.map((tool) => (
        <a
          href={tool.href}
          data-sibling-tool={tool.slug}
          title={tool.description || tool.name}
          class:list={[
            'inline-flex max-w-full items-center gap-2 rounded-full border border-slate-200 bg-white/60 px-3.5 py-2 text-xs font-bold text-slate-700 transition-all dark:border-slate-700 dark:bg-slate-800/60 dark:text-slate-200',
            styles.pillHover,
          ]}
        >
          <span class="inline-flex shrink-0 text-slate-400 dark:text-slate-500" set:html={getIconSvg(tool.icon, 14)} />
          <span class="truncate">{tool.name}</span>
        </a>
      ))}
    </div>
  )}
</section>
