---
import GanttChartGenerator from '@/components/tools/GanttChartGenerator.svelte';
import en from '@/messages/en.json';
import ganttMessages from '@/messages/en/tools/gantt-chart-generator.json';

const translations = {
  ...en,
  tools: {
    ...en.tools,
    'gantt-chart-generator': {
      ...en.tools['gantt-chart-generator'],
      ...ganttMessages,
    },
  },
};
---

<html lang="en">
  <body>
    <GanttChartGenerator client:only="svelte" locale="en" translations={translations} />
  </body>
</html>

<style is:global>
  html, body { margin: 0; min-width: 1200px; }
  [data-gantt-project-editor] { width: 1160px; margin: 20px; }
  .chart-frame .relative, .chart-frame .w-full { width: 100%; }
  .chart-frame .h-full { height: 100%; }
  .chart-frame .absolute { position: absolute; }
</style>

<script>
  import echarts from '@/lib/echarts/custom-runtime';

  (window as unknown as { __showGanttTooltip: () => boolean }).__showGanttTooltip = () => {
    const chartElement = document.querySelector<HTMLElement>('[_echarts_instance_]');
    if (!chartElement) return false;
    const chart = echarts.getInstanceByDom(chartElement);
    if (!chart) return false;
    const formatter = (chart.getOption().tooltip as Array<{
      formatter?: (params: { dataIndex: number; marker: string }) => string;
    }> | undefined)?.[0]?.formatter;
    if (typeof formatter !== 'function') return false;
    document.querySelector('[data-gantt-tooltip-probe]')?.remove();
    const probe = document.createElement('div');
    probe.dataset.ganttTooltipProbe = '';
    probe.innerHTML = formatter({ dataIndex: 0, marker: '' });
    document.body.append(probe);
    return true;
  };
</script>
