---
/**
 * RelatedTools.astro
 *
 * Displays 6 related tools based on the same category as the current tool.
 * Pure static Astro component — no client-side JavaScript.
 *
 * Features:
 * - Filters tools by same category, excluding the current tool
 * - Displays up to 6 related tools in a responsive grid
 * - Shows tool icon, localized name, and links to the tool page
 * - Falls back to popular tools if same-category tools are insufficient
 *
 * Requirements: 5.1
 */

import type { Tool } from '@/config/tools';
import { getIconSvg } from '@/lib/icon-svg';
import { getLocalizedPath, type Locale } from '@/lib/i18n';
import { getRelatedToolsForTool } from '@/lib/related-tools';

interface Props {
  /** Current tool (to exclude from related list) */
  currentTool: Tool;
  /** Current locale for links and translations */
  locale: string;
  /** Tool translations map: { [slug]: { name, description } } */
  toolTranslations: Record<string, Record<string, unknown>>;
  /** Optional pre-filtered related tools supplied by the page's index policy. */
  relatedTools?: Tool[];
  /** Maximum number of related tools to display (default: 6) */
  maxCount?: number;
  /** Label for the "Related Tools" heading */
  headingLabel?: string;
}

const {
  currentTool,
  locale,
  toolTranslations,
  relatedTools: providedRelatedTools,
  maxCount = 6,
  headingLabel = 'Related Tools',
} = Astro.props;

const relatedTools = (
  providedRelatedTools ?? getRelatedToolsForTool(currentTool, maxCount)
).slice(0, maxCount);

/**
 * Get the localized tool name from translations, falling back to slug.
 */
function getToolName(slug: string): string {
  const toolTrans = toolTranslations[slug];
  if (toolTrans && typeof toolTrans.name === 'string') {
    return toolTrans.name;
  }
  // Fallback: convert slug to title case
  return slug
    .split('-')
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');
}
---

{relatedTools.length > 0 && (
  <section class="mt-12" aria-labelledby="related-tools-heading">
    <h2
      id="related-tools-heading"
      class="text-xl font-bold mb-6 text-slate-900 dark:text-white tracking-tight flex items-center gap-2"
    >
      <span class="w-1.5 h-6 bg-amber-600 dark:bg-amber-500 rounded-full"></span>
      {headingLabel}
    </h2>

    <nav aria-label="Related tools">
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-4">
        {relatedTools.map((tool) => {
          const toolName = getToolName(tool.slug);
          return (
            <a
              href={getLocalizedPath(locale as Locale, `/tools/${tool.slug}`)}
              data-sibling-tool={tool.slug}
              class="flex flex-col items-center p-4 bg-white/40 dark:bg-slate-900/40 border border-slate-200/60 dark:border-slate-800 rounded-2xl hover:border-amber-500/50 hover:shadow-xl dark:hover:border-amber-500/50 transition-all duration-300 group backdrop-blur-sm"
              title={toolName}
            >
              <span
                class="text-amber-600 dark:text-amber-500 mb-3 group-hover:scale-110 transition-transform duration-300 inline-flex"
                aria-hidden="true"
                set:html={getIconSvg(tool.icon, 28)}
              />
              <span class="text-xs font-bold text-slate-700 dark:text-slate-300 text-center line-clamp-2 group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors uppercase tracking-tight">
                {toolName}
              </span>
            </a>
          );
        })}
      </div>
    </nav>
  </section>
)}
