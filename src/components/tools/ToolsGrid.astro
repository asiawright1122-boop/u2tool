---
import { getLocalizedPath } from '@/lib/i18n';
import { getIconSvg } from '@/lib/icon-svg';
import type { Locale } from '@/lib/i18n';

interface CategoryItem {
  id: string;
  icon: string;
}

interface ToolItem {
  slug: string;
  category: string;
  icon: string;
  popular?: boolean;
}

interface Props {
  locale: string;
  categories: CategoryItem[];
  tools: ToolItem[];
  categoryNames: Record<string, string>;
  toolNames: Record<string, string>;
  toolDescriptions: Record<string, string>;
  previewCount?: number;
  searchIndexPath?: string;
  emptyResultsLabel?: string;
}

const {
  locale,
  categories,
  tools,
  categoryNames,
  toolNames,
  toolDescriptions,
  previewCount,
  searchIndexPath,
  emptyResultsLabel = 'No tools found',
} = Astro.props as Props;

const effectivePreviewCount =
  typeof previewCount === 'number' && Number.isFinite(previewCount) && previewCount > 0
    ? Math.floor(previewCount)
    : null;

function getToolsByCategory(categoryId: string) {
  return tools.filter((tool) => tool.category === categoryId);
}

function toolPath(slug: string) {
  return getLocalizedPath(locale as Locale, `/tools/${slug}`);
}

function categoryPath(categoryId: string) {
  return getLocalizedPath(locale as Locale, `/categories/${categoryId}`);
}
---

<div
  id="tools-grid"
  data-empty-results-label={emptyResultsLabel}
  data-search-index-path={searchIndexPath || ''}
  data-tools-base-path={getLocalizedPath(locale as Locale, '/tools')}
>
  <div
    data-search-results
    hidden
    class="mb-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3"
  />
  <p
    data-search-empty
    hidden
    class="mb-8 rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-600 dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-300"
  >
    {emptyResultsLabel}
  </p>
  {categories.map((category) => {
    const categoryTools = getToolsByCategory(category.id);
    const renderedTools = effectivePreviewCount
      ? categoryTools.slice(0, effectivePreviewCount)
      : categoryTools;

    if (categoryTools.length === 0) {
      return null;
    }

    return (
      <section class="tools-grid-section mb-12" data-category={category.id} id={category.id}>
        <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-6 flex items-center gap-3 tracking-tight">
          <span
            class="text-slate-900 dark:text-amber-500 inline-flex shadow-sm"
            set:html={getIconSvg(category.icon, 20)}
          />
          <a
            href={categoryPath(category.id)}
            class="transition-all hover:text-amber-600 dark:hover:text-amber-400"
          >
            {categoryNames[category.id] || category.id}
          </a>
          <span class="text-xs font-black text-slate-400 dark:text-slate-500 ml-1 opacity-70 tracking-widest bg-slate-100 dark:bg-white/5 px-2 py-0.5 rounded-full border border-slate-200 dark:border-white/5 uppercase">
            {categoryTools.length}
          </span>
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {renderedTools.map((tool) => (
            <a
              href={toolPath(tool.slug)}
              class="glass-card flex items-center gap-4 p-5 group/card relative overflow-hidden"
            >
              <div class="absolute inset-0 bg-gradient-to-br from-transparent to-amber-500/5 dark:to-amber-500/10 opacity-0 group-hover/card:opacity-100 transition-opacity duration-500"></div>
              <div class="relative z-10 flex items-center gap-4 w-full">
                <span
                  class="text-slate-400 dark:text-slate-500 flex-shrink-0 inline-flex transition-all duration-500 group-hover/card:text-amber-500 group-hover/card:scale-110 group-hover/card:drop-shadow-[0_0_8px_rgba(245,158,11,0.5)]"
                  set:html={getIconSvg(tool.icon, 24)}
                />
                <div class="flex-1 min-w-0">
                  <h3 class="font-bold text-sm text-slate-900 dark:text-white truncate group-hover/card:text-amber-600 dark:group-hover/card:text-amber-400 transition-colors">
                    {toolNames[tool.slug] || tool.slug}
                  </h3>
                  <p class="text-[11px] text-slate-500 dark:text-slate-400 truncate mt-1.5 leading-relaxed">
                    {toolDescriptions[tool.slug] || ''}
                  </p>
                </div>
                {tool.popular && (
                  <span class="inline-flex items-center px-2 py-0.5 text-[9px] font-black rounded-full bg-amber-100 text-amber-600 dark:bg-amber-900/40 dark:text-amber-400 flex-shrink-0 border border-amber-200/50 dark:border-amber-500/30 shadow-[0_0_15px_rgba(245,158,11,0.2)] tracking-tighter uppercase">
                    HOT
                  </span>
                )}
              </div>
            </a>
          ))}
        </div>
      </section>
    );
  })}
</div>

<script is:inline>
  (() => {
    const root = document.getElementById('tools-grid');
    if (!root) return;

    const sections = Array.from(root.querySelectorAll('.tools-grid-section'));
    const searchResults = root.querySelector('[data-search-results]');
    const emptyState = root.querySelector('[data-search-empty]');
    const searchIndexPath = root.getAttribute('data-search-index-path') || '';
    const toolsBasePath = root.getAttribute('data-tools-base-path') || '';
    if (!sections.length) return;

    const normalize = (value) =>
      value
        .toLowerCase()
        .normalize('NFKC')
        .replace(/\s+/g, ' ')
        .trim();

    const scoreTool = (tool, query, queryTokens) => {
      let score = 0;
      const name = normalize(tool.name || tool.slug || '');
      const description = normalize(tool.description || '');
      const category = normalize(tool.categoryName || tool.category || '');

      if (name.includes(query)) {
        score += 100;
        if (name.startsWith(query)) score += 50;
      }

      if (description.includes(query)) score += 30;
      if (category.includes(query)) score += 20;

      for (const token of queryTokens) {
        if (name.includes(token)) score += 10;
        if (description.includes(token)) score += 5;
        if (category.includes(token)) score += 3;
      }

      return score;
    };

    const renderSearchResults = (items) => {
      if (!searchResults) return;

      searchResults.replaceChildren();

      for (const item of items) {
        const link = document.createElement('a');
        link.className = 'glass-card flex items-center gap-4 p-5 group/card relative overflow-hidden';
        
        const overlay = document.createElement('div');
        overlay.className = 'absolute inset-0 bg-gradient-to-br from-transparent to-amber-500/5 dark:to-amber-500/10 opacity-0 group-hover/card:opacity-100 transition-opacity duration-500';
        link.append(overlay);

        const iconContainer = document.createElement('div');
        iconContainer.className = 'relative z-10 flex items-center gap-4 w-full';
        link.append(iconContainer);

        const icon = document.createElement('span');
        icon.className = 'text-slate-400 dark:text-slate-500 flex-shrink-0 inline-flex transition-all duration-500 group-hover/card:text-amber-500 group-hover/card:scale-110 group-hover/card:drop-shadow-[0_0_8px_rgba(245,158,11,0.5)]';
        // Note: Actual icon SVG would need a helper or be simplified. 
        // For search results, we'll use a standard search-item layout but keep the typography premium.
        
        const textWrapper = document.createElement('div');
        textWrapper.className = 'flex-1 min-w-0';

        const title = document.createElement('h3');
        title.className = 'font-bold text-sm text-slate-900 dark:text-white truncate group-hover/card:text-amber-600 dark:group-hover/card:text-amber-400 transition-colors';
        title.textContent = item.name || item.slug;

        const description = document.createElement('p');
        description.className = 'text-[11px] text-slate-500 dark:text-slate-400 truncate mt-1.5 leading-relaxed';
        description.textContent = item.description || '';

        textWrapper.append(title, description);
        iconContainer.append(textWrapper);

        if (item.categoryName) {
          const badge = document.createElement('span');
          badge.className = 'inline-flex items-center px-2 py-0.5 text-[9px] font-black rounded-full bg-slate-100 text-slate-500 dark:bg-white/5 dark:text-slate-500 flex-shrink-0 border border-slate-200 dark:border-white/10 tracking-widest uppercase';
          badge.textContent = item.categoryName;
          iconContainer.append(badge);
        }

        searchResults.append(link);
      }
    };

    const showPreviewSections = (activeCategory) => {
      if (searchResults) {
        searchResults.hidden = true;
        searchResults.replaceChildren();
      }

      if (emptyState) {
        emptyState.hidden = true;
      }

      let visibleSections = 0;

      for (const section of sections) {
        const matchesCategory =
          !activeCategory || section.getAttribute('data-category') === activeCategory;
        section.toggleAttribute('hidden', !matchesCategory);
        if (matchesCategory) visibleSections += 1;
      }

      if (emptyState && visibleSections === 0) {
        emptyState.hidden = false;
      }
    };

    const applyCategoryFilter = async () => {
      const params = new URLSearchParams(window.location.search);
      const activeCategory = params.get('category');
      const query = normalize(params.get('q') || '');
      const queryTokens = query ? query.split(' ').filter(Boolean) : [];

      if (!query) {
        showPreviewSections(activeCategory);
        return;
      }

      if (!searchIndexPath || !searchResults) {
        showPreviewSections(activeCategory);
        return;
      }

      try {
        const response = await fetch(searchIndexPath);
        if (!response.ok) {
          throw new Error(`Unexpected response: ${response.status}`);
        }

        const toolsIndex = await response.json();
        const results = toolsIndex
          .map((tool) => ({
            ...tool,
            score: scoreTool(tool, query, queryTokens),
          }))
          .filter((tool) =>
            tool.score > 0 && (!activeCategory || tool.category === activeCategory)
          )
          .sort((a, b) => b.score - a.score)
          .slice(0, 24);

        for (const section of sections) {
          section.hidden = true;
        }

        if (results.length === 0) {
          searchResults.hidden = true;
          if (emptyState) emptyState.hidden = false;
          return;
        }

        renderSearchResults(results);
        searchResults.hidden = false;
        if (emptyState) emptyState.hidden = true;
      } catch {
        showPreviewSections(activeCategory);
      }
    };

    void applyCategoryFilter();
    window.addEventListener('popstate', () => {
      void applyCategoryFilter();
    });
  })();
</script>
