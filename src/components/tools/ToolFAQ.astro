---
/**
 * ToolFAQ.astro
 *
 * Renders FAQ items for a tool page with FAQPage JSON-LD structured data.
 * Pure static Astro component — all FAQ content is visible in the initial HTML
 * for optimal SEO (search engines can index all Q&A content).
 *
 * Uses HTML <details>/<summary> elements for native accordion behavior
 * without any client-side JavaScript.
 *
 * Features:
 * - Renders FAQ items as an accessible accordion using native HTML elements
 * - Includes FAQPage JSON-LD structured data for rich search results
 * - First FAQ item is open by default
 * - Fully static — no JavaScript required
 *
 * Requirements: 5.4
 */

interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  /** Tool name for the heading */
  toolName: string;
  /** Array of FAQ items with question and answer */
  faqs: FAQItem[];
  /** Optional custom CSS class */
  class?: string;
}

const { toolName, faqs, class: className = '' } = Astro.props;

/**
 * Generate FAQPage JSON-LD structured data.
 * @see https://schema.org/FAQPage
 */
function generateFAQJsonLd(items: FAQItem[]) {
  return {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: items.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  };
}

const faqJsonLd = faqs.length > 0 ? generateFAQJsonLd(faqs) : null;
---

{faqs.length > 0 && (
  <section class={`mt-8 ${className}`} aria-labelledby="faq-heading">
    {/* FAQPage JSON-LD Structured Data */}
    {faqJsonLd && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(faqJsonLd)}
      />
    )}

    {/* Heading */}
    <h2
      id="faq-heading"
      class="text-2xl font-bold text-slate-900 dark:text-white mb-6 tracking-tight"
    >
      FAQ — {toolName}
    </h2>

    {/* FAQ Accordion using native <details>/<summary> */}
    <div class="space-y-4" role="list">
      {faqs.map((faq, index) => (
        <details
          class="border border-slate-200/60 dark:border-slate-800 rounded-2xl overflow-hidden group transition-all duration-300 backdrop-blur-sm"
          open={index === 0}
        >
          {/* Question */}
          <summary class="flex items-center justify-between p-5 cursor-pointer bg-white/60 dark:bg-slate-900/40 hover:bg-white dark:hover:bg-slate-900 transition-colors list-none [&::-webkit-details-marker]:hidden border-b border-transparent group-open:border-slate-200/60 dark:group-open:border-slate-800">
            <h3 class="font-bold text-slate-900 dark:text-white pr-6 m-0 text-base tracking-tight">
              {faq.question}
            </h3>
            <svg
              class="w-5 h-5 text-slate-400 dark:text-slate-500 flex-shrink-0 transition-transform duration-300 group-open:rotate-180 group-open:text-amber-600 dark:group-open:text-amber-500"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.5"
                d="M19 9l-7 7-7-7"
              />
            </svg>
          </summary>

          {/* Answer */}
          <div class="p-5 bg-slate-50/50 dark:bg-slate-950/40 text-slate-600 dark:text-slate-400 leading-relaxed faq-answer text-sm md:text-base">
            {faq.answer}
          </div>
        </details>
      ))}
    </div>
  </section>
)}
