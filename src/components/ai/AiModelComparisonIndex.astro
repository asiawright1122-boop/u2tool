---
import {
  aiModelComparisonIndexPath,
  type AiModelComparisonIndexCopy,
  type AiModelComparisonIndexItem,
} from '@/lib/ai-model-comparisons';
import { getLocalizedPath, type Locale } from '@/lib/i18n';

interface Props {
  comparisons: AiModelComparisonIndexItem[];
  copy: AiModelComparisonIndexCopy;
  locale: Locale;
}

const { comparisons, copy, locale } = Astro.props as Props;
const toolHref = getLocalizedPath(locale, '/tools/ai-token-calculator');
const indexHref = getLocalizedPath(locale, aiModelComparisonIndexPath);
---

<section data-discovery-surface="ai-model-cost-comparisons" class="space-y-8">
  <div class="border-b border-slate-200/70 pb-8 dark:border-white/10">
    <p class="mb-3 text-[10px] font-black uppercase tracking-[0.3em] text-sky-600/80 dark:text-sky-400/70">
      AI model pricing
    </p>
    <h1 class="max-w-5xl text-4xl font-black leading-tight tracking-tight text-slate-950 dark:text-white md:text-6xl">
      {copy.h1}
    </h1>
    <p class="mt-5 max-w-3xl text-base font-medium leading-8 text-slate-600 dark:text-slate-300 md:text-lg">
      {copy.description}
    </p>
    <div class="mt-7 flex flex-wrap gap-3">
      <a
        href={toolHref}
        class="inline-flex items-center justify-center rounded-xl bg-slate-950 px-5 py-3 text-xs font-black uppercase tracking-[0.16em] text-white transition hover:bg-black dark:bg-sky-400 dark:text-slate-950 dark:hover:bg-sky-300"
      >
        {copy.toolCtaLabel}
      </a>
      <a
        href={indexHref}
        aria-current="page"
        class="inline-flex items-center justify-center rounded-xl border border-slate-300 px-5 py-3 text-xs font-black uppercase tracking-[0.16em] text-slate-700 dark:border-white/10 dark:text-slate-200"
      >
        {comparisons.length} comparisons
      </a>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-4 lg:grid-cols-4">
    {comparisons.map((comparison) => (
      <article class="flex min-h-[220px] flex-col rounded-2xl border border-slate-200/70 bg-white/70 p-5 shadow-sm transition hover:border-sky-300 hover:shadow-md dark:border-white/10 dark:bg-white/5 dark:hover:border-sky-400/50">
        <h2 class="text-base font-black leading-6 tracking-tight text-slate-950 dark:text-white">
          <a href={comparison.href} class="hover:text-sky-700 dark:hover:text-sky-300">
            {comparison.title}
          </a>
        </h2>
        <p class="mt-3 flex-1 text-sm font-medium leading-7 text-slate-600 dark:text-slate-300">
          {comparison.description}
        </p>
        <a
          href={comparison.href}
          class="mt-5 inline-flex w-fit items-center rounded-xl border border-slate-300 px-4 py-2 text-[10px] font-black uppercase tracking-[0.16em] text-slate-700 transition hover:border-sky-400 hover:text-sky-700 dark:border-white/10 dark:text-slate-200 dark:hover:border-sky-400 dark:hover:text-sky-300"
        >
          {copy.ctaLabel}
        </a>
      </article>
    ))}
  </div>

  <section class="border-t border-slate-200/70 pt-6 dark:border-white/10">
    <p class="max-w-4xl text-sm font-medium leading-7 text-slate-500 dark:text-slate-400">
      {copy.pricingNote}
    </p>
  </section>
</section>
