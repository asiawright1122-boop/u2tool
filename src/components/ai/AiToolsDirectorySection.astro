---
import { getIconSvg } from '@/lib/icon-svg';
import type {
  AiToolsDirectoryCluster,
  AiToolsDirectoryCopy,
} from '@/lib/ai-tools-directory';

interface Props {
  clusters: AiToolsDirectoryCluster[];
  copy: AiToolsDirectoryCopy;
  showHeader?: boolean;
}

const { clusters, copy, showHeader = true } = Astro.props as Props;
const featuredTool = clusters
  .flatMap((cluster) => cluster.tools)
  .find((tool) => tool.slug === 'ai-token-calculator');
const totalTools = clusters.reduce((count, cluster) => count + cluster.tools.length, 0);
---

<section data-discovery-surface="ai-tools-directory" class="mb-10 space-y-5">
  {showHeader && (
    <div class="mb-6 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div class="max-w-3xl">
        <p class="mb-3 text-[10px] font-black uppercase tracking-[0.3em] text-sky-600/80 dark:text-sky-400/70">
          {copy.eyebrow}
        </p>
        <h2 class="text-2xl font-black tracking-tight text-slate-900 dark:text-white md:text-3xl">
          {copy.h1}
        </h2>
        <p class="mt-3 text-sm font-medium leading-7 text-slate-500 dark:text-slate-400">
          {copy.description}
        </p>
      </div>
      <span class="inline-flex w-fit items-center rounded-xl border border-slate-200 bg-white/80 px-4 py-2 text-[10px] font-black uppercase tracking-[0.18em] text-slate-600 dark:border-white/10 dark:bg-white/5 dark:text-slate-300">
        {totalTools} {copy.toolCountLabel}
      </span>
    </div>
  )}

  <nav
    data-ai-tools-directory-nav
    class="rounded-2xl border border-slate-200/70 bg-white/75 p-4 dark:border-white/10 dark:bg-white/5"
    aria-label={copy.clusterNavTitle}
  >
    <p class="mb-3 text-xs font-black uppercase tracking-[0.16em] text-slate-500 dark:text-slate-400">
      {copy.clusterNavTitle}
    </p>
    <div class="flex flex-wrap gap-2">
      {clusters.map((cluster) => (
        <a
          href={cluster.href}
          class="inline-flex max-w-full items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-bold text-slate-700 transition hover:border-sky-300 hover:text-sky-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400 dark:border-white/10 dark:bg-slate-950/30 dark:text-slate-200 dark:hover:border-sky-400/60 dark:hover:text-sky-200"
        >
          <span class="truncate">{cluster.title}</span>
          <span class="shrink-0 rounded-lg bg-slate-100 px-2 py-0.5 text-[10px] font-black text-slate-500 dark:bg-white/10 dark:text-slate-300">
            {cluster.tools.length}
          </span>
        </a>
      ))}
    </div>
  </nav>

  {featuredTool && (
    <article class="overflow-hidden rounded-2xl border border-sky-200/70 bg-sky-50/75 p-5 dark:border-sky-400/20 dark:bg-sky-950/20">
      <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div class="max-w-3xl">
          <div class="mb-2 flex flex-wrap items-center gap-2">
            <span class="inline-flex items-center rounded-lg bg-sky-100 px-2.5 py-1 text-[10px] font-black uppercase tracking-[0.14em] text-sky-700 dark:bg-sky-400/10 dark:text-sky-200">
              {copy.featuredBadgeLabel}
            </span>
            <h3 class="text-lg font-black tracking-tight text-slate-900 dark:text-white">
              {copy.featuredTitle}
            </h3>
          </div>
          <p class="mt-2 text-sm font-medium leading-7 text-slate-600 dark:text-slate-300">
            {copy.featuredDescription}
          </p>
        </div>
        <a
          href={featuredTool.href}
          class="inline-flex items-center justify-center rounded-xl bg-slate-950 px-4 py-3 text-xs font-black uppercase tracking-[0.16em] text-white transition hover:bg-black dark:bg-sky-400 dark:text-slate-950 dark:hover:bg-sky-300"
        >
          {copy.featuredCta}
        </a>
      </div>
    </article>
  )}

  <div class="grid grid-cols-1 gap-4 xl:grid-cols-2">
    {clusters.map((cluster) => (
      <article
        id={cluster.id}
        data-ai-tools-cluster={cluster.id}
        class="scroll-mt-24 rounded-2xl border border-slate-200/70 bg-white/75 p-5 dark:border-white/10 dark:bg-white/5"
      >
        <div class="mb-4 flex items-start justify-between gap-4">
          <div class="min-w-0">
            <h3 class="text-base font-black tracking-tight text-slate-900 dark:text-white">
              {cluster.title}
            </h3>
            <p class="mt-2 text-xs font-medium leading-6 text-slate-500 dark:text-slate-400">
              {cluster.description}
            </p>
          </div>
          <span class="shrink-0 rounded-xl border border-slate-200 bg-white px-2.5 py-1 text-[9px] font-black uppercase tracking-wider text-slate-600 dark:border-white/10 dark:bg-slate-950/30 dark:text-slate-300">
            {cluster.tools.length} {copy.toolCountLabel}
          </span>
        </div>

        <ul class="divide-y divide-slate-200/70 overflow-hidden rounded-xl border border-slate-200/70 bg-white/65 dark:divide-white/10 dark:border-white/10 dark:bg-slate-950/20">
          {cluster.tools.map((tool) => (
            <li>
              <a
                href={tool.href}
                data-tool={tool.slug}
                title={tool.description || tool.name}
                class="group/tool flex min-h-[72px] items-center gap-3 px-3 py-3 transition hover:bg-sky-50/75 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-sky-400 dark:hover:bg-sky-950/20"
              >
                <span
                  class="inline-flex shrink-0 text-slate-400 transition-colors group-hover/tool:text-sky-500 dark:text-slate-500 dark:group-hover/tool:text-sky-300"
                  set:html={getIconSvg(tool.icon, 18)}
                />
                <span class="min-w-0 flex-1">
                  <span class="flex flex-wrap items-center gap-2">
                    <span class="truncate text-sm font-bold text-slate-800 transition-colors group-hover/tool:text-sky-700 dark:text-slate-100 dark:group-hover/tool:text-sky-200">
                      {tool.name}
                    </span>
                    {tool.isFeatured && (
                      <span class="rounded-lg bg-sky-100 px-2 py-0.5 text-[9px] font-black uppercase tracking-[0.12em] text-sky-700 dark:bg-sky-400/10 dark:text-sky-200">
                        {copy.featuredBadgeLabel}
                      </span>
                    )}
                  </span>
                  <span class="mt-1 line-clamp-1 block text-xs font-medium leading-5 text-slate-500 dark:text-slate-400">
                    {tool.description || tool.categoryName}
                  </span>
                </span>
                <span class="shrink-0 rounded-lg border border-slate-200 px-2.5 py-1 text-[9px] font-black uppercase tracking-[0.12em] text-slate-500 transition group-hover/tool:border-sky-300 group-hover/tool:text-sky-700 dark:border-white/10 dark:text-slate-400 dark:group-hover/tool:border-sky-400/60 dark:group-hover/tool:text-sky-200">
                  {copy.ctaLabel}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </article>
    ))}
  </div>

  <article class="rounded-2xl border border-sky-200/70 bg-sky-50/75 p-5 dark:border-sky-400/20 dark:bg-sky-950/20">
    <div class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-start">
      <div class="min-w-0">
        <h3 class="text-base font-black tracking-tight text-slate-900 dark:text-white">
          {copy.modelComparisonTitle}
        </h3>
        <p class="mt-2 text-sm font-medium leading-7 text-slate-600 dark:text-slate-300">
          {copy.modelComparisonDescription}
        </p>
      </div>
      <a
        href={copy.modelComparisonIndex.href}
        class="inline-flex items-center justify-center rounded-xl bg-slate-950 px-4 py-3 text-[10px] font-black uppercase tracking-[0.16em] text-white transition hover:bg-black focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400 dark:bg-sky-400 dark:text-slate-950 dark:hover:bg-sky-300"
      >
        {copy.modelComparisonIndex.label}
      </a>
    </div>

    <div class="mt-4 flex flex-wrap gap-2">
      {copy.modelComparisonLinks.map((link) => (
        <a
          href={link.href}
          title={link.description}
          class="inline-flex min-h-10 max-w-full items-center rounded-xl border border-sky-200 bg-white/80 px-3 py-2 text-[10px] font-black uppercase tracking-[0.12em] text-slate-700 transition hover:border-sky-400 hover:text-sky-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400 dark:border-sky-400/20 dark:bg-white/5 dark:text-slate-200 dark:hover:border-sky-300 dark:hover:text-sky-200"
        >
          <span class="truncate">{link.label}</span>
        </a>
      ))}
    </div>
  </article>

  <article class="rounded-2xl border border-slate-200/70 bg-white/70 p-5 dark:border-white/10 dark:bg-white/5">
    <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
      <div>
        <h3 class="text-sm font-black tracking-tight text-slate-900 dark:text-white">
          {copy.costComparisonTitle}
        </h3>
        <p class="mt-2 text-xs font-medium leading-6 text-slate-500 dark:text-slate-400">
          {copy.costComparisonDescription}
        </p>
      </div>
      {featuredTool && (
        <a
          href={featuredTool.href}
          class="inline-flex items-center justify-center rounded-xl border border-slate-300 px-4 py-2 text-[10px] font-black uppercase tracking-[0.16em] text-slate-700 transition hover:border-sky-400 hover:text-sky-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400 dark:border-white/10 dark:text-slate-200 dark:hover:border-sky-400 dark:hover:text-sky-300"
        >
          {copy.costComparisonCta}
        </a>
      )}
    </div>
  </article>
</section>
