---
/**
 * Tool Detail Page — [slug].astro
 *
 * Route: /{locale}/tools/{slug}
 *
 * Renders tool pages on Cloudflare SSR to keep deploy builds fast while still
 * returning complete HTML to crawlers. Loads tool-specific translations, renders SEO metadata (title, description,
 * canonical, hreflang, structured data), and composes the page from:
 * - Breadcrumb navigation (static)
 * - Tool header with icon, name, description (static)
 * - Detailed description section (static)
 * - ToolWrapper with client:visible hydration (interactive island)
 * - Usage instructions (static)
 * - ToolFAQ with FAQPage structured data (static)
 * - RelatedTools grid (static)
 *
 * Requirements: 1.4, 1.5, 3.4, 5.1, 5.2, 5.3, 5.4
 */

// --- Layout ---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.svelte';
import StaticSidebar from '@/components/layout/StaticSidebar.astro';
import MobileBottomNav from '@/components/layout/MobileBottomNav.svelte';
import Breadcrumb from '@/components/layout/Breadcrumb.astro';

// --- SEO ---
import HreflangTags from '@/components/seo/HreflangTags.astro';
import StructuredData from '@/components/seo/StructuredData.astro';

// --- Tools ---
import ToolWrapper from '@/components/tools/ToolWrapper.svelte';
import RelatedTools from '@/components/tools/RelatedTools.astro';
import ToolFAQ from '@/components/tools/ToolFAQ.astro';

// --- Cluster (order matches CLUSTER_BLOCKS array below: creatorSeo → developerData → image → onlineCalculator → pdfDocument → security → textWriting → chart) ---
import CreatorSeoToolClusterCard from '@/components/tools/CreatorSeoToolClusterCard.astro';
import DeveloperDataToolClusterCard from '@/components/tools/DeveloperDataToolClusterCard.astro';
import ImageToolClusterCard from '@/components/tools/ImageToolClusterCard.astro';
import OnlineCalculatorClusterCard from '@/components/tools/OnlineCalculatorClusterCard.astro';
import PdfDocumentToolClusterCard from '@/components/tools/PdfDocumentToolClusterCard.astro';
import SecurityToolClusterCard from '@/components/tools/SecurityToolClusterCard.astro';
import TextWritingToolClusterCard from '@/components/tools/TextWritingToolClusterCard.astro';
import ChartToolClusterCard from '@/components/tools/ChartToolClusterCard.astro';

// --- Config ---
import { tools, categories, getToolsByCategory } from '@/config/tools';
import { getIconSvg } from '@/lib/icon-svg';

// --- Lib ---
import { isValidLocale } from '@/lib/i18n';
import type { Locale } from '@/lib/i18n';
import { loadBaseUiMessages, loadToolPageMessages } from '@/lib/translations';
import { buildHeaderTranslations, buildMobileNavMessages } from '@/lib/layout-translations';
import { getPublicSiteUrl } from '@/lib/public-env';
import { buildLocalizedPagePath, buildLocalizedPageUrl, getHreflang, withBrand } from '@/lib/seo';
import { sanitizeHtml } from '@/lib/sanitize';
import { assessSupportContentTrust } from '@/lib/content-trust';
import { buildSafeFallbackSupportContent } from '@/lib/support-content-fallback';
import { findComparisonGuideForTool, getComparisonUiCopy } from '@/lib/comparison-surfaces';
import {
  buildChartToolClusterGroupForTool,
  chartToolClusterPath,
  getChartToolClusterCopy,
  type ChartToolClusterGroup,
  type ChartToolClusterCopy,
} from '@/lib/chart-tool-cluster';
import {
  buildCreatorSeoClusterGroupForTool,
  creatorSeoClusterPath,
  getCreatorSeoClusterCopy,
  type CreatorSeoClusterGroup,
  type CreatorSeoClusterCopy,
} from '@/lib/creator-seo-cluster';
import {
  buildDeveloperDataToolClusterGroupForTool,
  developerDataToolClusterPath,
  getDeveloperDataToolClusterCopy,
  type DeveloperDataToolClusterGroup,
  type DeveloperDataToolClusterCopy,
} from '@/lib/developer-data-tool-cluster';
import {
  buildImageToolClusterGroupForTool,
  getImageToolClusterCopy,
  imageToolClusterPath,
  type ImageToolClusterGroup,
  type ImageToolClusterCopy,
} from '@/lib/image-tool-cluster';
import {
  buildOnlineCalculatorClusterGroupForTool,
  getOnlineCalculatorClusterCopy,
  onlineCalculatorClusterPath,
  type OnlineCalculatorClusterGroup,
  type OnlineCalculatorClusterCopy,
} from '@/lib/online-calculator-cluster';
import {
  buildPdfDocumentToolClusterGroupForTool,
  getPdfDocumentToolClusterCopy,
  pdfDocumentToolClusterPath,
  type PdfDocumentToolClusterGroup,
  type PdfDocumentToolClusterCopy,
} from '@/lib/pdf-document-tool-cluster';
import {
  buildSecurityToolClusterGroupForTool,
  getSecurityToolClusterCopy,
  securityToolClusterPath,
  type SecurityToolClusterGroup,
  type SecurityToolClusterCopy,
} from '@/lib/security-tool-cluster';
import {
  buildTextWritingToolClusterGroupForTool,
  getTextWritingToolClusterCopy,
  textWritingToolClusterPath,
  type TextWritingToolClusterGroup,
  type TextWritingToolClusterCopy,
} from '@/lib/text-writing-tool-cluster';

export const prerender = false;

// ---------------------------------------------------------------------------
// Page data loading
// ---------------------------------------------------------------------------
const localeCandidate = Astro.params.locale;
if (typeof localeCandidate !== 'string' || !isValidLocale(localeCandidate)) {
  return Astro.redirect('/en/tools/', 302);
}

const locale: Locale = localeCandidate;

const slugCandidate = Astro.params.slug;
const tool = typeof slugCandidate === 'string'
  ? tools.find((candidate) => candidate.slug === slugCandidate)
  : undefined;
if (!tool) {
  return Astro.redirect(`/${locale}/tools/`, 302);
}

// Load tool-specific translations without parsing every tool's long-form copy.
const messages = await loadToolPageMessages(locale, tool.slug, Astro.url);

// Load lightweight base messages for common UI strings (nav labels, category names, etc.)
const baseMessages = await loadBaseUiMessages(locale, Astro.url);
const navMessages = (baseMessages.nav as Record<string, string>) ?? {};
const categoryMessages = (baseMessages.categories as Record<string, string>) ?? {};
const toolsCommon = (baseMessages.tools as Record<string, unknown>) ?? {};
const siteMessages = (baseMessages.site as Record<string, string>) ?? {};
const headerTranslations = buildHeaderTranslations(baseMessages);
const mobileNavMessages = buildMobileNavMessages(navMessages);
const comparisonUiCopy = getComparisonUiCopy(locale);

// ---------------------------------------------------------------------------
// Cluster copy — locale-level labels for each cluster
// ---------------------------------------------------------------------------
const chartToolCopy = getChartToolClusterCopy(locale);
const creatorSeoCopy = getCreatorSeoClusterCopy(locale);
const developerDataToolCopy = getDeveloperDataToolClusterCopy(locale);
const imageToolCopy = getImageToolClusterCopy(locale);
const onlineCalculatorCopy = getOnlineCalculatorClusterCopy(locale);
const pdfDocumentToolCopy = getPdfDocumentToolClusterCopy(locale);
const securityToolCopy = getSecurityToolClusterCopy(locale);
const textWritingToolCopy = getTextWritingToolClusterCopy(locale);

// Extract tool metadata from translations
const toolName = (messages.name as string) || tool.slug;
const toolDescription = (messages.description as string) || '';
const seoTitle = (messages.seo_title as string) || toolName;
const brandedSeoTitle = withBrand(seoTitle);
const seoDescription = (messages.seo_description as string) || toolDescription;
const rawDetailedDescription = (messages.detailed_description as string) || '';
const rawUsageSteps = messages.usage_steps as string[] | undefined;
const rawUsageExamples = messages.usage_examples as string[] | undefined;

// Category name (localized)
const categoryName = categoryMessages[tool.category] || tool.category;

// Common UI labels
const toolIntroductionLabel = (toolsCommon.toolIntroduction as string) || 'Tool Introduction';
const usageInstructionsLabel = (toolsCommon.usageInstructions as string) || 'Usage Instructions';
const usageStepsLabel = (toolsCommon.usageSteps as string) || 'Usage Steps';
const usageExamplesLabel = (toolsCommon.usageExamples as string) || 'Usage Examples';
const relatedToolsLabel = navMessages.relatedTools || 'Related Tools';
const homeLabel = navMessages.home || 'Home';

// ---------------------------------------------------------------------------
// Breadcrumb items
// ---------------------------------------------------------------------------
const breadcrumbItems = [
  { label: homeLabel, href: buildLocalizedPagePath(locale, '/') },
  { label: categoryName, href: buildLocalizedPagePath(locale, `/categories/${tool.category}`) },
  { label: toolName, href: buildLocalizedPagePath(locale, `/tools/${tool.slug}`) },
];

// ---------------------------------------------------------------------------
// Structured data: SoftwareApplication
// ---------------------------------------------------------------------------
const BASE_URL = getPublicSiteUrl();
const schemaLanguage = getHreflang(locale);

const softwareAppData = {
  name: toolName,
  description: seoDescription,
  url: buildLocalizedPageUrl(BASE_URL, locale, `/tools/${tool.slug}`),
  inLanguage: schemaLanguage,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};

// ---------------------------------------------------------------------------
// FAQ extraction
// ---------------------------------------------------------------------------
interface FAQItem {
  question: string;
  answer: string;
}

function hasSupportText(value: unknown): value is string {
  return typeof value === 'string' && value.trim().length > 0;
}

function hasSupportList(value: unknown): value is string[] {
  return Array.isArray(value) && value.some((item) => typeof item === 'string' && item.trim().length > 0);
}

function pushFAQIfComplete(faqs: FAQItem[], question: unknown, answer: unknown): void {
  if (typeof question !== 'string' || typeof answer !== 'string') {
    return;
  }

  const trimmedQuestion = question.trim();
  const trimmedAnswer = answer.trim();
  if (trimmedQuestion && trimmedAnswer) {
    faqs.push({ question: trimmedQuestion, answer: trimmedAnswer });
  }
}

function extractFAQs(msgs: Record<string, unknown>): FAQItem[] {
  const faqs: FAQItem[] = [];

  // Pattern 1: faqs array in translations
  if (Array.isArray(msgs.faqs)) {
    for (const item of msgs.faqs) {
      if (item && typeof item === 'object' && 'question' in item && 'answer' in item) {
        pushFAQIfComplete(
          faqs,
          (item as Record<string, unknown>).question,
          (item as Record<string, unknown>).answer
        );
      }
    }
    return faqs;
  }

  // Pattern 2: faq_q1/faq_a1, faq_q2/faq_a2, ... pattern
  for (let i = 1; i <= 20; i++) {
    const question = msgs[`faq_q${i}`];
    const answer = msgs[`faq_a${i}`];
    pushFAQIfComplete(faqs, question, answer);
  }

  return faqs;
}

// ---------------------------------------------------------------------------
// Support content resolution (trust assessment + fallback chain)
// ---------------------------------------------------------------------------
const rawFaqs = extractFAQs(messages);
const supportContentTrust = assessSupportContentTrust({
  slug: tool.slug,
  locale,
  name: toolName,
  description: toolDescription,
  detailedDescription: rawDetailedDescription,
  usageSteps: rawUsageSteps,
  usageExamples: rawUsageExamples,
  faqs: rawFaqs,
});
const shouldUseSupportContentFallback =
  supportContentTrust.blockSupportContent ||
  !hasSupportText(rawDetailedDescription) ||
  !hasSupportList(rawUsageSteps) ||
  !hasSupportList(rawUsageExamples) ||
  rawFaqs.length === 0;
const supportContentFallback =
  shouldUseSupportContentFallback
    ? buildSafeFallbackSupportContent(tool.slug, toolName, locale)
    : null;

const detailedDescription = supportContentTrust.blockSupportContent || !hasSupportText(rawDetailedDescription)
  ? supportContentFallback?.detailedDescription ?? ''
  : rawDetailedDescription;
const safeDetailedDescription = detailedDescription
  ? sanitizeHtml(detailedDescription.replace(/\n/g, '<br />'))
  : '';
const usageSteps = supportContentTrust.blockSupportContent || !hasSupportList(rawUsageSteps)
  ? supportContentFallback?.usageSteps
  : rawUsageSteps;
const usageExamples = supportContentTrust.blockSupportContent || !hasSupportList(rawUsageExamples)
  ? supportContentFallback?.usageExamples
  : rawUsageExamples;
const faqs = supportContentTrust.blockSupportContent || rawFaqs.length === 0
  ? supportContentFallback?.faqs ?? []
  : rawFaqs;

const howToUseTemplates: Record<string, string> = {
  ar: 'كيفية استخدام {name}',
  de: 'Wie man {name} benutzt',
  en: 'How to use {name}',
  es: 'Cómo usar {name}',
  fr: 'Comment utiliser {name}',
  ja: '{name}の使い方',
  ko: '{name} 사용 방법',
  pt: 'Como usar {name}',
  ru: 'Как использовать {name}',
  zh: '如何使用 {name}',
};

const howToUseTemplate = howToUseTemplates[locale] || 'How to use {name}';
const howToName = howToUseTemplate.replace('{name}', toolName);

const howToData = usageSteps && usageSteps.length > 0
  ? {
      name: howToName,
      description: seoDescription,
      inLanguage: schemaLanguage,
      step: usageSteps.map((step, index) => ({
        '@type': 'HowToStep',
        position: index + 1,
        text: step,
      })),
      totalTime: 'PT2M',
    }
  : null;

// ---------------------------------------------------------------------------
// Build translations object for ToolWrapper
// Contains: generic tool keys (input, output, copy, etc.) + current tool translations
// ---------------------------------------------------------------------------
const genericToolKeys: Record<string, unknown> = {};
for (const [key, value] of Object.entries(toolsCommon)) {
  // Generic keys are string values (not tool slug objects)
  if (typeof value === 'string') {
    genericToolKeys[key] = value;
  }
}
// Also include nested generic namespaces (e.g., json.invalidJson, stopwatchUI, etc.)
for (const [key, value] of Object.entries(toolsCommon)) {
  if (typeof value === 'object' && value !== null && !Array.isArray(value)) {
    // Check if this is a tool slug (has 'name' key) or a generic namespace
    const obj = value as Record<string, unknown>;
    if (!obj.name && !obj.description) {
      genericToolKeys[key] = value;
    }
  }
}
const safeToolMessages: Record<string, unknown> = { ...messages };
if (supportContentFallback) {
  safeToolMessages.detailed_description = detailedDescription;
  safeToolMessages.usage_steps = usageSteps ?? [];
  safeToolMessages.usage_examples = usageExamples ?? [];
  safeToolMessages.faqs = faqs;
}
const toolTranslations = { tools: { ...genericToolKeys, [tool.slug]: safeToolMessages } };
const sameCategoryTools = getToolsByCategory(tool.category)
  .filter((t) => t.slug !== tool.slug)
  .slice(0, 6);

// Build a minimal translations map for related tool names
const relatedToolSlugs = new Set(sameCategoryTools.map((t) => t.slug));
// Also include popular tools that might be used as fallback
const popularFallbacks = tools
  .filter((t) => t.popular && t.slug !== tool.slug && !relatedToolSlugs.has(t.slug))
  .slice(0, 6);
for (const t of popularFallbacks) {
  relatedToolSlugs.add(t.slug);
}

// Extract tool names from base messages
const allToolTranslations: Record<string, Record<string, unknown>> = {};
for (const slug of relatedToolSlugs) {
  const toolTrans = toolsCommon[slug];
  if (toolTrans && typeof toolTrans === 'object') {
    allToolTranslations[slug] = toolTrans as Record<string, unknown>;
  }
}

const allToolNames = Object.fromEntries(
  tools.map((candidateTool) => {
    const candidateMessages = toolsCommon[candidateTool.slug] as Record<string, unknown> | undefined;
    return [candidateTool.slug, (candidateMessages?.name as string) || candidateTool.slug];
  })
);
const allToolDescriptions = Object.fromEntries(
  tools.map((candidateTool) => {
    const candidateMessages = toolsCommon[candidateTool.slug] as Record<string, unknown> | undefined;
    return [
      candidateTool.slug,
      (candidateMessages?.seo_description as string) || (candidateMessages?.description as string) || '',
    ];
  })
);
const comparisonGuide = findComparisonGuideForTool(
  locale,
  tool.slug,
  categoryMessages,
  allToolNames,
  allToolDescriptions
);

// ---------------------------------------------------------------------------
// Cluster configuration — 8 blocks, rendered in template order
// ---------------------------------------------------------------------------
type ClusterGroup =
  | ChartToolClusterGroup
  | CreatorSeoClusterGroup
  | DeveloperDataToolClusterGroup
  | ImageToolClusterGroup
  | OnlineCalculatorClusterGroup
  | PdfDocumentToolClusterGroup
  | SecurityToolClusterGroup
  | TextWritingToolClusterGroup
  | null;

type ClusterCopy =
  | ChartToolClusterCopy
  | CreatorSeoClusterCopy
  | DeveloperDataToolClusterCopy
  | ImageToolClusterCopy
  | OnlineCalculatorClusterCopy
  | PdfDocumentToolClusterCopy
  | SecurityToolClusterCopy
  | TextWritingToolClusterCopy;

const CLUSTER_BLOCKS: Array<{ group: ClusterGroup; Card: any; clusterPath: string; copy: ClusterCopy }> = [
  {
    group: buildCreatorSeoClusterGroupForTool(locale, tool.slug, categoryMessages, allToolNames, allToolDescriptions),
    Card: CreatorSeoToolClusterCard,
    clusterPath: creatorSeoClusterPath,
    copy: creatorSeoCopy,
  },
  {
    group: buildDeveloperDataToolClusterGroupForTool(locale, tool.slug, categoryMessages, allToolNames, allToolDescriptions),
    Card: DeveloperDataToolClusterCard,
    clusterPath: developerDataToolClusterPath,
    copy: developerDataToolCopy,
  },
  {
    group: buildImageToolClusterGroupForTool(locale, tool.slug, categoryMessages, allToolNames, allToolDescriptions),
    Card: ImageToolClusterCard,
    clusterPath: imageToolClusterPath,
    copy: imageToolCopy,
  },
  {
    group: buildOnlineCalculatorClusterGroupForTool(locale, tool.slug, categoryMessages, allToolNames, allToolDescriptions),
    Card: OnlineCalculatorClusterCard,
    clusterPath: onlineCalculatorClusterPath,
    copy: onlineCalculatorCopy,
  },
  {
    group: buildPdfDocumentToolClusterGroupForTool(locale, tool.slug, categoryMessages, allToolNames, allToolDescriptions),
    Card: PdfDocumentToolClusterCard,
    clusterPath: pdfDocumentToolClusterPath,
    copy: pdfDocumentToolCopy,
  },
  {
    group: buildSecurityToolClusterGroupForTool(locale, tool.slug, categoryMessages, allToolNames, allToolDescriptions),
    Card: SecurityToolClusterCard,
    clusterPath: securityToolClusterPath,
    copy: securityToolCopy,
  },
  {
    group: buildTextWritingToolClusterGroupForTool(locale, tool.slug, categoryMessages, allToolNames, allToolDescriptions),
    Card: TextWritingToolClusterCard,
    clusterPath: textWritingToolClusterPath,
    copy: textWritingToolCopy,
  },
  {
    group: buildChartToolClusterGroupForTool(locale, tool.slug, categoryMessages, allToolNames, allToolDescriptions),
    Card: ChartToolClusterCard,
    clusterPath: chartToolClusterPath,
    copy: chartToolCopy,
  },
];
---
<BaseLayout
  title={seoTitle}
  description={seoDescription}
  locale={locale}
  canonicalPath={`/tools/${tool.slug}`}
  siteDescription={siteMessages.description}
>
  {/* SEO: Hreflang tags for all 10 locales + x-default */}
  <HreflangTags path={`/tools/${tool.slug}`} slot="head" />

  {/* SEO: SoftwareApplication structured data */}
  <StructuredData type="SoftwareApplication" data={softwareAppData} slot="head" />

  {/* SEO: HowTo structured data (if usage steps available) */}
  {howToData && (
    <StructuredData type="HowTo" data={howToData} slot="head" />
  )}

  {/* SEO: FAQPage structured data */}
  {faqs && faqs.length > 0 && (
    <StructuredData type="FAQPage" data={{
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer,
        },
      })),
    }} slot="head" />
  )}

  {/* SEO: BreadcrumbList structured data */}
  <StructuredData type="BreadcrumbList" data={{
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: `${BASE_URL}${item.href}`,
    })),
  }} slot="head" />

  {/* OG meta tags */}
  <meta property="og:title" content={brandedSeoTitle} slot="head" />
  <meta property="og:description" content={seoDescription} slot="head" />
  <meta property="og:image"
    content={`${BASE_URL}/og-default.svg`}
    slot="head"
  />
  <meta property="og:type" content="website" slot="head" />
  <meta property="og:url" content={buildLocalizedPageUrl(BASE_URL, locale, `/tools/${tool.slug}`)} slot="head" />
  <meta property="og:site_name" content="U2Tool" slot="head" />
  <meta name="twitter:card" content="summary_large_image" slot="head" />
  <meta name="twitter:title" content={brandedSeoTitle} slot="head" />
  <meta name="twitter:description" content={seoDescription} slot="head" />
  <meta name="twitter:image" content={`${BASE_URL}/og-default.svg`} slot="head" />

  <StaticSidebar
    locale={locale}
    categories={categories}
    categoryNames={categoryMessages}
    navMessages={navMessages}
    siteName="U2Tool"
  />

  <div class="main-content-with-sidebar main-content-with-mobile-nav">
    <Header client:load locale={locale} translations={headerTranslations} />
    <div class="py-8 px-4">
    <div class="max-w-none mx-0">
      {/* Breadcrumb navigation */}
      <div class="mb-6">
        <Breadcrumb locale={locale} items={breadcrumbItems} />
      </div>

      {/* Tool Header */}
      <div class="text-center mb-10 pt-4">
        {/* Tool icon with Liquid Glass effect */}
        <div class="mx-auto mb-8 inline-flex items-center justify-center w-24 h-24 rounded-3xl
                    bg-white/60 dark:bg-slate-900 border border-slate-200/60 dark:border-white/10
                    shadow-2xl backdrop-blur-xl text-slate-400 dark:text-amber-500 transition-all duration-700
                    hover:scale-110 hover:shadow-amber-500/20 active:scale-95 group relative overflow-hidden">
          <div class="absolute inset-0 bg-gradient-to-br from-transparent to-amber-500/10 dark:to-amber-500/20 opacity-0 group-hover:opacity-100 transition-opacity"></div>
          <div class="relative z-10 drop-shadow-[0_0_15px_rgba(245,158,11,0.3)]">
            <Fragment set:html={getIconSvg(tool.icon, 48)} />
          </div>
        </div>
        {/* Tool name (LCP element) */}
        <h1 class="text-4xl md:text-5xl font-extrabold mb-4 text-slate-900 dark:text-white tracking-tight drop-shadow-sm dark:drop-shadow-[0_4px_12px_rgba(0,0,0,0.5)]">
          {toolName}
        </h1>
        <p class="text-slate-600 dark:text-slate-400 max-w-2xl mx-auto leading-relaxed text-lg font-medium">{toolDescription}</p>
      </div>

      {/* Detailed description */}
      {detailedDescription && (
        <div class="glass-card p-6 md:p-10 mb-10 relative overflow-hidden group">
          <div class="absolute inset-0 bg-gradient-to-br from-transparent to-amber-500/5 dark:to-amber-500/10 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="relative z-10 font-inter">
            <h2 class="text-2xl md:text-3xl font-bold mb-6 text-slate-900 dark:text-white tracking-tight flex items-center gap-3">
              <span class="w-1 h-8 bg-amber-500 rounded-full dark:shadow-[0_0_10px_rgba(245,158,11,0.5)]"></span>
              {toolIntroductionLabel}
            </h2>
            <div
              class="text-slate-600 dark:text-slate-400 leading-relaxed text-base md:text-lg max-w-4xl"
              set:html={safeDetailedDescription}
            />
          </div>
        </div>
      )}

      {comparisonGuide && (
        <section class="glass-card p-6 md:p-10 mb-10 relative overflow-hidden group">
          <div class="absolute inset-0 bg-gradient-to-br from-transparent to-amber-500/5 dark:to-amber-500/10 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="relative z-10">
            <p class="text-[10px] font-black uppercase tracking-[0.24em] text-amber-600/80 dark:text-amber-500/70 mb-3">
              {comparisonUiCopy.comparisonLabel}
            </p>
            <h2 class="text-2xl md:text-3xl font-bold text-slate-900 dark:text-white tracking-tight mb-4">
              {comparisonGuide.title}
            </h2>
            <p class="text-slate-600 dark:text-slate-400 text-base md:text-lg leading-relaxed max-w-4xl">
              {comparisonGuide.shortDescription}
            </p>
            {comparisonGuide.representativeTools.length > 0 && (
              <div class="mt-6">
                <p class="text-[10px] font-black uppercase tracking-[0.22em] text-slate-400 dark:text-slate-500 mb-3">
                  {comparisonUiCopy.includedToolsLabel}
                </p>
                <div class="flex flex-wrap gap-2.5">
                  {comparisonGuide.representativeTools.map((guideTool) => (
                    <a
                      href={guideTool.href}
                      class="inline-flex items-center rounded-xl border border-slate-200 bg-white/60 px-4 py-2 text-[11px] font-bold text-slate-600 transition-all hover:border-amber-400 hover:text-amber-600 dark:border-white/5 dark:bg-white/[0.02] dark:text-slate-400 dark:hover:border-amber-500/50 dark:hover:text-amber-300 shadow-sm"
                    >
                      {guideTool.name}
                    </a>
                  ))}
                </div>
              </div>
            )}
            <div class="mt-8">
              <a
                href={comparisonGuide.href}
                class="btn-primary !px-6 !py-3 !text-[11px] !rounded-2xl active:scale-95 shadow-lg dark:hover:shadow-amber-500/20"
              >
                {comparisonUiCopy.guideCtaLabel}
              </a>
            </div>
          </div>
        </section>
      )}

      {/* Cluster cards — data-driven loop over 8 cluster blocks */}
      {CLUSTER_BLOCKS.map(({ group, Card, clusterPath, copy }) =>
        group && (
          <Card
            clusterHref={buildLocalizedPagePath(locale, clusterPath)}
            copy={copy}
            currentSlug={tool.slug}
            group={group}
          />
        )
      )}

      {/* Tool Component — Island Architecture: hydrate only when visible */}
      <div class="glass-card p-6 md:p-10 shadow-2xl mb-10 transition-all hover:shadow-amber-500/10 ring-1 ring-white/5">
        <ToolWrapper
          client:visible
          slug={tool.slug}
          locale={locale}
          translations={toolTranslations}
        />
      </div>

      {/* Usage instructions */}
      {(usageSteps || usageExamples) && (
        <div class="glass-card p-6 md:p-10 mb-10 group">
          <h2 class="text-2xl md:text-3xl font-bold mb-8 text-slate-900 dark:text-white tracking-tight flex items-center gap-3">
            <span class="w-1 h-8 bg-amber-500 rounded-full dark:shadow-[0_0_10px_rgba(245,158,11,0.5)]"></span>
            {usageInstructionsLabel}
          </h2>

          {usageSteps && Array.isArray(usageSteps) && (
            <Fragment>
              <h3 class="text-xl font-bold mb-5 text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
                <span class="text-amber-500" set:html={getIconSvg('check-circle-2', 20)} />
                {usageStepsLabel}
              </h3>
              <ol class="list-decimal list-inside space-y-3 mb-8">
                {usageSteps.map((step: string) => (
                  <li class="text-slate-600 dark:text-slate-400 text-sm md:text-base leading-relaxed">{step}</li>
                ))}
              </ol>
            </Fragment>
          )}

          {usageExamples && Array.isArray(usageExamples) && (
            <Fragment>
              <h3 class="text-xl font-bold mb-5 text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
                <span class="text-amber-500" set:html={getIconSvg('code-2', 20)} />
                {usageExamplesLabel}
              </h3>
              <div class="space-y-4">
                {usageExamples.map((example: string) => (
                  <div class="bg-slate-50/50 dark:bg-slate-950/60 p-5 rounded-2xl border border-slate-200/60 dark:border-white/5 shadow-inner">
                    <code class="text-sm md:text-base text-slate-800 dark:text-amber-200/90 whitespace-pre-wrap break-words font-mono">
                      {example}
                    </code>
                  </div>
                ))}
              </div>
            </Fragment>
          )}
        </div>
      )}

      {/* FAQ section with FAQPage structured data */}
      <ToolFAQ toolName={toolName} faqs={faqs} />

      {/* Related tools */}
      <RelatedTools
        currentTool={tool}
        locale={locale}
        toolTranslations={allToolTranslations}
        headingLabel={relatedToolsLabel}
      />
    </div>
  </div>
  </div>

  <MobileBottomNav client:load locale={locale} navMessages={mobileNavMessages} />
</BaseLayout>
