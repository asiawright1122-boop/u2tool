---
/**
 * Tool list page for each locale
 * Route: /{locale}/tools/
 * Includes sidebar layout matching the original Next.js design.
 * Supports ?category= filtering via ToolsGrid Svelte component.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.svelte';
import StaticSidebar from '@/components/layout/StaticSidebar.astro';
import MobileBottomNav from '@/components/layout/MobileBottomNav.svelte';
import Footer from '@/components/layout/Footer.astro';
import ToolsGrid from '@/components/tools/ToolsGrid.astro';
import CategorySpotlightSection from '@/components/discovery/CategorySpotlightSection.astro';
import ToolClusterSection from '@/components/discovery/ToolClusterSection.astro';
import ComparisonGuideSection from '@/components/discovery/ComparisonGuideSection.astro';
import ToolLaunchSection from '@/components/discovery/ToolLaunchSection.astro';
import StructuredData from '@/components/seo/StructuredData.astro';
import HreflangTags from '@/components/seo/HreflangTags.astro';
import { tools, categories } from '@/config/tools';
import { isValidLocale } from '@/lib/i18n';
import type { Locale } from '@/lib/i18n';
import { filterIndexableTools } from '@/lib/index-suppression';
import { loadBaseUiMessages } from '@/lib/translations';
import { buildCategoryDiscoveryItemList, buildCategoryDiscoverySpotlights } from '@/lib/discovery-surface';
import {
  buildChartToolClusterGroups,
  chartToolClusterPath,
  getChartToolClusterCopy,
} from '@/lib/chart-tool-cluster';
import { buildComparisonGuides, getComparisonUiCopy } from '@/lib/comparison-surfaces';
import {
  buildAiToolsDirectory,
  getAiToolsDirectoryCopy,
} from '@/lib/ai-tools-directory';
import {
  AI_TOOLS_DIRECTORY_PATH,
  getAiToolsDirectoryLabel,
} from '@/lib/ai-tools-navigation';
import {
  buildCreatorSeoClusterGroups,
  creatorSeoClusterPath,
  getCreatorSeoClusterCopy,
} from '@/lib/creator-seo-cluster';
import {
  buildDeveloperDataToolClusterGroups,
  developerDataToolClusterPath,
  getDeveloperDataToolClusterCopy,
} from '@/lib/developer-data-tool-cluster';
import {
  buildImageToolClusterGroups,
  getImageToolClusterCopy,
  imageToolClusterPath,
} from '@/lib/image-tool-cluster';
import {
  buildOnlineCalculatorClusterGroups,
  getOnlineCalculatorClusterCopy,
  onlineCalculatorClusterPath,
} from '@/lib/online-calculator-cluster';
import {
  buildPdfDocumentToolClusterGroups,
  getPdfDocumentToolClusterCopy,
  pdfDocumentToolClusterPath,
} from '@/lib/pdf-document-tool-cluster';
import {
  buildSecurityToolClusterGroups,
  getSecurityToolClusterCopy,
  securityToolClusterPath,
} from '@/lib/security-tool-cluster';
import {
  buildTextWritingToolClusterGroups,
  getTextWritingToolClusterCopy,
  textWritingToolClusterPath,
} from '@/lib/text-writing-tool-cluster';
import { buildRecentToolLaunches, buildToolLaunchItemList } from '@/lib/tool-launches';
import { getToolsPageSeo } from '@/lib/seo';
import { buildHeaderTranslations, buildMobileNavMessages } from '@/lib/layout-translations';
import { getPublicSiteUrl } from '@/lib/public-env';
import { buildLocalizedPagePath, buildLocalizedPageUrl } from '@/lib/seo';
import { searchTools } from '@/components/tools/tools-grid-search';

export const prerender = false;

const localeCandidate = Astro.params.locale ?? (Astro.props as { locale?: Locale }).locale;
if (typeof localeCandidate !== 'string' || !isValidLocale(localeCandidate)) {
  return Astro.redirect('/en/tools/', 302);
}
const locale: Locale = localeCandidate;
const baseMessages = await loadBaseUiMessages(locale, Astro.url);
const toolsObj = (baseMessages.tools as Record<string, unknown>) ?? {};
const categoryMessages = (baseMessages.categories as Record<string, string>) ?? {};
const navMessages = (baseMessages.nav as Record<string, string>) ?? {};
const homeMessages = (baseMessages.home as Record<string, unknown>) ?? {};
const heroMessages = (homeMessages.hero as Record<string, string>) ?? {};
const searchMessages = (baseMessages.search as Record<string, string>) ?? {};
const siteMessages = (baseMessages.site as Record<string, string>) ?? {};
const toolsMessages = (baseMessages.tools as Record<string, string>) ?? {};
const toolsPageSeo = getToolsPageSeo(baseMessages, tools.length, locale);
const headerTranslations = buildHeaderTranslations(baseMessages);
const mobileNavMessages = buildMobileNavMessages(navMessages);
const searchQuery = (Astro.url.searchParams.get('q') || '').trim();
const activeCategory = (Astro.url.searchParams.get('category') || '').trim();

const toolNames: Record<string, string> = {};
const toolDescriptions: Record<string, string> = {};
for (const tool of tools) {
  const currentTool = toolsObj[tool.slug] as Record<string, unknown> | undefined;
  toolNames[tool.slug] = (currentTool?.name as string) || tool.slug;
  toolDescriptions[tool.slug] =
    (currentTool?.seo_description as string) || (currentTool?.description as string) || '';
}

const baseUrl = getPublicSiteUrl();
const discoverySpotlights = buildCategoryDiscoverySpotlights(
  locale,
  categoryMessages,
  toolNames,
  toolDescriptions
);
const discoveryItemListData = buildCategoryDiscoveryItemList(baseUrl, discoverySpotlights);
const recentLaunchTools = buildRecentToolLaunches(
  locale,
  categoryMessages,
  toolNames,
  toolDescriptions
);
const launchItemListData = buildToolLaunchItemList(baseUrl, recentLaunchTools);
const comparisonUiCopy = getComparisonUiCopy(locale);
const comparisonGuides = buildComparisonGuides(locale, categoryMessages, toolNames, toolDescriptions);
const aiToolsDirectoryCopy = getAiToolsDirectoryCopy(locale);
const aiToolsDirectoryLabel = getAiToolsDirectoryLabel(locale);
const aiToolsDirectoryGroups = buildAiToolsDirectory(
  locale,
  categoryMessages,
  toolNames,
  toolDescriptions
);
const creatorSeoCopy = getCreatorSeoClusterCopy(locale);
const creatorSeoGroups = buildCreatorSeoClusterGroups(
  locale,
  categoryMessages,
  toolNames,
  toolDescriptions
);
const developerDataToolCopy = getDeveloperDataToolClusterCopy(locale);
const developerDataToolGroups = buildDeveloperDataToolClusterGroups(
  locale,
  categoryMessages,
  toolNames,
  toolDescriptions
);
const imageToolCopy = getImageToolClusterCopy(locale);
const imageToolGroups = buildImageToolClusterGroups(
  locale,
  categoryMessages,
  toolNames,
  toolDescriptions
);
const onlineCalculatorCopy = getOnlineCalculatorClusterCopy(locale);
const onlineCalculatorGroups = buildOnlineCalculatorClusterGroups(
  locale,
  categoryMessages,
  toolNames,
  toolDescriptions
);
const pdfDocumentToolCopy = getPdfDocumentToolClusterCopy(locale);
const pdfDocumentToolGroups = buildPdfDocumentToolClusterGroups(
  locale,
  categoryMessages,
  toolNames,
  toolDescriptions
);
const securityToolCopy = getSecurityToolClusterCopy(locale);
const securityToolGroups = buildSecurityToolClusterGroups(
  locale,
  categoryMessages,
  toolNames,
  toolDescriptions
);
const textWritingToolCopy = getTextWritingToolClusterCopy(locale);
const textWritingToolGroups = buildTextWritingToolClusterGroups(
  locale,
  categoryMessages,
  toolNames,
  toolDescriptions
);
const chartToolCopy = getChartToolClusterCopy(locale);
const chartToolGroups = buildChartToolClusterGroups(
  locale,
  categoryMessages,
  toolNames,
  toolDescriptions
);
const initialSearchResults = searchQuery
  ? searchTools(
      tools.map((tool) => ({
          slug: tool.slug,
          href: buildLocalizedPageUrl(baseUrl, locale, `/tools/${tool.slug}`),
          name: toolNames[tool.slug] || tool.slug,
          description: toolDescriptions[tool.slug] || '',
          category: tool.category,
          categoryName: categoryMessages[tool.category] || tool.category,
        })),
      searchQuery,
      { category: activeCategory, limit: 24 }
    )
  : [];
const toolsCollectionData = {
  name: toolsPageSeo.title,
  description: toolsPageSeo.description,
  url: buildLocalizedPageUrl(baseUrl, locale, '/tools'),
  numberOfItems: tools.length,
  hasPart: discoverySpotlights.map((spotlight) => ({
    '@type': 'CollectionPage',
    name: spotlight.name,
    url: `${baseUrl}${spotlight.href}`,
    numberOfItems: spotlight.toolCount,
  })),
};
---

<BaseLayout
  title={toolsPageSeo.title}
  description={toolsPageSeo.description}
  locale={locale}
  canonicalPath="/tools"
  siteDescription={siteMessages.description}
>
  <HreflangTags path="/tools" slot="head" />
  <StructuredData type="CollectionPage" data={toolsCollectionData} slot="head" />
  <StructuredData type="ItemList" data={discoveryItemListData} slot="head" />
  <StructuredData type="ItemList" data={launchItemListData} slot="head" />

  <meta property="og:title" content={toolsPageSeo.title} slot="head" />
  <meta property="og:description" content={toolsPageSeo.description} slot="head" />
  <meta property="og:image" content={`${baseUrl}/og-default.svg`} slot="head" />
  <meta property="og:type" content="website" slot="head" />
  <meta property="og:url" content={buildLocalizedPageUrl(baseUrl, locale, '/tools')} slot="head" />
  <meta property="og:site_name" content="U2Tool" slot="head" />
  <meta name="twitter:card" content="summary_large_image" slot="head" />
  <meta name="twitter:title" content={toolsPageSeo.title} slot="head" />
  <meta name="twitter:description" content={toolsPageSeo.description} slot="head" />
  <meta name="twitter:image" content={`${baseUrl}/og-default.svg`} slot="head" />

  <StaticSidebar
    locale={locale}
    categories={categories}
    categoryNames={categoryMessages}
    navMessages={navMessages}
    siteName={siteMessages.name || 'U2Tool'}
  />

  <div class="main-content-with-sidebar main-content-with-mobile-nav">
    <Header client:load locale={locale} translations={headerTranslations} />

    <main class="py-6 px-4 lg:px-6">
      <div class="max-w-none mx-0">
        <section class="mb-8 rounded-3xl border border-slate-200/60 glass p-8 shadow-2xl backdrop-blur-xl dark:border-white/10 dark:bg-slate-900/40">
          <p class="mb-3 text-[10px] font-black uppercase tracking-[0.3em] text-amber-600/80 dark:text-amber-500/60">
            {siteMessages.name || 'U2Tool'}
          </p>
          <h1 class="max-w-4xl text-4xl font-black tracking-tight text-slate-900 drop-shadow-sm dark:text-white md:text-5xl">
            {toolsPageSeo.title}
          </h1>
          <p class="mt-4 max-w-3xl text-sm font-medium leading-7 text-slate-500 dark:text-slate-400">
            {toolsPageSeo.description}
          </p>
        </section>
        <ToolsGrid
          locale={locale}
          categories={categories}
          tools={filterIndexableTools(locale, tools).map((tool) => ({
            slug: tool.slug,
            category: tool.category,
            icon: tool.icon,
            popular: tool.popular,
          }))}
          categoryNames={categoryMessages}
          toolNames={toolNames}
          toolDescriptions={toolDescriptions}
          previewCount={6}
          searchIndexPath={`/${locale}/tools-index.json`}
          emptyResultsLabel={searchMessages.noResults || navMessages.noResults || 'No tools found'}
          initialSearchQuery={searchQuery}
          initialSearchResults={initialSearchResults}
        />

        <ToolLaunchSection
          eyebrow={navMessages.launches || 'Launches'}
          title={(homeMessages.recentTools as string) || 'Recent Tools'}
          description={(homeMessages.recentToolsDesc as string) || ''}
          ctaLabel={heroMessages.tryTool || 'Try'}
          tools={recentLaunchTools}
        />
        <ToolClusterSection
          compact
          theme="sky"
          dataPrefix="ai-tools-directory-cluster"
          gridCols={3}
          toolLimit={6}
          eyebrow={aiToolsDirectoryCopy.eyebrow}
          title={aiToolsDirectoryCopy.h1}
          description={aiToolsDirectoryCopy.description}
          ctaLabel={aiToolsDirectoryLabel}
          href={buildLocalizedPagePath(locale, AI_TOOLS_DIRECTORY_PATH)}
          groups={aiToolsDirectoryGroups}
          toolCountLabel={aiToolsDirectoryCopy.toolCountLabel}
        />
        <ToolClusterSection
          compact
          theme="amber"
          dataPrefix="creator-seo-cluster"
          gridCols={3}
          eyebrow={creatorSeoCopy.eyebrow}
          title={creatorSeoCopy.title}
          description={creatorSeoCopy.description}
          ctaLabel={creatorSeoCopy.ctaLabel}
          href={buildLocalizedPagePath(locale, creatorSeoClusterPath)}
          groups={creatorSeoGroups}
          toolCountLabel={creatorSeoCopy.toolCountLabel}
        />
        <ToolClusterSection
          compact
          theme="cyan"
          dataPrefix="developer-data-tool-cluster"
          eyebrow={developerDataToolCopy.eyebrow}
          title={developerDataToolCopy.title}
          description={developerDataToolCopy.description}
          ctaLabel={developerDataToolCopy.ctaLabel}
          href={buildLocalizedPagePath(locale, developerDataToolClusterPath)}
          groups={developerDataToolGroups}
          toolCountLabel={developerDataToolCopy.toolCountLabel}
        />
        <ToolClusterSection
          compact
          theme="amber"
          dataPrefix="image-tool-cluster"
          eyebrow={imageToolCopy.eyebrow}
          title={imageToolCopy.title}
          description={imageToolCopy.description}
          ctaLabel={imageToolCopy.ctaLabel}
          href={buildLocalizedPagePath(locale, imageToolClusterPath)}
          groups={imageToolGroups}
          toolCountLabel={imageToolCopy.toolCountLabel}
        />
        <ToolClusterSection
          compact
          theme="emerald"
          dataPrefix="online-calculator-cluster"
          eyebrow={onlineCalculatorCopy.eyebrow}
          title={onlineCalculatorCopy.title}
          description={onlineCalculatorCopy.description}
          ctaLabel={onlineCalculatorCopy.ctaLabel}
          href={buildLocalizedPagePath(locale, onlineCalculatorClusterPath)}
          groups={onlineCalculatorGroups}
          toolCountLabel={onlineCalculatorCopy.toolCountLabel}
        />
        <ToolClusterSection
          compact
          theme="sky"
          dataPrefix="pdf-document-tool-cluster"
          eyebrow={pdfDocumentToolCopy.eyebrow}
          title={pdfDocumentToolCopy.title}
          description={pdfDocumentToolCopy.description}
          ctaLabel={pdfDocumentToolCopy.ctaLabel}
          href={buildLocalizedPagePath(locale, pdfDocumentToolClusterPath)}
          groups={pdfDocumentToolGroups}
          toolCountLabel={pdfDocumentToolCopy.toolCountLabel}
        />
        <ToolClusterSection
          compact
          theme="emerald"
          dataPrefix="text-writing-tool-cluster"
          eyebrow={textWritingToolCopy.eyebrow}
          title={textWritingToolCopy.title}
          description={textWritingToolCopy.description}
          ctaLabel={textWritingToolCopy.ctaLabel}
          href={buildLocalizedPagePath(locale, textWritingToolClusterPath)}
          groups={textWritingToolGroups}
          toolCountLabel={textWritingToolCopy.toolCountLabel}
        />
        <ToolClusterSection
          compact
          theme="rose"
          dataPrefix="security-tool-cluster"
          eyebrow={securityToolCopy.eyebrow}
          title={securityToolCopy.title}
          description={securityToolCopy.description}
          ctaLabel={securityToolCopy.ctaLabel}
          href={buildLocalizedPagePath(locale, securityToolClusterPath)}
          groups={securityToolGroups}
          toolCountLabel={securityToolCopy.toolCountLabel}
        />
        <ToolClusterSection
          compact
          theme="amber"
          dataPrefix="chart-tool-cluster"
          eyebrow={chartToolCopy.eyebrow}
          title={chartToolCopy.title}
          description={chartToolCopy.description}
          ctaLabel={chartToolCopy.ctaLabel}
          href={buildLocalizedPagePath(locale, chartToolClusterPath)}
          groups={chartToolGroups}
          toolCountLabel={chartToolCopy.toolCountLabel}
        />
        <CategorySpotlightSection
          eyebrow={siteMessages.name || 'U2Tool'}
          title={(homeMessages.categories as string) || 'Tool Categories'}
          description={(homeMessages.categoriesDesc as string) || 'Find the right tool for your needs'}
          popularLabel={(toolsMessages.popular || 'Popular').toUpperCase()}
          toolsCountLabel={(homeMessages.toolsCount as string) || 'tools'}
          spotlights={discoverySpotlights}
        />
        <ComparisonGuideSection
          title={comparisonUiCopy.comparisonSectionTitle}
          description={comparisonUiCopy.comparisonSectionDescription}
          guides={comparisonGuides}
          ctaLabel={comparisonUiCopy.guideCtaLabel}
          includedToolsLabel={comparisonUiCopy.includedToolsLabel}
        />
      </div>
    </main>

    <Footer locale={locale} />
  </div>

  <MobileBottomNav client:load locale={locale} navMessages={mobileNavMessages} />
</BaseLayout>
