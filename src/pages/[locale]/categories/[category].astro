---
/**
 * Category page for each category × each locale
 * Route: /{locale}/categories/{category}
 * Renders on Cloudflare SSR so localized category copy stays aligned with the
 * current message assets in every locale.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.svelte';
import StaticSidebar from '@/components/layout/StaticSidebar.astro';
import MobileBottomNav from '@/components/layout/MobileBottomNav.svelte';
import Footer from '@/components/layout/Footer.astro';
import CategorySupportSection from '@/components/categories/CategorySupportSection.astro';
import ChartToolClusterSection from '@/components/discovery/ChartToolClusterSection.astro';
import CreatorSeoClusterSection from '@/components/discovery/CreatorSeoClusterSection.astro';
import DeveloperDataToolClusterSection from '@/components/discovery/DeveloperDataToolClusterSection.astro';
import ImageToolClusterSection from '@/components/discovery/ImageToolClusterSection.astro';
import OnlineCalculatorClusterSection from '@/components/discovery/OnlineCalculatorClusterSection.astro';
import PdfDocumentToolClusterSection from '@/components/discovery/PdfDocumentToolClusterSection.astro';
import SecurityToolClusterSection from '@/components/discovery/SecurityToolClusterSection.astro';
import Breadcrumb from '@/components/layout/Breadcrumb.astro';
import HreflangTags from '@/components/seo/HreflangTags.astro';
import StructuredData from '@/components/seo/StructuredData.astro';
import { categories, getToolsByCategory, tools as allTools } from '@/config/tools';
import type { ToolCategory } from '@/config/tools';
import { getIconSvg } from '@/lib/icon-svg';
import { getLocalizedPath, isValidLocale } from '@/lib/i18n';
import type { Locale } from '@/lib/i18n';
import { loadBaseUiMessages } from '@/lib/translations';
import { getCategoryPageSeo } from '@/lib/seo';
import { buildLocalizedPagePath, buildLocalizedPageUrl, getHreflang } from '@/lib/seo';
import { getCategorySupportContent } from '@/lib/category-support';
import {
  buildChartToolClusterGroups,
  chartToolClusterPath,
  getChartToolClusterCopy,
} from '@/lib/chart-tool-cluster';
import { buildHeaderTranslations, buildMobileNavMessages } from '@/lib/layout-translations';
import { getPublicSiteUrl } from '@/lib/public-env';
import {
  buildCreatorSeoClusterGroups,
  creatorSeoClusterPath,
  getCreatorSeoClusterCopy,
} from '@/lib/creator-seo-cluster';
import {
  buildDeveloperDataToolClusterGroups,
  developerDataToolClusterPath,
  getDeveloperDataToolClusterCopy,
} from '@/lib/developer-data-tool-cluster';
import {
  buildImageToolClusterGroups,
  getImageToolClusterCopy,
  imageToolClusterPath,
} from '@/lib/image-tool-cluster';
import {
  buildOnlineCalculatorClusterGroups,
  getOnlineCalculatorClusterCopy,
  onlineCalculatorClusterPath,
} from '@/lib/online-calculator-cluster';
import {
  buildPdfDocumentToolClusterGroups,
  getPdfDocumentToolClusterCopy,
  pdfDocumentToolClusterPath,
} from '@/lib/pdf-document-tool-cluster';
import {
  buildSecurityToolClusterGroups,
  getSecurityToolClusterCopy,
  securityToolClusterPath,
} from '@/lib/security-tool-cluster';

export const prerender = false;

const localeCandidate = Astro.params.locale;
if (typeof localeCandidate !== 'string' || !isValidLocale(localeCandidate)) {
  return Astro.redirect('/en/categories/text/', 302);
}
const locale: Locale = localeCandidate;

const categoryCandidate = Astro.params.category;
const categoryIds = categories.map((candidate) => candidate.id);
if (typeof categoryCandidate !== 'string' || !categoryIds.includes(categoryCandidate as ToolCategory)) {
  return Astro.redirect(`/${locale}/tools/`, 302);
}
const category = categoryCandidate as ToolCategory;

const baseMessages = await loadBaseUiMessages(locale, Astro.url);
const toolsObj = (baseMessages.tools as Record<string, unknown>) ?? {};
const categoryMessages = (baseMessages.categories as Record<string, string>) ?? {};
const navMessages = (baseMessages.nav as Record<string, string>) ?? {};
const siteMessages = (baseMessages.site as Record<string, string>) ?? {};
const headerTranslations = buildHeaderTranslations(baseMessages);
const mobileNavMessages = buildMobileNavMessages(navMessages);

const categoryName = categoryMessages[category] || category;
const categoryTools = getToolsByCategory(category);
const catConfig = categories.find(c => c.id === category);
const catIcon = catConfig?.icon || '<svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/></svg>';

function getToolName(slug: string): string {
  const t = toolsObj[slug] as Record<string, unknown> | undefined;
  return (t?.name as string) || slug;
}

function getToolDescription(slug: string): string {
  const t = toolsObj[slug] as Record<string, unknown> | undefined;
  return (t?.seo_description as string) || (t?.description as string) || '';
}

const BASE_URL = getPublicSiteUrl();
const schemaLanguage = getHreflang(locale);
const categorySeo = getCategoryPageSeo(baseMessages, category, categoryName, categoryTools.length);
const pageTitle = categorySeo.title;
const pageDescription = categorySeo.description;
const categorySupport = getCategorySupportContent(locale, category);
const categoryToolNames = Object.fromEntries(categoryTools.map((tool) => [tool.slug, getToolName(tool.slug)]));
const categoryToolDescriptions = Object.fromEntries(categoryTools.map((tool) => [tool.slug, getToolDescription(tool.slug)]));
const allToolNames = Object.fromEntries(allTools.map((tool) => [tool.slug, getToolName(tool.slug)]));
const allToolDescriptions = Object.fromEntries(allTools.map((tool) => [tool.slug, getToolDescription(tool.slug)]));
const creatorSeoCopy = getCreatorSeoClusterCopy(locale);
const creatorSeoGroups = category === 'generators'
  ? buildCreatorSeoClusterGroups(locale, categoryMessages, categoryToolNames, categoryToolDescriptions)
  : [];
const developerDataToolCopy = getDeveloperDataToolClusterCopy(locale);
const developerDataClusterCategories: ToolCategory[] = ['encoding', 'converters', 'development'];
const developerDataToolGroups = developerDataClusterCategories.includes(category)
  ? buildDeveloperDataToolClusterGroups(locale, categoryMessages, allToolNames, allToolDescriptions)
  : [];
const imageToolCopy = getImageToolClusterCopy(locale);
const imageToolGroups = category === 'image'
  ? buildImageToolClusterGroups(locale, categoryMessages, categoryToolNames, categoryToolDescriptions)
  : [];
const onlineCalculatorCopy = getOnlineCalculatorClusterCopy(locale);
const onlineCalculatorCategories: ToolCategory[] = ['finance', 'math', 'lifestyle', 'office', 'network', 'converters'];
const onlineCalculatorGroups = onlineCalculatorCategories.includes(category)
  ? buildOnlineCalculatorClusterGroups(locale, categoryMessages, allToolNames, allToolDescriptions)
  : [];
const pdfDocumentToolCopy = getPdfDocumentToolClusterCopy(locale);
const pdfDocumentClusterCategories: ToolCategory[] = ['office', 'converters', 'finance'];
const pdfDocumentToolGroups = pdfDocumentClusterCategories.includes(category)
  ? buildPdfDocumentToolClusterGroups(locale, categoryMessages, allToolNames, allToolDescriptions)
  : [];
const securityToolCopy = getSecurityToolClusterCopy(locale);
const securityClusterCategories: ToolCategory[] = ['security', 'network', 'encoding'];
const securityToolGroups = securityClusterCategories.includes(category)
  ? buildSecurityToolClusterGroups(locale, categoryMessages, allToolNames, allToolDescriptions)
  : [];
const chartToolCopy = getChartToolClusterCopy(locale);
const chartToolGroups = category === 'charts'
  ? buildChartToolClusterGroups(locale, categoryMessages, categoryToolNames, categoryToolDescriptions)
  : [];

const breadcrumbItems = [
  { label: navMessages.home || 'Home', href: buildLocalizedPagePath(locale, '/') },
  { label: categoryName, href: buildLocalizedPagePath(locale, `/categories/${category}`) },
];

// BreadcrumbList structured data
const breadcrumbData = {
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    item: `${BASE_URL}${item.href}`,
  })),
};

// CollectionPage structured data
const collectionData = {
  name: categoryName,
  description: pageDescription,
  url: buildLocalizedPageUrl(BASE_URL, locale, `/categories/${category}`),
  inLanguage: schemaLanguage,
  numberOfItems: categoryTools.length,
  hasPart: categoryTools.slice(0, 10).map(tool => ({
    '@type': 'SoftwareApplication',
    name: getToolName(tool.slug),
    url: buildLocalizedPageUrl(BASE_URL, locale, `/tools/${tool.slug}`),
  })),
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  locale={locale}
  canonicalPath={`/categories/${category}`}
  siteDescription={siteMessages.description}
>
  <HreflangTags path={`/categories/${category}`} slot="head" />
  <StructuredData type="BreadcrumbList" data={breadcrumbData} slot="head" />
  <StructuredData type="CollectionPage" data={collectionData} slot="head" />

  <meta property="og:title" content={pageTitle} slot="head" />
  <meta property="og:description" content={pageDescription} slot="head" />
  <meta property="og:image" content={`${BASE_URL}/og-default.svg`} slot="head" />
  <meta property="og:type" content="website" slot="head" />
  <meta property="og:url" content={buildLocalizedPageUrl(BASE_URL, locale, `/categories/${category}`)} slot="head" />
  <meta property="og:site_name" content="U2Tool" slot="head" />
  <meta name="twitter:card" content="summary_large_image" slot="head" />
  <meta name="twitter:title" content={pageTitle} slot="head" />
  <meta name="twitter:description" content={pageDescription} slot="head" />
  <meta name="twitter:image" content={`${BASE_URL}/og-default.svg`} slot="head" />

  <StaticSidebar
    locale={locale}
    categories={categories}
    categoryNames={categoryMessages}
    navMessages={navMessages}
    siteName={siteMessages.name || 'U2Tool'}
  />

  <div class="main-content-with-sidebar main-content-with-mobile-nav">
    <Header client:load locale={locale} translations={headerTranslations} />

    <main class="py-6 px-4 lg:px-6">
      <div class="max-w-none mx-0">
        <div class="mb-6">
          <Breadcrumb locale={locale} items={breadcrumbItems} />
        </div>

        <div class="mb-10">
          <h1 class="text-3xl md:text-5xl font-extrabold text-slate-900 dark:text-white flex items-center gap-5 tracking-tight drop-shadow-sm dark:drop-shadow-[0_4px_12px_rgba(0,0,0,0.5)]">
            <span class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-white/60 dark:bg-slate-900 border border-slate-200 dark:border-white/10 shadow-xl backdrop-blur-xl text-slate-400 dark:text-amber-500 transition-all duration-500 hover:scale-110 hover:shadow-amber-500/20" set:html={getIconSvg(catIcon, 32)} />
            <div class="flex flex-col">
              <span>{categoryName}</span>
              <span class="text-sm font-bold uppercase tracking-[0.2em] text-slate-400 dark:text-amber-500/60 mt-1">{categoryTools.length} {navMessages.tools || 'Tools'}</span>
            </div>
          </h1>
        </div>

        {categorySupport && (
          <CategorySupportSection
            content={categorySupport}
            locale={locale}
            toolNames={categoryToolNames}
            toolDescriptions={categoryToolDescriptions}
          />
        )}

        {category === 'generators' && (
          <CreatorSeoClusterSection
            eyebrow={creatorSeoCopy.eyebrow}
            title={creatorSeoCopy.title}
            description={creatorSeoCopy.description}
            ctaLabel={creatorSeoCopy.ctaLabel}
            href={buildLocalizedPagePath(locale, creatorSeoClusterPath)}
            groups={creatorSeoGroups}
            toolCountLabel={creatorSeoCopy.toolCountLabel}
          />
        )}

        {category === 'image' && (
          <ImageToolClusterSection
            eyebrow={imageToolCopy.eyebrow}
            title={imageToolCopy.title}
            description={imageToolCopy.description}
            ctaLabel={imageToolCopy.ctaLabel}
            href={buildLocalizedPagePath(locale, imageToolClusterPath)}
            groups={imageToolGroups}
            toolCountLabel={imageToolCopy.toolCountLabel}
          />
        )}

        {developerDataClusterCategories.includes(category) && (
          <DeveloperDataToolClusterSection
            eyebrow={developerDataToolCopy.eyebrow}
            title={developerDataToolCopy.title}
            description={developerDataToolCopy.description}
            ctaLabel={developerDataToolCopy.ctaLabel}
            href={buildLocalizedPagePath(locale, developerDataToolClusterPath)}
            groups={developerDataToolGroups}
            toolCountLabel={developerDataToolCopy.toolCountLabel}
          />
        )}

        {onlineCalculatorCategories.includes(category) && (
          <OnlineCalculatorClusterSection
            eyebrow={onlineCalculatorCopy.eyebrow}
            title={onlineCalculatorCopy.title}
            description={onlineCalculatorCopy.description}
            ctaLabel={onlineCalculatorCopy.ctaLabel}
            href={buildLocalizedPagePath(locale, onlineCalculatorClusterPath)}
            groups={onlineCalculatorGroups}
            toolCountLabel={onlineCalculatorCopy.toolCountLabel}
          />
        )}

        {pdfDocumentClusterCategories.includes(category) && (
          <PdfDocumentToolClusterSection
            eyebrow={pdfDocumentToolCopy.eyebrow}
            title={pdfDocumentToolCopy.title}
            description={pdfDocumentToolCopy.description}
            ctaLabel={pdfDocumentToolCopy.ctaLabel}
            href={buildLocalizedPagePath(locale, pdfDocumentToolClusterPath)}
            groups={pdfDocumentToolGroups}
            toolCountLabel={pdfDocumentToolCopy.toolCountLabel}
          />
        )}

        {securityClusterCategories.includes(category) && (
          <SecurityToolClusterSection
            eyebrow={securityToolCopy.eyebrow}
            title={securityToolCopy.title}
            description={securityToolCopy.description}
            ctaLabel={securityToolCopy.ctaLabel}
            href={buildLocalizedPagePath(locale, securityToolClusterPath)}
            groups={securityToolGroups}
            toolCountLabel={securityToolCopy.toolCountLabel}
          />
        )}

        {category === 'charts' && (
          <ChartToolClusterSection
            eyebrow={chartToolCopy.eyebrow}
            title={chartToolCopy.title}
            description={chartToolCopy.description}
            ctaLabel={chartToolCopy.ctaLabel}
            href={buildLocalizedPagePath(locale, chartToolClusterPath)}
            groups={chartToolGroups}
            toolCountLabel={chartToolCopy.toolCountLabel}
          />
        )}

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          {categoryTools.map((tool) => (
            <a
              href={getLocalizedPath(locale, `/tools/${tool.slug}`)}
              class="glass-card flex items-center gap-4 p-5 group/card relative overflow-hidden"
            >
              <div class="absolute inset-0 bg-gradient-to-br from-transparent to-amber-500/5 dark:to-amber-500/10 opacity-0 group-hover/card:opacity-100 transition-opacity duration-500"></div>
              <div class="relative z-10 flex items-center gap-4 w-full">
                <span
                  class="text-slate-400 dark:text-slate-500 flex-shrink-0 inline-flex transition-all duration-500 group-hover/card:text-amber-500 group-hover/card:scale-110 group-hover/card:drop-shadow-[0_0_8px_rgba(245,158,11,0.5)]"
                  set:html={getIconSvg(tool.icon, 24)}
                />
                <div class="flex-1 min-w-0">
                  <h3 class="font-bold text-sm text-slate-900 dark:text-white truncate group-hover/card:text-amber-600 dark:group-hover/card:text-amber-400 transition-colors uppercase tracking-tight">
                    {getToolName(tool.slug)}
                  </h3>
                  <p class="text-[11px] text-slate-500 dark:text-slate-400 truncate mt-1.5 leading-relaxed">
                    {getToolDescription(tool.slug)}
                  </p>
                </div>
                {tool.popular && (
                  <span class="inline-flex items-center px-2 py-0.5 text-[9px] font-black rounded-full bg-amber-100 text-amber-600 dark:bg-amber-900/40 dark:text-amber-400 flex-shrink-0 border border-amber-200/50 dark:border-amber-500/30 shadow-[0_0_15px_rgba(245,158,11,0.2)] tracking-tighter uppercase">
                    HOT
                  </span>
                )}
              </div>
            </a>
          ))}
        </div>
      </div>
    </main>

    <Footer locale={locale} />
  </div>

  <MobileBottomNav client:load locale={locale} navMessages={mobileNavMessages} />
</BaseLayout>
