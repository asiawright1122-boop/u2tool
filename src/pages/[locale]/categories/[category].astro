---
/**
 * Category page for each category × each locale
 * Route: /{locale}/categories/{category}
 * Generates static paths for all 14 categories × all 10 locales
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.svelte';
import StaticSidebar from '@/components/layout/StaticSidebar.astro';
import MobileBottomNav from '@/components/layout/MobileBottomNav.svelte';
import Footer from '@/components/layout/Footer.astro';
import CategorySupportSection from '@/components/categories/CategorySupportSection.astro';
import Breadcrumb from '@/components/layout/Breadcrumb.astro';
import HreflangTags from '@/components/seo/HreflangTags.astro';
import StructuredData from '@/components/seo/StructuredData.astro';
import { categories, getToolsByCategory } from '@/config/tools';
import type { ToolCategory } from '@/config/tools';
import { getIconSvg } from '@/lib/icon-svg';
import { locales, getLocalizedPath } from '@/lib/i18n';
import type { Locale } from '@/lib/i18n';
import { loadBaseMessages } from '@/lib/translations';
import { getCategoryPageSeo } from '@/lib/seo';
import { getCategorySupportContent } from '@/lib/category-support';
import { buildHeaderTranslations, buildMobileNavMessages } from '@/lib/layout-translations';
import { getPublicSiteUrl } from '@/lib/public-env';

export const prerender = true;

export const getStaticPaths: GetStaticPaths = () => {
  const categoryIds: ToolCategory[] = [
    'text', 'encoding', 'generators', 'converters',
    'development', 'security', 'network', 'image',
    'math', 'charts', 'office', 'lifestyle',
    'finance', 'fun',
  ];

  return locales.flatMap((locale) =>
    categoryIds.map((category) => ({
      params: { locale, category },
      props: { locale, category },
    }))
  );
};

const { locale, category } = Astro.props as { locale: Locale; category: ToolCategory };

const baseMessages = await loadBaseMessages(locale);
const toolsObj = (baseMessages.tools as Record<string, unknown>) ?? {};
const categoryMessages = (baseMessages.categories as Record<string, string>) ?? {};
const navMessages = (baseMessages.nav as Record<string, string>) ?? {};
const siteMessages = (baseMessages.site as Record<string, string>) ?? {};
const headerTranslations = buildHeaderTranslations(baseMessages);
const mobileNavMessages = buildMobileNavMessages(navMessages);

const categoryName = categoryMessages[category] || category;
const categoryTools = getToolsByCategory(category);
const catConfig = categories.find(c => c.id === category);
const catIcon = catConfig?.icon || '<svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/></svg>';

function getToolName(slug: string): string {
  const t = toolsObj[slug] as Record<string, unknown> | undefined;
  return (t?.name as string) || slug;
}

function getToolDescription(slug: string): string {
  const t = toolsObj[slug] as Record<string, unknown> | undefined;
  return (t?.seo_description as string) || (t?.description as string) || '';
}

const BASE_URL = getPublicSiteUrl();
const categorySeo = getCategoryPageSeo(baseMessages, category, categoryName, categoryTools.length);
const pageTitle = categorySeo.title;
const pageDescription = categorySeo.description;
const categorySupport = getCategorySupportContent(locale, category);
const categoryToolNames = Object.fromEntries(categoryTools.map((tool) => [tool.slug, getToolName(tool.slug)]));
const categoryToolDescriptions = Object.fromEntries(categoryTools.map((tool) => [tool.slug, getToolDescription(tool.slug)]));

const breadcrumbItems = [
  { label: navMessages.home || 'Home', href: `/${locale}` },
  { label: categoryName, href: `/${locale}/categories/${category}` },
];

// BreadcrumbList structured data
const breadcrumbData = {
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    item: `${BASE_URL}${item.href}`,
  })),
};

// CollectionPage structured data
const collectionData = {
  name: categoryName,
  description: pageDescription,
  url: `${BASE_URL}/${locale}/categories/${category}`,
  numberOfItems: categoryTools.length,
  hasPart: categoryTools.slice(0, 10).map(tool => ({
    '@type': 'SoftwareApplication',
    name: getToolName(tool.slug),
    url: `${BASE_URL}/${locale}/tools/${tool.slug}`,
  })),
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  locale={locale}
  canonicalPath={`/categories/${category}`}
  siteDescription={siteMessages.description}
>
  <HreflangTags path={`/categories/${category}`} slot="head" />
  <StructuredData type="BreadcrumbList" data={breadcrumbData} slot="head" />
  <StructuredData type="CollectionPage" data={collectionData} slot="head" />

  <meta property="og:title" content={pageTitle} slot="head" />
  <meta property="og:description" content={pageDescription} slot="head" />
  <meta property="og:image" content={`${BASE_URL}/og-default.svg`} slot="head" />
  <meta property="og:type" content="website" slot="head" />
  <meta property="og:url" content={`${BASE_URL}/${locale}/categories/${category}`} slot="head" />
  <meta property="og:site_name" content="U2Tool" slot="head" />
  <meta name="twitter:card" content="summary_large_image" slot="head" />
  <meta name="twitter:title" content={pageTitle} slot="head" />
  <meta name="twitter:description" content={pageDescription} slot="head" />
  <meta name="twitter:image" content={`${BASE_URL}/og-default.svg`} slot="head" />

  <StaticSidebar
    locale={locale}
    categories={categories}
    categoryNames={categoryMessages}
    navMessages={navMessages}
    siteName={siteMessages.name || 'U2Tool'}
  />

  <div class="main-content-with-sidebar main-content-with-mobile-nav">
    <Header client:load locale={locale} translations={headerTranslations} />

    <main class="py-6 px-4 lg:px-6">
      <div class="max-w-none mx-0">
        <div class="mb-6">
          <Breadcrumb locale={locale} items={breadcrumbItems} />
        </div>

        <div class="mb-10">
          <h1 class="text-3xl font-bold text-slate-900 dark:text-white flex items-center gap-4 tracking-tight">
            <span class="text-blue-600 dark:text-amber-500 transition-transform hover:scale-110 duration-300" set:html={getIconSvg(catIcon, 32)} />
            <span>{categoryName}</span>
            <span class="text-lg font-medium text-slate-400 dark:text-slate-500 ml-1">({categoryTools.length})</span>
          </h1>
        </div>

        {categorySupport && (
          <CategorySupportSection
            content={categorySupport}
            locale={locale}
            toolNames={categoryToolNames}
            toolDescriptions={categoryToolDescriptions}
          />
        )}

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {categoryTools.map((tool) => (
            <a
              href={getLocalizedPath(locale, `/tools/${tool.slug}`)}
              class="group flex items-center gap-4 p-5 bg-white/40 dark:bg-slate-900/40
                     border border-slate-200/60 dark:border-slate-800 rounded-2xl
                     hover:shadow-2xl hover:border-blue-400/60 dark:hover:border-amber-500/50
                     backdrop-blur-md cursor-pointer transition-all duration-300"
            >
              <span class="text-blue-600 dark:text-amber-500 flex-shrink-0 transition-transform group-hover:scale-110 duration-300" set:html={getIconSvg(tool.icon, 24)} />
              <div class="flex-1 min-w-0">
                <h3 class="font-bold text-sm text-slate-900 dark:text-white truncate group-hover:text-blue-600 dark:group-hover:text-amber-400 transition-colors uppercase tracking-tight">
                  {getToolName(tool.slug)}
                </h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 truncate mt-1.5">
                  {getToolDescription(tool.slug)}
                </p>
              </div>
              {tool.popular && (
                <span class="inline-flex items-center px-2 py-0.5 text-[10px] font-bold rounded-full bg-amber-100 text-amber-600 dark:bg-amber-900/40 dark:text-amber-400 flex-shrink-0 border border-amber-200/50 dark:border-amber-500/30 shadow-[0_0_10px_rgba(245,158,11,0.2)]">HOT</span>
              )}
            </a>
          ))}
        </div>
      </div>
    </main>

    <Footer locale={locale} />
  </div>

  <MobileBottomNav client:load locale={locale} navMessages={mobileNavMessages} />
</BaseLayout>
