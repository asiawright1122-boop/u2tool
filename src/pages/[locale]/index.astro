---
/**
 * Homepage for each locale
 * Route: /{locale}/
 *
 * Matches the original Next.js design:
 * - Left sidebar navigation (desktop: 220px, tablet: 64px, mobile: hidden)
 * - Hero section with teal gradient card + recent tools sidebar
 * - Popular tools carousel with auto-rotation
 * - Mobile bottom navigation
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.svelte';
import Sidebar from '@/components/layout/Sidebar.svelte';
import MobileBottomNav from '@/components/layout/MobileBottomNav.svelte';
import Footer from '@/components/layout/Footer.astro';
import PopularToolsCarousel from '@/components/PopularToolsCarousel.svelte';
import HreflangTags from '@/components/seo/HreflangTags.astro';
import StructuredData from '@/components/seo/StructuredData.astro';
import { tools, categories, getPopularTools, getToolsByCategory } from '@/config/tools';
import { getIconSvg } from '@/lib/icon-svg';
import { locales, getLocalizedPath } from '@/lib/i18n';
import type { Locale } from '@/lib/i18n';
import { loadBaseMessages } from '@/lib/translations';

export const getStaticPaths: GetStaticPaths = () => {
  return locales.map((locale) => ({
    params: { locale },
    props: { locale },
  }));
};

const { locale } = Astro.props as { locale: Locale };
const baseMessages = await loadBaseMessages(locale);
const toolsObj = (baseMessages.tools as Record<string, unknown>) ?? {};
const categoryMessages = (baseMessages.categories as Record<string, string>) ?? {};
const navMessages = (baseMessages.nav as Record<string, string>) ?? {};
const homeMessages = (baseMessages.home as Record<string, unknown>) ?? {};
const heroMessages = (homeMessages.hero as Record<string, string>) ?? {};
const statsMessages = (homeMessages.stats as Record<string, string>) ?? {};
const siteMessages = (baseMessages.site as Record<string, string>) ?? {};

const popularTools = getPopularTools();
const recentTools = tools.slice(-4).reverse();
const basePath = `/${locale}`;

const BASE_URL = import.meta.env.PUBLIC_SITE_URL || 'https://www.u2tool.com';

function getToolName(slug: string): string {
  const t = toolsObj[slug] as Record<string, unknown> | undefined;
  return (t?.name as string) || slug;
}

function getToolDescription(slug: string): string {
  const t = toolsObj[slug] as Record<string, unknown> | undefined;
  return (t?.description as string) || '';
}

// Prepare carousel data with pre-resolved translations
const carouselTools = popularTools.map(tool => ({
  slug: tool.slug,
  icon: tool.icon,
  category: tool.category,
  name: getToolName(tool.slug),
  description: getToolDescription(tool.slug),
  categoryName: categoryMessages[tool.category] || tool.category,
}));
---

<BaseLayout
  title={`${heroMessages.title || 'Free Online Tools'} | U2Tool`}
  description={heroMessages.subtitle || '500+ free online tools for developers and everyone.'}
  locale={locale}
  canonicalPath="/"
>
  {/* SEO: Hreflang tags */}
  <HreflangTags path="/" slot="head" />

  {/* SEO: WebSite structured data with SearchAction */}
  <StructuredData type="WebSite" data={{
    name: 'U2Tool',
    url: BASE_URL,
    description: heroMessages.subtitle || '500+ free online tools for developers and everyone.',
    potentialAction: {
      '@type': 'SearchAction',
      target: `${BASE_URL}/${locale}/tools?q={search_term_string}`,
      'query-input': 'required name=search_term_string',
    },
  }} slot="head" />

  {/* SEO: Organization structured data */}
  <StructuredData type="Organization" data={{
    name: 'U2Tool',
    url: BASE_URL,
    logo: `${BASE_URL}/favicon.svg`,
    sameAs: [],
  }} slot="head" />

  {/* OG meta tags */}
  <meta property="og:title" content={`${heroMessages.title || 'Free Online Tools'} | U2Tool`} slot="head" />
  <meta property="og:description" content={heroMessages.subtitle || '500+ free online tools for developers and everyone.'} slot="head" />
  <meta property="og:image" content={`${BASE_URL}/og-default.svg`} slot="head" />
  <meta property="og:type" content="website" slot="head" />
  <meta property="og:url" content={`${BASE_URL}/${locale}`} slot="head" />
  <meta property="og:site_name" content="U2Tool" slot="head" />
  <meta name="twitter:card" content="summary_large_image" slot="head" />
  <meta name="twitter:title" content={`${heroMessages.title || 'Free Online Tools'} | U2Tool`} slot="head" />
  <meta name="twitter:description" content={heroMessages.subtitle || '500+ free online tools for developers and everyone.'} slot="head" />
  <meta name="twitter:image" content={`${BASE_URL}/og-default.svg`} slot="head" />
  <!-- Sidebar - Desktop (expanded) -->
  <aside class="hidden lg:block fixed left-0 top-0 bottom-0 z-40" style="width: 220px">
    <Sidebar
      client:load
      locale={locale}
      categories={categories}
      categoryNames={categoryMessages}
      navMessages={navMessages}
      siteName={siteMessages.name || 'U2Tool'}
    />
  </aside>

  <!-- Sidebar - Tablet (collapsed, icons only) -->
  <aside class="hidden md:block lg:hidden fixed left-0 top-0 bottom-0 z-40" style="width: 64px">
    <Sidebar
      client:load
      locale={locale}
      categories={categories}
      categoryNames={categoryMessages}
      navMessages={navMessages}
      siteName={siteMessages.name || 'U2Tool'}
    />
  </aside>

  <!-- Main content area with responsive left margin -->
  <div class="main-content-with-sidebar main-content-with-mobile-nav">
    <Header client:load locale={locale} />

    <main class="py-6 px-4">
      <div class="max-w-5xl mx-auto">

        <!-- Hero Section - Two column layout -->
        <section class="mb-8">
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 items-stretch">
            <!-- Left: Hero card with teal gradient -->
            <div class="lg:col-span-2 relative overflow-hidden rounded-2xl
                        bg-gradient-to-br from-cyan-700 via-cyan-800 to-slate-800
                        dark:from-cyan-900 dark:via-slate-900 dark:to-slate-950
                        p-10 flex flex-col justify-center min-h-[280px]">
              <!-- Background decorations -->
              <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-cyan-500/20 via-cyan-600/10 to-transparent"></div>
              <div class="absolute top-0 right-0 w-80 h-80 bg-cyan-500/10 rounded-full blur-3xl -translate-y-1/3 translate-x-1/4"></div>
              <div class="absolute bottom-0 left-0 w-64 h-64 bg-slate-500/10 rounded-full blur-3xl translate-y-1/3 -translate-x-1/4"></div>

              <div class="relative z-10 text-center">
                <h1 class="text-4xl md:text-5xl font-bold text-white mb-5 leading-tight">
                  {heroMessages.title || 'Free Online Tools'}
                </h1>
                <p class="text-lg text-cyan-100 dark:text-gray-300 mb-10 max-w-xl mx-auto leading-relaxed">
                  {heroMessages.subtitle || 'Boost your productivity with our collection of free developer tools.'}
                </p>

                <!-- Stats -->
                <div class="flex justify-center gap-12 md:gap-16">
                  <div class="text-center">
                    <div class="text-4xl md:text-5xl font-bold text-white mb-2">{tools.length}+</div>
                    <div class="text-sm text-cyan-200 dark:text-gray-400">{statsMessages.tools || 'Free Tools'}</div>
                  </div>
                  <div class="text-center">
                    <div class="text-4xl md:text-5xl font-bold text-white mb-2">{statsMessages.usageValue || '100K+'}</div>
                    <div class="text-sm text-cyan-200 dark:text-gray-400">{statsMessages.usageCount || 'Usage Count'}</div>
                  </div>
                  <div class="text-center">
                    <div class="text-4xl md:text-5xl font-bold text-white mb-2">100%</div>
                    <div class="text-sm text-cyan-200 dark:text-gray-400">{statsMessages.free || 'Free Forever'}</div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Right: Recent tools card -->
            <div class="lg:col-span-1 bg-white dark:bg-gray-800 rounded-2xl p-5 border border-gray-200 dark:border-gray-700 flex flex-col">
              <h3 class="text-sm font-semibold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
                <span class="text-green-500 text-base">+</span>
                {(homeMessages.recentTools as string) || 'Recent Tools'}
              </h3>
              <div class="flex-1 space-y-1">
                {recentTools.map((tool) => (
                  <a
                    href={getLocalizedPath(locale, `/tools/${tool.slug}`)}
                    class="flex items-start gap-3 p-3 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors group"
                  >
                    <span class="text-xl flex-shrink-0 text-blue-500 dark:text-blue-400" set:html={getIconSvg(tool.icon, 20)} />
                    <div class="flex-1 min-w-0">
                      <h4 class="text-sm font-medium text-gray-900 dark:text-white truncate group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                        {getToolName(tool.slug)}
                      </h4>
                      <p class="text-xs text-gray-500 dark:text-gray-400 line-clamp-2 mt-0.5">
                        {getToolDescription(tool.slug)}
                      </p>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </section>

        <!-- Popular Tools Carousel -->
        <section class="mb-10">
          <div class="flex items-center justify-between mb-6">
            <div>
              <h2 class="text-xl md:text-2xl font-bold text-gray-900 dark:text-white">
                {(homeMessages.popular as string) || 'Popular Tools'}
              </h2>
              <p class="text-gray-500 dark:text-gray-400 text-sm mt-1">
                {(homeMessages.popularDesc as string) || 'Most used tools by our community'}
              </p>
            </div>
          </div>

          <PopularToolsCarousel
            client:visible
            tools={carouselTools}
            displayCount={12}
            rotateInterval={10000}
            basePath={basePath}
          />
        </section>

        <!-- All Tools by Category -->
        {categories.map((cat) => {
          const catTools = getToolsByCategory(cat.id);
          if (catTools.length === 0) return null;
          return (
            <section class="mb-8 content-auto">
              <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-3 flex items-center gap-2">
                <span class="text-blue-500 dark:text-blue-400" set:html={getIconSvg(cat.icon, 20)} />
                <span>{categoryMessages[cat.id] || cat.id}</span>
                <span class="text-sm font-normal text-gray-400 dark:text-gray-500">({catTools.length})</span>
              </h2>
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
                {catTools.map((tool) => (
                  <a
                    href={getLocalizedPath(locale, `/tools/${tool.slug}`)}
                    class="group flex items-center gap-3 p-3 bg-white dark:bg-gray-800/60
                           border border-gray-100 dark:border-gray-700/40 rounded-xl
                           hover:border-blue-400/60 dark:hover:border-blue-500/40
                           hover:bg-blue-50/50 dark:hover:bg-blue-900/10
                           cursor-pointer transition-all duration-200"
                  >
                    <span class="text-2xl flex-shrink-0 text-blue-500 dark:text-blue-400" set:html={getIconSvg(tool.icon, 22)} />
                    <div class="flex-1 min-w-0">
                      <h3 class="font-medium text-sm text-gray-900 dark:text-white truncate group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                        {getToolName(tool.slug)}
                      </h3>
                      <p class="text-xs text-gray-500 dark:text-gray-400 truncate mt-0.5">
                        {getToolDescription(tool.slug)}
                      </p>
                    </div>
                    {tool.popular && (
                      <span class="inline-flex items-center px-1.5 py-0.5 text-[10px] font-medium rounded-full bg-orange-100 text-orange-600 dark:bg-orange-900/30 dark:text-orange-400 flex-shrink-0">HOT</span>
                    )}
                  </a>
                ))}
              </div>
            </section>
          );
        })}

      </div>
    </main>

    <Footer locale={locale} />
  </div>

  <!-- Mobile Bottom Navigation -->
  <MobileBottomNav client:load locale={locale} navMessages={navMessages} />
</BaseLayout>
