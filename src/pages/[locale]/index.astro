---
/**
 * Homepage for each locale
 * Route: /{locale}/
 *
 * Matches the original Next.js design:
 * - Left sidebar navigation (desktop: 220px, tablet: 64px, mobile: hidden)
 * - Hero section with teal gradient card + recent tools sidebar
 * - Popular tools carousel with auto-rotation
 * - Mobile bottom navigation
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.svelte';
import StaticSidebar from '@/components/layout/StaticSidebar.astro';
import MobileBottomNav from '@/components/layout/MobileBottomNav.svelte';
import Footer from '@/components/layout/Footer.astro';
import PopularToolsCarousel from '@/components/PopularToolsCarousel.svelte';
import CategorySpotlightSection from '@/components/discovery/CategorySpotlightSection.astro';
import ComparisonGuideSection from '@/components/discovery/ComparisonGuideSection.astro';
import HreflangTags from '@/components/seo/HreflangTags.astro';
import StructuredData from '@/components/seo/StructuredData.astro';
import { tools, categories, getPopularTools } from '@/config/tools';
import { getIconSvg } from '@/lib/icon-svg';
import { locales, getLocalizedPath, isValidLocale } from '@/lib/i18n';
import type { Locale } from '@/lib/i18n';
import { loadBaseMessages } from '@/lib/translations';
import { buildCategoryDiscoveryItemList, buildCategoryDiscoverySpotlights } from '@/lib/discovery-surface';
import { buildComparisonGuides, getComparisonUiCopy } from '@/lib/comparison-surfaces';
import { buildHeaderTranslations, buildMobileNavMessages } from '@/lib/layout-translations';
import { getPublicSiteUrl } from '@/lib/public-env';
import { buildLocalizedPageUrl, getHomePageSeo } from '@/lib/seo';

export const prerender = false;

export const getStaticPaths: GetStaticPaths = () => {
  return locales.map((locale) => ({
    params: { locale },
    props: { locale },
  }));
};

const localeCandidate = Astro.params.locale ?? (Astro.props as { locale?: Locale }).locale;
if (typeof localeCandidate !== 'string' || !isValidLocale(localeCandidate)) {
  return Astro.redirect('/en/', 302);
}
const locale: Locale = localeCandidate;
const baseMessages = await loadBaseMessages(locale);
const toolsObj = (baseMessages.tools as Record<string, unknown>) ?? {};
const categoryMessages = (baseMessages.categories as Record<string, string>) ?? {};
const navMessages = (baseMessages.nav as Record<string, string>) ?? {};
const homeMessages = (baseMessages.home as Record<string, unknown>) ?? {};
const heroMessages = (homeMessages.hero as Record<string, string>) ?? {};
const statsMessages = (homeMessages.stats as Record<string, string>) ?? {};
const aboutMessages = (baseMessages.about as Record<string, unknown>) ?? {};
const aboutStatsMessages = (aboutMessages.stats as Record<string, string>) ?? {};
const siteMessages = (baseMessages.site as Record<string, string>) ?? {};
const headerTranslations = buildHeaderTranslations(baseMessages);
const mobileNavMessages = buildMobileNavMessages(navMessages);
const homePageSeo = getHomePageSeo(baseMessages, tools.length);

const popularTools = getPopularTools();
const recentTools = tools.slice(-4).reverse();
const basePath = `/${locale}`;

const BASE_URL = getPublicSiteUrl();

function getToolName(slug: string): string {
  const t = toolsObj[slug] as Record<string, unknown> | undefined;
  return (t?.name as string) || slug;
}

function getToolDescription(slug: string): string {
  const t = toolsObj[slug] as Record<string, unknown> | undefined;
  return (t?.seo_description as string) || (t?.description as string) || '';
}

// Prepare carousel data with pre-resolved translations
const carouselTools = popularTools.map(tool => ({
  slug: tool.slug,
  icon: tool.icon,
  category: tool.category,
  name: getToolName(tool.slug),
  description: getToolDescription(tool.slug),
  categoryName: categoryMessages[tool.category] || tool.category,
}));
const toolNames = Object.fromEntries(
  tools.map((tool) => [tool.slug, getToolName(tool.slug)])
);
const toolDescriptions = Object.fromEntries(
  tools.map((tool) => [tool.slug, getToolDescription(tool.slug)])
);
const discoverySpotlights = buildCategoryDiscoverySpotlights(
  locale,
  categoryMessages,
  toolNames,
  toolDescriptions
);
const discoveryItemListData = buildCategoryDiscoveryItemList(BASE_URL, discoverySpotlights);
const toolsMessages = (baseMessages.tools as Record<string, string>) ?? {};
const comparisonUiCopy = getComparisonUiCopy(locale);
const comparisonGuides = buildComparisonGuides(
  locale,
  categoryMessages,
  toolNames,
  toolDescriptions
).slice(0, 3);
---

<BaseLayout
  title={homePageSeo.title}
  description={homePageSeo.description}
  locale={locale}
  canonicalPath="/"
  siteDescription={siteMessages.description}
>
  {/* SEO: Hreflang tags */}
  <HreflangTags path="/" slot="head" />
  <StructuredData type="ItemList" data={discoveryItemListData} slot="head" />

  {/* OG meta tags */}
  <meta property="og:title" content={homePageSeo.title} slot="head" />
  <meta property="og:description" content={homePageSeo.description} slot="head" />
  <meta property="og:image" content={`${BASE_URL}/og-default.svg`} slot="head" />
  <meta property="og:type" content="website" slot="head" />
  <meta property="og:url" content={buildLocalizedPageUrl(BASE_URL, locale, '/')} slot="head" />
  <meta property="og:site_name" content="U2Tool" slot="head" />
  <meta name="twitter:card" content="summary_large_image" slot="head" />
  <meta name="twitter:title" content={homePageSeo.title} slot="head" />
  <meta name="twitter:description" content={homePageSeo.description} slot="head" />
  <meta name="twitter:image" content={`${BASE_URL}/og-default.svg`} slot="head" />
  <StaticSidebar
    locale={locale}
    categories={categories}
    categoryNames={categoryMessages}
    navMessages={navMessages}
    siteName={siteMessages.name || 'U2Tool'}
  />

  <!-- Main content area with responsive left margin -->
  <div class="main-content-with-sidebar main-content-with-mobile-nav">
    <Header client:load locale={locale} translations={headerTranslations} />

    <main class="py-6 px-4 lg:px-6">
      <div class="max-w-none mx-0">

        <!-- Hero Section - Two column layout -->
        <section class="mb-8">
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 items-stretch">
            <!-- Left: Hero card with Adaptive Premium Glass gradient -->
            <div class="lg:col-span-2 relative overflow-hidden rounded-3xl
                        glass shadow-2xl
                        dark:border-white/10 dark:bg-slate-900/40
                        p-10 flex flex-col justify-center min-h-[320px]">
              <!-- Background decorations -->
              <div class="absolute inset-0 bg-gradient-to-br from-blue-500/5 to-amber-500/5 dark:from-amber-600/15 dark:to-transparent pointer-events-none"></div>
              <div class="absolute top-0 right-0 w-80 h-80 bg-blue-500/10 dark:bg-amber-500/20 rounded-full blur-3xl -translate-y-1/3 translate-x-1/4"></div>
              <div class="absolute bottom-0 left-0 w-64 h-64 bg-amber-400/20 dark:bg-amber-900/15 rounded-full blur-3xl translate-y-1/3 -translate-x-1/4"></div>

              <div class="relative z-10 text-center">
                <h1 class="text-4xl md:text-5xl font-bold text-slate-900 dark:text-white mb-5 leading-tight tracking-tight drop-shadow-sm dark:drop-shadow-[0_4px_10px_rgba(0,0,0,0.6)]">
                  {heroMessages.title || 'Free Online Tools'}
                </h1>
                <p class="text-lg text-slate-600 dark:text-slate-300 mb-10 max-w-xl mx-auto leading-relaxed">
                  {heroMessages.subtitle || 'Boost your productivity with our collection of free developer tools.'}
                </p>

                <!-- Stats -->
                <div class="flex justify-center gap-10 md:gap-16">
                  <div class="text-center group/stat cursor-default">
                    <div class="text-4xl md:text-5xl font-black text-slate-800 dark:text-amber-500 mb-2 drop-shadow-sm dark:drop-shadow-[0_0_15px_rgba(245,158,11,0.4)] transition-all duration-500 group-hover/stat:scale-110 group-hover/stat:drop-shadow-[0_0_20px_rgba(245,158,11,0.6)]">
                      {tools.length}+
                    </div>
                    <div class="text-[10px] text-slate-500 dark:text-slate-400 font-black tracking-[0.2em] uppercase opacity-70 group-hover/stat:opacity-100 transition-opacity">
                      {statsMessages.tools || 'Free Tools'}
                    </div>
                  </div>
                  <div class="text-center group/stat cursor-default">
                    <div class="text-4xl md:text-5xl font-black text-slate-800 dark:text-amber-500 mb-2 drop-shadow-sm dark:drop-shadow-[0_0_15px_rgba(245,158,11,0.4)] transition-all duration-500 group-hover/stat:scale-110 group-hover/stat:drop-shadow-[0_0_20px_rgba(245,158,11,0.6)]">
                      {locales.length}
                    </div>
                    <div class="text-[10px] text-slate-500 dark:text-slate-400 font-black tracking-[0.2em] uppercase opacity-70 group-hover/stat:opacity-100 transition-opacity">
                      {aboutStatsMessages.languages || 'Languages'}
                    </div>
                  </div>
                  <div class="text-center group/stat cursor-default">
                    <div class="text-4xl md:text-5xl font-black text-slate-800 dark:text-amber-500 mb-2 drop-shadow-sm dark:drop-shadow-[0_0_15px_rgba(245,158,11,0.4)] transition-all duration-500 group-hover/stat:scale-110 group-hover/stat:drop-shadow-[0_0_20px_rgba(245,158,11,0.6)]">
                      100%
                    </div>
                    <div class="text-[10px] text-slate-500 dark:text-slate-400 font-black tracking-[0.2em] uppercase opacity-70 group-hover/stat:opacity-100 transition-opacity">
                      {statsMessages.free || 'Free Forever'}
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Right: Recent tools card -->
            <div class="lg:col-span-1 glass-card p-6 flex flex-col relative overflow-hidden group">
              <div class="absolute inset-0 bg-gradient-to-br from-transparent to-amber-500/5 dark:to-amber-500/10 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
              <div class="relative z-10">
                <h3 class="text-sm font-bold text-slate-900 dark:text-white mb-6 flex items-center gap-2 uppercase tracking-widest">
                  <span class="text-amber-500 drop-shadow-[0_0_8px_rgba(245,158,11,0.5)]" set:html={getIconSvg('history', 18)} />
                  {(homeMessages.recentTools as string) || 'Recent Tools'}
                </h3>
                <div class="flex-1 space-y-2">
                  {recentTools.map((tool) => (
                    <a
                      href={getLocalizedPath(locale, `/tools/${tool.slug}`)}
                      class="flex items-center gap-4 p-3.5 rounded-2xl hover:bg-white/60 dark:hover:bg-white/5 transition-all duration-300 group/item border border-transparent hover:border-slate-200 dark:hover:border-white/5 active:scale-95"
                    >
                      <span class="text-slate-400 dark:text-slate-500 flex-shrink-0 transition-all duration-500 group-hover/item:text-amber-500 group-hover/item:scale-110" set:html={getIconSvg(tool.icon, 22)} />
                      <div class="flex-1 min-w-0">
                        <h4 class="text-sm font-bold text-slate-900 dark:text-white truncate group-hover/item:text-amber-600 dark:group-hover/item:text-amber-400 transition-colors">
                          {getToolName(tool.slug)}
                        </h4>
                        <p class="text-[11px] text-slate-500 dark:text-slate-400 line-clamp-1 mt-1 leading-relaxed">
                          {getToolDescription(tool.slug)}
                        </p>
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </section>

        <CategorySpotlightSection
          eyebrow={siteMessages.name || 'U2Tool'}
          title={(homeMessages.categories as string) || 'Tool Categories'}
          description={(homeMessages.categoriesDesc as string) || 'Find the right tool for your needs'}
          popularLabel={(toolsMessages.popular || 'Popular').toUpperCase()}
          toolsCountLabel={(homeMessages.toolsCount as string) || 'tools'}
          spotlights={discoverySpotlights}
        />

        <ComparisonGuideSection
          title={comparisonUiCopy.comparisonSectionTitle}
          description={comparisonUiCopy.comparisonSectionDescription}
          guides={comparisonGuides}
          ctaLabel={comparisonUiCopy.guideCtaLabel}
          includedToolsLabel={comparisonUiCopy.includedToolsLabel}
        />

        <!-- Popular Tools Carousel -->
        <section class="mb-10">
          <div class="flex items-center justify-between mb-8">
            <div>
              <h2 class="text-2xl md:text-3xl font-bold text-slate-900 dark:text-white tracking-tight flex items-center gap-3">
                <span class="w-1 h-8 bg-amber-500 rounded-full dark:shadow-[0_0_12px_rgba(245,158,11,0.6)]"></span>
                {(homeMessages.popular as string) || 'Popular Tools'}
              </h2>
              <p class="text-slate-500 dark:text-slate-400 text-sm mt-2 font-medium">
                {(homeMessages.popularDesc as string) || 'Most used tools by our community'}
              </p>
            </div>
          </div>

          <PopularToolsCarousel
            client:visible
            tools={carouselTools}
            displayCount={12}
            rotateInterval={10000}
            basePath={basePath}
          />
        </section>
      </div>
    </main>

    <Footer locale={locale} />
  </div>

  <!-- Mobile Bottom Navigation -->
  <MobileBottomNav client:load locale={locale} navMessages={mobileNavMessages} />
</BaseLayout>
