---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.svelte';
import StaticSidebar from '@/components/layout/StaticSidebar.astro';
import MobileBottomNav from '@/components/layout/MobileBottomNav.svelte';
import Footer from '@/components/layout/Footer.astro';
import Breadcrumb from '@/components/layout/Breadcrumb.astro';
import HreflangTags from '@/components/seo/HreflangTags.astro';
import StructuredData from '@/components/seo/StructuredData.astro';
import { getIconSvg } from '@/lib/icon-svg';
import { categories, tools } from '@/config/tools';
import { isValidLocale } from '@/lib/i18n';
import type { Locale } from '@/lib/i18n';
import { loadBaseUiMessages } from '@/lib/translations';
import { buildHeaderTranslations, buildMobileNavMessages } from '@/lib/layout-translations';
import { getPublicSiteUrl } from '@/lib/public-env';
import { buildLocalizedPagePath, buildLocalizedPageUrl, resolveMetaDescription } from '@/lib/seo';
import {
  buildAiToolTopic,
  buildAiToolTopicCollectionData,
  buildAiToolTopicItemList,
  buildAiToolTopics,
  getAiToolTopicUiCopy,
  isAiToolTopicSlug,
} from '@/lib/ai-tool-topics';
import { getAiToolsDirectoryCopy } from '@/lib/ai-tools-directory';
import { AI_TOOLS_DIRECTORY_PATH, getAiToolsDirectoryLabel } from '@/lib/ai-tools-navigation';

export const prerender = false;

const localeCandidate = Astro.params.locale;
if (typeof localeCandidate !== 'string' || !isValidLocale(localeCandidate)) {
  return Astro.redirect('/en/ai/', 302);
}
const locale: Locale = localeCandidate;

const topicCandidate = Astro.params.topic;
if (typeof topicCandidate !== 'string' || !isAiToolTopicSlug(topicCandidate)) {
  return Astro.redirect(buildLocalizedPagePath(locale, AI_TOOLS_DIRECTORY_PATH), 302);
}

const baseMessages = await loadBaseUiMessages(locale, Astro.url);
const toolsObj = (baseMessages.tools as Record<string, unknown>) ?? {};
const categoryMessages = (baseMessages.categories as Record<string, string>) ?? {};
const navMessages = (baseMessages.nav as Record<string, string>) ?? {};
const siteMessages = (baseMessages.site as Record<string, string>) ?? {};
const headerTranslations = buildHeaderTranslations(baseMessages);
const mobileNavMessages = buildMobileNavMessages(navMessages);
const BASE_URL = getPublicSiteUrl();
const aiDirectoryCopy = getAiToolsDirectoryCopy(locale);
const aiDirectoryLabel = getAiToolsDirectoryLabel(locale);
const topicUiCopy = getAiToolTopicUiCopy(locale);

const toolNames = Object.fromEntries(
  tools.map((tool) => {
    const toolMessage = toolsObj[tool.slug] as Record<string, unknown> | undefined;
    return [tool.slug, (toolMessage?.name as string) || tool.slug];
  })
);
const toolDescriptions = Object.fromEntries(
  tools.map((tool) => {
    const toolMessage = toolsObj[tool.slug] as Record<string, unknown> | undefined;
    return [
      tool.slug,
      (toolMessage?.seo_description as string) || (toolMessage?.description as string) || '',
    ];
  })
);

const topic = buildAiToolTopic(locale, topicCandidate, categoryMessages, toolNames, toolDescriptions);
const relatedTopics = buildAiToolTopics(locale, categoryMessages, toolNames, toolDescriptions)
  .filter((candidate) => candidate.slug !== topic.slug);
const pageDescription = resolveMetaDescription({
  description: topic.seoDescription,
  locale,
  title: topic.seoTitle,
});
const breadcrumbItems = [
  { label: navMessages.home || 'Home', href: buildLocalizedPagePath(locale, '/') },
  { label: aiDirectoryLabel, href: buildLocalizedPagePath(locale, AI_TOOLS_DIRECTORY_PATH) },
  { label: topic.h1, href: buildLocalizedPagePath(locale, topic.path) },
];
const breadcrumbData = {
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    item: `${BASE_URL}${item.href}`,
  })),
};
const itemListData = buildAiToolTopicItemList(BASE_URL, topic);
const collectionData = buildAiToolTopicCollectionData(BASE_URL, locale, topic);
const canonicalPath = topic.path;
const modelComparisonHref = aiDirectoryCopy.modelComparisonIndex.href;
---

<BaseLayout
  title={`${topic.seoTitle} | U2Tool`}
  description={pageDescription}
  locale={locale}
  canonicalPath={canonicalPath}
  siteDescription={siteMessages.description}
>
  <HreflangTags path={canonicalPath} slot="head" />
  <StructuredData type="BreadcrumbList" data={breadcrumbData} slot="head" />
  <StructuredData type="CollectionPage" data={collectionData} slot="head" />
  <StructuredData type="ItemList" data={itemListData} slot="head" />

  <meta property="og:title" content={`${topic.seoTitle} | U2Tool`} slot="head" />
  <meta property="og:description" content={pageDescription} slot="head" />
  <meta property="og:image" content={`${BASE_URL}/og-default.svg`} slot="head" />
  <meta property="og:type" content="website" slot="head" />
  <meta property="og:url" content={buildLocalizedPageUrl(BASE_URL, locale, canonicalPath)} slot="head" />
  <meta property="og:site_name" content="U2Tool" slot="head" />
  <meta name="twitter:card" content="summary_large_image" slot="head" />
  <meta name="twitter:title" content={`${topic.seoTitle} | U2Tool`} slot="head" />
  <meta name="twitter:description" content={pageDescription} slot="head" />
  <meta name="twitter:image" content={`${BASE_URL}/og-default.svg`} slot="head" />

  <StaticSidebar
    locale={locale}
    categories={categories}
    categoryNames={categoryMessages}
    navMessages={navMessages}
    siteName={siteMessages.name || 'U2Tool'}
  />

  <div class="main-content-with-sidebar main-content-with-mobile-nav">
    <Header client:load locale={locale} translations={headerTranslations} />

    <main class="py-6 px-4 lg:px-6">
      <div class="max-w-none mx-0">
        <div class="mb-6">
          <Breadcrumb locale={locale} items={breadcrumbItems} />
        </div>

        <section class="mb-10 rounded-3xl border border-slate-200/60 glass p-8 shadow-2xl backdrop-blur-xl dark:border-white/10 dark:bg-slate-900/40">
          <div class="grid gap-8 xl:grid-cols-[minmax(0,1fr)_360px] xl:items-end">
            <div>
              <p class="mb-3 text-[10px] font-black uppercase tracking-[0.3em] text-sky-600/80 dark:text-sky-400/70">
                {topicUiCopy.eyebrow}
              </p>
              <h1 class="max-w-4xl text-4xl font-black tracking-tight text-slate-900 drop-shadow-sm dark:text-white md:text-5xl">
                {topic.h1}
              </h1>
              <p class="mt-4 max-w-4xl text-sm font-medium leading-7 text-slate-500 dark:text-slate-400">
                {pageDescription}
              </p>
              <p class="mt-4 max-w-4xl text-sm leading-7 text-slate-600 dark:text-slate-300">
                {topic.intro}
              </p>
              <div class="mt-6 flex flex-wrap gap-3">
                <a
                  href={buildLocalizedPagePath(locale, AI_TOOLS_DIRECTORY_PATH)}
                  class="inline-flex items-center justify-center rounded-2xl bg-slate-950 px-5 py-3 text-xs font-black uppercase tracking-[0.16em] text-white transition hover:bg-black dark:bg-sky-400 dark:text-slate-950 dark:hover:bg-sky-300"
                >
                  {topicUiCopy.directoryCta}
                </a>
                <a
                  href={modelComparisonHref}
                  class="inline-flex items-center justify-center rounded-2xl border border-slate-300 bg-white/70 px-5 py-3 text-xs font-black uppercase tracking-[0.16em] text-slate-700 transition hover:border-sky-400 hover:text-sky-700 dark:border-white/10 dark:bg-white/5 dark:text-slate-200 dark:hover:border-sky-400 dark:hover:text-sky-300"
                >
                  {topicUiCopy.modelCostCta}
                </a>
              </div>
            </div>
            <div class="grid gap-3 sm:grid-cols-3 xl:grid-cols-1">
              <div class="rounded-2xl border border-slate-200/60 bg-white/55 p-4 dark:border-white/10 dark:bg-white/[0.04]">
                <div class="text-3xl font-black text-slate-900 dark:text-white">{topic.tools.length}</div>
                <div class="mt-1 text-[10px] font-black uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">{topicUiCopy.toolCountLabel}</div>
              </div>
              <div class="rounded-2xl border border-slate-200/60 bg-white/55 p-4 dark:border-white/10 dark:bg-white/[0.04]">
                <div class="inline-flex text-sky-600 dark:text-sky-300" set:html={getIconSvg(topic.icon, 32)} />
                <div class="mt-2 text-[10px] font-black uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">{topicUiCopy.workflowTitle}</div>
              </div>
              <div class="rounded-2xl border border-slate-200/60 bg-white/55 p-4 dark:border-white/10 dark:bg-white/[0.04]">
                <div class="text-3xl font-black text-slate-900 dark:text-white">{relatedTopics.length}</div>
                <div class="mt-1 text-[10px] font-black uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">{topicUiCopy.relatedTopicsTitle}</div>
              </div>
            </div>
          </div>
        </section>

        <section class="mb-10" aria-labelledby="ai-topic-tools-heading">
          <div class="mb-6 max-w-4xl">
            <h2 id="ai-topic-tools-heading" class="flex items-center gap-3 text-2xl font-black tracking-tight text-slate-900 dark:text-white md:text-3xl">
              <span class="h-8 w-1 rounded-full bg-sky-500 dark:shadow-[0_0_12px_rgba(14,165,233,0.55)]"></span>
              {topicUiCopy.toolsTitle}
            </h2>
            <p class="mt-3 text-sm font-medium leading-7 text-slate-500 dark:text-slate-400">
              {topic.seoDescription}
            </p>
          </div>

          <div class="grid gap-4 lg:grid-cols-2 xl:grid-cols-3">
            {topic.tools.map((tool) => (
              <a
                href={tool.href}
                data-ai-topic-tool={tool.slug}
                class="glass-card group/tool flex min-h-[180px] flex-col p-6 transition hover:border-sky-300 dark:hover:border-sky-400/50"
              >
                <div class="mb-4 flex items-start justify-between gap-4">
                  <span
                    class="inline-flex text-slate-400 transition group-hover/tool:text-sky-500 dark:text-slate-500 dark:group-hover/tool:text-sky-300"
                    set:html={getIconSvg(tool.icon, 24)}
                  />
                  <span class="rounded-xl border border-slate-200 bg-white/65 px-2.5 py-1 text-[9px] font-black uppercase tracking-[0.12em] text-slate-500 dark:border-white/10 dark:bg-white/5 dark:text-slate-300">
                    {tool.categoryName}
                  </span>
                </div>
                <h3 class="text-lg font-black tracking-tight text-slate-900 transition group-hover/tool:text-sky-700 dark:text-white dark:group-hover/tool:text-sky-200">
                  {tool.name}
                </h3>
                <p class="mt-3 line-clamp-3 text-sm font-medium leading-7 text-slate-500 dark:text-slate-400">
                  {tool.description || tool.categoryName}
                </p>
                <span class="mt-auto pt-5 text-[10px] font-black uppercase tracking-[0.18em] text-sky-600 dark:text-sky-300">
                  {topicUiCopy.openToolLabel}
                </span>
              </a>
            ))}
          </div>
        </section>

        <section class="mb-10 rounded-2xl border border-slate-200/70 bg-white/75 p-5 dark:border-white/10 dark:bg-white/5">
          <div class="mb-4 flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
            <div>
              <h2 class="text-base font-black tracking-tight text-slate-900 dark:text-white">
                {topicUiCopy.workflowTitle}
              </h2>
              <p class="mt-2 text-sm font-medium leading-7 text-slate-500 dark:text-slate-400">
                {topic.intro}
              </p>
            </div>
          </div>
          <ol class="grid gap-3 lg:grid-cols-3">
            {topic.tools.slice(0, 3).map((tool, index) => (
              <li class="rounded-xl border border-slate-200 bg-white/70 p-4 dark:border-white/10 dark:bg-slate-950/25">
                <div class="mb-2 text-[10px] font-black uppercase tracking-[0.18em] text-sky-600 dark:text-sky-300">
                  {index + 1}
                </div>
                <h3 class="text-sm font-black text-slate-900 dark:text-white">{tool.name}</h3>
                <p class="mt-2 line-clamp-2 text-xs font-medium leading-6 text-slate-500 dark:text-slate-400">
                  {tool.description || tool.categoryName}
                </p>
              </li>
            ))}
          </ol>
        </section>

        <section class="mb-10" aria-labelledby="related-ai-topic-heading">
          <div class="mb-5 max-w-4xl">
            <h2 id="related-ai-topic-heading" class="text-xl font-black tracking-tight text-slate-900 dark:text-white">
              {topicUiCopy.relatedTopicsTitle}
            </h2>
            <p class="mt-2 text-sm font-medium leading-7 text-slate-500 dark:text-slate-400">
              {aiDirectoryCopy.description}
            </p>
          </div>
          <div class="grid gap-4 lg:grid-cols-2">
            {relatedTopics.map((relatedTopic) => (
              <a
                href={relatedTopic.href}
                data-related-ai-topic={relatedTopic.slug}
                class="rounded-2xl border border-slate-200/70 bg-white/75 p-5 transition hover:border-sky-300 hover:bg-sky-50/70 dark:border-white/10 dark:bg-white/5 dark:hover:border-sky-400/60 dark:hover:bg-sky-950/20"
              >
                <div class="flex items-start justify-between gap-3">
                  <h3 class="text-base font-black tracking-tight text-slate-900 dark:text-white">
                    {relatedTopic.h1}
                  </h3>
                  <span class="shrink-0 rounded-lg bg-slate-100 px-2 py-0.5 text-[9px] font-black uppercase tracking-[0.12em] text-slate-500 dark:bg-white/10 dark:text-slate-300">
                    {relatedTopic.tools.length} {topicUiCopy.toolCountLabel}
                  </span>
                </div>
                <p class="mt-2 line-clamp-2 text-xs font-medium leading-6 text-slate-500 dark:text-slate-400">
                  {relatedTopic.seoDescription}
                </p>
              </a>
            ))}
          </div>
        </section>
      </div>
    </main>

    <Footer locale={locale} />
  </div>

  <MobileBottomNav client:load locale={locale} navMessages={mobileNavMessages} />
</BaseLayout>
