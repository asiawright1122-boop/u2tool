---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.svelte';
import StaticSidebar from '@/components/layout/StaticSidebar.astro';
import MobileBottomNav from '@/components/layout/MobileBottomNav.svelte';
import Footer from '@/components/layout/Footer.astro';
import Breadcrumb from '@/components/layout/Breadcrumb.astro';
import HreflangTags from '@/components/seo/HreflangTags.astro';
import StructuredData from '@/components/seo/StructuredData.astro';
import { categories, tools } from '@/config/tools';
import { locales } from '@/lib/i18n';
import type { Locale } from '@/lib/i18n';
import {
  comparisonSurfaceSlugs,
  getComparisonGuide,
  getComparisonUiCopy,
} from '@/lib/comparison-surfaces';
import { loadBaseMessages } from '@/lib/translations';
import { buildHeaderTranslations, buildMobileNavMessages } from '@/lib/layout-translations';
import { getPublicSiteUrl } from '@/lib/public-env';

export const prerender = true;

export const getStaticPaths: GetStaticPaths = () =>
  locales.flatMap((locale) =>
    comparisonSurfaceSlugs.map((slug) => ({
      params: { locale, slug },
      props: { locale, slug },
    }))
  );

const { locale, slug } = Astro.props as { locale: Locale; slug: string };
const baseMessages = await loadBaseMessages(locale);
const toolsObj = (baseMessages.tools as Record<string, unknown>) ?? {};
const categoryMessages = (baseMessages.categories as Record<string, string>) ?? {};
const navMessages = (baseMessages.nav as Record<string, string>) ?? {};
const siteMessages = (baseMessages.site as Record<string, string>) ?? {};
const headerTranslations = buildHeaderTranslations(baseMessages);
const mobileNavMessages = buildMobileNavMessages(navMessages);

const toolNames = Object.fromEntries(
  tools.map((tool) => {
    const entry = toolsObj[tool.slug] as Record<string, unknown> | undefined;
    return [tool.slug, (entry?.name as string) || tool.slug];
  })
);
const toolDescriptions = Object.fromEntries(
  tools.map((tool) => {
    const entry = toolsObj[tool.slug] as Record<string, unknown> | undefined;
    return [tool.slug, (entry?.seo_description as string) || (entry?.description as string) || ''];
  })
);

const guide = getComparisonGuide(locale, slug, categoryMessages, toolNames, toolDescriptions);
if (!guide) {
  return Astro.redirect(`/${locale}/compare`);
}

const uiCopy = getComparisonUiCopy(locale);
const BASE_URL = getPublicSiteUrl();
const breadcrumbItems = [
  { label: navMessages.home || 'Home', href: `/${locale}` },
  { label: uiCopy.comparisonSectionTitle, href: `/${locale}/compare` },
  { label: guide.title, href: guide.href },
];
const breadcrumbData = {
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    item: `${BASE_URL}${item.href}`,
  })),
};
const collectionData = {
  name: guide.title,
  description: guide.description,
  url: `${BASE_URL}${guide.href}`,
  numberOfItems: guide.workflows.reduce((count, workflow) => count + workflow.tools.length, 0),
  hasPart: guide.workflows.flatMap((workflow) =>
    workflow.tools.map((tool) => ({
      '@type': 'SoftwareApplication',
      name: tool.name,
      description: tool.description || undefined,
      url: `${BASE_URL}${tool.href}`,
    }))
  ),
};
---

<BaseLayout
  title={guide.title}
  description={guide.description}
  locale={locale}
  canonicalPath={`/compare/${guide.slug}`}
  siteDescription={siteMessages.description}
>
  <HreflangTags path={`/compare/${guide.slug}`} slot="head" />
  <StructuredData type="BreadcrumbList" data={breadcrumbData} slot="head" />
  <StructuredData type="CollectionPage" data={collectionData} slot="head" />
  <meta property="og:title" content={`${guide.title} | U2Tool`} slot="head" />
  <meta property="og:description" content={guide.description} slot="head" />
  <meta property="og:image" content={`${BASE_URL}/og-default.svg`} slot="head" />
  <meta property="og:type" content="website" slot="head" />
  <meta property="og:url" content={`${BASE_URL}${guide.href}`} slot="head" />
  <meta name="twitter:card" content="summary_large_image" slot="head" />

  <StaticSidebar
    locale={locale}
    categories={categories}
    categoryNames={categoryMessages}
    navMessages={navMessages}
    siteName={siteMessages.name || 'U2Tool'}
  />

  <div class="main-content-with-sidebar main-content-with-mobile-nav">
    <Header client:load locale={locale} translations={headerTranslations} />

    <main class="py-6 px-4 lg:px-0 lg:pr-6">
      <div class="w-full max-w-6xl">
        <div class="mb-6">
          <Breadcrumb locale={locale} items={breadcrumbItems} />
        </div>

        <section class="rounded-3xl border border-slate-200/60 bg-gradient-to-br from-slate-50 via-white to-slate-100 shadow-xl dark:border-slate-800 dark:from-slate-900 dark:via-zinc-900 dark:to-black p-6 md:p-8 backdrop-blur-sm">
          <h1 class="text-3xl md:text-4xl font-bold text-slate-900 dark:text-white tracking-tight">{guide.title}</h1>
          <p class="mt-4 max-w-4xl text-base leading-7 text-slate-600 dark:text-slate-400">
            {guide.description}
          </p>

          <div class="mt-6 flex flex-wrap gap-2.5">
            {guide.relatedCategories.map((category) => (
              <a
                href={category.href}
                class="inline-flex items-center rounded-full border border-slate-200 bg-white/50 px-3.5 py-1.5 text-xs font-bold text-slate-700 transition-all hover:border-blue-400 hover:text-blue-600 dark:border-slate-800 dark:bg-slate-900/50 dark:text-slate-300 dark:hover:border-amber-500/50 dark:hover:text-amber-400 uppercase tracking-wider"
              >
                {category.name}
              </a>
            ))}
          </div>
        </section>

        <section class="mt-10 rounded-3xl border border-slate-200/60 bg-gradient-to-br from-white via-slate-50 to-slate-100 shadow-xl dark:border-slate-800 dark:from-slate-950 dark:via-slate-900 dark:to-slate-950 p-6 md:p-8 backdrop-blur-sm">
          <h2 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight flex items-center gap-2.5">
            <span class="w-1.5 h-7 bg-blue-600 dark:bg-amber-500 rounded-full"></span>
            {uiCopy.workflowTitle}
          </h2>
          <div class="mt-8 grid gap-5 lg:grid-cols-2">
            {guide.workflows.map((workflow) => (
              <article
                data-comparison-workflow={workflow.slug}
                class="rounded-2xl border border-slate-200 bg-white/40 p-5 backdrop-blur-md dark:border-slate-800 dark:bg-slate-900/40 hover:shadow-lg transition-all duration-300"
              >
                <h3 class="text-base font-bold text-slate-900 dark:text-white uppercase tracking-tight">
                  {workflow.title}
                </h3>
                <div class="mt-4 flex flex-wrap gap-2">
                  {workflow.tools.map((tool) => (
                    <a
                      href={tool.href}
                      data-comparison-tool={tool.slug}
                      title={tool.description || tool.name}
                      class="inline-flex items-center rounded-full border border-slate-200 bg-white/50 px-3.5 py-1.5 text-xs font-bold text-slate-700 transition-all hover:border-amber-400 hover:text-amber-600 dark:border-slate-700 dark:bg-slate-800/50 dark:text-slate-300 dark:hover:border-amber-500/50 dark:hover:text-amber-400"
                    >
                      {tool.name}
                    </a>
                  ))}
                </div>
              </article>
            ))}
          </div>
        </section>

        <section class="mt-10 rounded-3xl border border-slate-200/60 bg-white/40 p-6 md:p-8 shadow-xl backdrop-blur-md dark:border-slate-800 dark:bg-slate-900/40">
          <h2 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight flex items-center gap-2.5">
            <span class="w-1.5 h-7 bg-blue-600 dark:bg-amber-500 rounded-full"></span>
            {uiCopy.tableTitle}
          </h2>
          <div class="mt-8 overflow-x-auto overflow-y-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white/50 dark:bg-slate-950/20">
            <table class="w-full text-sm min-w-[800px] table-auto">
              <thead>
                <tr class="text-left text-[10px] font-bold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400 border-b border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/50">
                  <th class="px-6 py-4 font-bold">{uiCopy.tableToolLabel}</th>
                  <th class="px-6 py-4 font-bold border-l border-slate-200/50 dark:border-slate-800/50">{uiCopy.workflowTitle}</th>
                  <th class="px-6 py-4 font-bold border-l border-slate-200/50 dark:border-slate-800/50">{uiCopy.tableCategoryLabel}</th>
                  <th class="px-6 py-4 font-bold border-l border-slate-200/50 dark:border-slate-800/50 text-right">{uiCopy.routeLabel}</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-200/60 dark:divide-slate-800/60">
                {guide.workflows.flatMap((workflow) =>
                  workflow.tools.map((tool) => (
                    <tr class="hover:bg-blue-50/30 dark:hover:bg-amber-500/5 transition-colors group">
                      <td class="px-6 py-5 min-w-[240px]">
                        <div class="flex flex-col gap-1.5">
                          <span class="font-bold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-amber-400 transition-colors">
                            {tool.name}
                          </span>
                          <span class="text-xs leading-5 text-slate-500 dark:text-slate-400 max-w-sm line-clamp-1">
                            {tool.description}
                          </span>
                        </div>
                      </td>
                      <td class="px-6 py-5 border-l border-slate-200/30 dark:border-slate-800/30 w-max">
                        <span class="text-xs font-bold text-slate-500 dark:text-slate-500 uppercase tracking-wider">
                          {workflow.title}
                        </span>
                      </td>
                      <td class="px-6 py-5 w-auto border-l border-slate-200/30 dark:border-slate-800/30">
                        <span class="text-xs font-bold text-slate-400 dark:text-slate-600 uppercase tracking-widest bg-slate-100 dark:bg-slate-900 px-2 py-0.5 rounded border border-slate-200/50 dark:border-slate-800/50">
                          {tool.categoryName}
                        </span>
                      </td>
                      <td class="px-6 py-5 w-min border-l border-slate-200/30 dark:border-slate-800/30 text-right">
                        <a
                          href={tool.href}
                          class="inline-flex items-center justify-center px-4 py-2 rounded-xl bg-slate-950 dark:bg-white text-white dark:text-slate-950 text-[10px] font-black uppercase tracking-widest border border-slate-800 dark:border-transparent transition-all hover:bg-black dark:hover:bg-slate-100 hover:shadow-lg dark:hover:shadow-[0_0_15px_rgba(255,255,255,0.2)]"
                        >
                          {uiCopy.routeLabel}
                        </a>
                      </td>
                    </tr>
                  ))
                )}
              </tbody>
            </table>
          </div>
        </section>
      </div>
    </main>

    <Footer locale={locale} />
  </div>

  <MobileBottomNav client:load locale={locale} navMessages={mobileNavMessages} />
</BaseLayout>
