---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.svelte';
import StaticSidebar from '@/components/layout/StaticSidebar.astro';
import MobileBottomNav from '@/components/layout/MobileBottomNav.svelte';
import Footer from '@/components/layout/Footer.astro';
import Breadcrumb from '@/components/layout/Breadcrumb.astro';
import HreflangTags from '@/components/seo/HreflangTags.astro';
import StructuredData from '@/components/seo/StructuredData.astro';
import { categories, tools } from '@/config/tools';
import { locales } from '@/lib/i18n';
import type { Locale } from '@/lib/i18n';
import {
  comparisonSurfaceSlugs,
  getComparisonGuide,
  getComparisonUiCopy,
} from '@/lib/comparison-surfaces';
import { loadBaseUiMessages } from '@/lib/translations';
import { buildHeaderTranslations, buildMobileNavMessages } from '@/lib/layout-translations';
import { getPublicSiteUrl } from '@/lib/public-env';
import { buildLocalizedPagePath, getHreflang, resolveMetaDescription, withBrand } from '@/lib/seo';

export const prerender = true;

export const getStaticPaths: GetStaticPaths = () =>
  locales.flatMap((locale) =>
    comparisonSurfaceSlugs.map((slug) => ({
      params: { locale, slug },
      props: { locale, slug },
    }))
  );

const { locale, slug } = Astro.props as { locale: Locale; slug: string };
const baseMessages = await loadBaseUiMessages(locale, Astro.url);
const toolsObj = (baseMessages.tools as Record<string, unknown>) ?? {};
const categoryMessages = (baseMessages.categories as Record<string, string>) ?? {};
const navMessages = (baseMessages.nav as Record<string, string>) ?? {};
const siteMessages = (baseMessages.site as Record<string, string>) ?? {};
const headerTranslations = buildHeaderTranslations(baseMessages);
const mobileNavMessages = buildMobileNavMessages(navMessages);

const toolNames = Object.fromEntries(
  tools.map((tool) => {
    const entry = toolsObj[tool.slug] as Record<string, unknown> | undefined;
    return [tool.slug, (entry?.name as string) || tool.slug];
  })
);
const toolDescriptions = Object.fromEntries(
  tools.map((tool) => {
    const entry = toolsObj[tool.slug] as Record<string, unknown> | undefined;
    return [tool.slug, (entry?.seo_description as string) || (entry?.description as string) || ''];
  })
);

const guide = getComparisonGuide(locale, slug, categoryMessages, toolNames, toolDescriptions);
if (!guide) {
  return Astro.redirect(`/${locale}/compare/`);
}

const uiCopy = getComparisonUiCopy(locale);
const BASE_URL = getPublicSiteUrl();
const schemaLanguage = getHreflang(locale);
const pageDescription = resolveMetaDescription({
  description: guide.description,
  locale,
  title: guide.title,
});
const breadcrumbItems = [
  { label: navMessages.home || 'Home', href: buildLocalizedPagePath(locale, '/') },
  { label: uiCopy.comparisonSectionTitle, href: buildLocalizedPagePath(locale, '/compare') },
  { label: guide.title, href: guide.href },
];
const breadcrumbData = {
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    item: `${BASE_URL}${item.href}`,
  })),
};
const collectionData = {
  name: guide.title,
  description: pageDescription,
  url: `${BASE_URL}${guide.href}`,
  inLanguage: schemaLanguage,
  numberOfItems: guide.workflows.reduce((count, workflow) => count + workflow.tools.length, 0),
  hasPart: guide.workflows.flatMap((workflow) =>
    workflow.tools.map((tool) => ({
      '@type': 'SoftwareApplication',
      name: tool.name,
      description: tool.description || undefined,
      url: `${BASE_URL}${tool.href}`,
    }))
  ),
};
---

<BaseLayout
  title={guide.title}
  description={pageDescription}
  locale={locale}
  canonicalPath={`/compare/${guide.slug}`}
  siteDescription={siteMessages.description}
>
  <HreflangTags path={`/compare/${guide.slug}`} slot="head" />
  <StructuredData type="BreadcrumbList" data={breadcrumbData} slot="head" />
  <StructuredData type="CollectionPage" data={collectionData} slot="head" />
  <meta property="og:title" content={withBrand(guide.title)} slot="head" />
  <meta property="og:description" content={pageDescription} slot="head" />
  <meta property="og:image" content={`${BASE_URL}/og-default.svg`} slot="head" />
  <meta property="og:type" content="website" slot="head" />
  <meta property="og:url" content={`${BASE_URL}${guide.href}`} slot="head" />
  <meta property="og:site_name" content="U2Tool" slot="head" />
  <meta name="twitter:card" content="summary_large_image" slot="head" />
  <meta name="twitter:title" content={withBrand(guide.title)} slot="head" />
  <meta name="twitter:description" content={pageDescription} slot="head" />
  <meta name="twitter:image" content={`${BASE_URL}/og-default.svg`} slot="head" />

  <StaticSidebar
    locale={locale}
    categories={categories}
    categoryNames={categoryMessages}
    navMessages={navMessages}
    siteName={siteMessages.name || 'U2Tool'}
  />

  <div class="main-content-with-sidebar main-content-with-mobile-nav">
    <Header client:load locale={locale} translations={headerTranslations} />

    <main class="py-6 px-4 lg:px-6">
      <div class="max-w-none mx-0">
        <div class="mb-6">
          <Breadcrumb locale={locale} items={breadcrumbItems} />
        </div>

        <!-- Hero Section -->
        <section class="rounded-[2.5rem] border border-slate-200/60 glass shadow-2xl dark:border-white/10 dark:bg-slate-950/40 p-8 md:p-14 backdrop-blur-3xl relative overflow-hidden group">
          <div class="absolute inset-0 bg-gradient-to-br from-transparent via-transparent to-amber-500/10 opacity-60"></div>
          <div class="absolute -right-24 -top-24 w-64 h-64 bg-amber-500/10 rounded-full blur-3xl group-hover:bg-amber-500/20 transition-all duration-700"></div>
          <div class="relative z-10 w-full max-w-none">
            <h1 class="text-4xl md:text-6xl font-black text-slate-900 dark:text-white tracking-tight leading-[1.1]">{guide.title}</h1>
            <p class="mt-6 max-w-4xl text-lg md:text-xl leading-relaxed text-slate-600 dark:text-slate-400 font-medium">
              {guide.description}
            </p>

            <div class="mt-10 flex flex-wrap gap-3">
              {guide.relatedCategories.map((category) => (
                <a
                  href={category.href}
                  class="inline-flex items-center rounded-full border border-slate-200 bg-white/60 px-5 py-2.5 text-[10px] font-black text-slate-700 transition-all hover:border-amber-400 hover:text-amber-600 dark:border-white/10 dark:bg-white/5 dark:text-slate-400 dark:hover:border-amber-500/50 dark:hover:text-amber-400 uppercase tracking-[0.2em] shadow-sm active:scale-95"
                >
                  {category.name}
                </a>
              ))}
            </div>
          </div>
        </section>

        <!-- Workflow Section -->
        <section class="mt-12 glass-card p-8 md:p-12 transition-all hover:shadow-amber-500/10">
          <h2 class="text-2xl md:text-3xl font-black text-slate-900 dark:text-white tracking-tight flex items-center gap-4">
            <span class="w-1.5 h-10 bg-gradient-to-b from-amber-400 to-amber-600 rounded-full shadow-[0_0_15px_rgba(245,158,11,0.5)]"></span>
            {uiCopy.workflowTitle}
          </h2>
          <div class="mt-12 grid gap-8 lg:grid-cols-2">
            {guide.workflows.map((workflow) => (
              <article
                data-comparison-workflow={workflow.slug}
                class="rounded-[2rem] border border-slate-200 dark:border-white/5 bg-slate-100/30 dark:bg-white/[0.02] p-8 backdrop-blur-md hover:border-amber-500/40 transition-all duration-500 group/workflow shadow-sm relative overflow-hidden h-full flex flex-col"
              >
                <div class="absolute inset-0 bg-gradient-to-tr from-amber-500/5 to-transparent opacity-0 group-hover/workflow:opacity-100 transition-opacity duration-500"></div>
                <h3 class="text-[10px] font-black text-amber-600 dark:text-amber-500/80 uppercase tracking-[0.3em] mb-6">
                  {workflow.title}
                </h3>
                <div class="mt-auto flex flex-wrap gap-3">
                  {workflow.tools.map((tool) => (
                    <a
                      href={tool.href}
                      data-comparison-tool={tool.slug}
                      title={tool.description || tool.name}
                      class="inline-flex items-center rounded-2xl border border-slate-200/60 bg-white/80 px-5 py-3 text-xs font-bold text-slate-700 transition-all hover:border-amber-500/50 hover:text-amber-600 dark:border-white/10 dark:bg-slate-900/60 dark:text-slate-300 dark:hover:border-amber-500/50 dark:hover:text-amber-400 shadow-sm hover:shadow-md hover:-translate-y-0.5 active:translate-y-0 active:scale-95"
                    >
                      {tool.name}
                    </a>
                  ))}
                </div>
              </article>
            ))}
          </div>
        </section>

        <!-- Comparison Table Section -->
        <section class="mt-12 glass-card p-0 md:p-0 shadow-2xl transition-all hover:shadow-amber-500/10 overflow-hidden border-none cursor-default">
          <div class="p-8 md:p-12 pb-0">
            <h2 class="text-2xl md:text-3xl font-black text-slate-900 dark:text-white tracking-tight flex items-center gap-4">
              <span class="w-1.5 h-10 bg-gradient-to-b from-amber-400 to-amber-600 rounded-full shadow-[0_0_15px_rgba(245,158,11,0.5)]"></span>
              {uiCopy.tableTitle}
            </h2>
          </div>
          
          <div class="mt-10 overflow-x-auto border-t border-slate-200 dark:border-white/10 bg-white/40 dark:bg-slate-950/40 backdrop-blur-xl relative">
            <table class="w-full text-sm min-w-[900px] table-fixed border-collapse">
              <thead>
                <tr class="text-left text-[10px] font-black uppercase tracking-[0.25em] text-slate-400/80 dark:text-slate-500 border-b border-slate-200 dark:border-white/10 glass-nav !bg-slate-50/90 dark:!bg-slate-950/95 sticky top-0 z-20">
                  <th class="px-10 py-6 w-2/5">{uiCopy.tableToolLabel}</th>
                  <th class="px-10 py-6 w-1/5 border-l border-slate-200/50 dark:border-white/10">{uiCopy.workflowTitle}</th>
                  <th class="px-10 py-6 w-1/5 border-l border-slate-200/50 dark:border-white/10">{uiCopy.tableCategoryLabel}</th>
                  <th class="px-10 py-6 w-[160px] border-l border-slate-200/50 dark:border-white/10 text-center">{uiCopy.routeLabel}</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-200 dark:divide-white/5">
                {guide.workflows.flatMap((workflow) =>
                  workflow.tools.map((tool) => (
                    <tr class="hover:bg-amber-500/[0.03] dark:hover:bg-amber-500/[0.05] transition-all duration-300 group/row">
                      <td class="px-10 py-8">
                        <div class="flex flex-col gap-2">
                          <span class="font-black text-lg text-slate-900 dark:text-white group-hover/row:text-amber-600 dark:group-hover/row:text-amber-500 transition-colors tracking-tight">
                            {tool.name}
                          </span>
                          <span class="text-xs leading-relaxed text-slate-500 dark:text-slate-400 max-w-sm line-clamp-2">
                            {tool.description}
                          </span>
                        </div>
                      </td>
                      <td class="px-10 py-8 border-l border-slate-200/50 dark:border-white/5">
                        <span class="inline-block text-[9px] font-black text-amber-700 dark:text-amber-500/80 uppercase tracking-[.15em] bg-amber-500/10 dark:bg-amber-500/5 px-3 py-1.5 rounded-lg border border-amber-500/20 shadow-sm">
                          {workflow.title}
                        </span>
                      </td>
                      <td class="px-10 py-8 border-l border-slate-200/50 dark:border-white/5">
                        <span class="text-[10px] font-black text-slate-700 dark:text-amber-200/70 uppercase tracking-widest">
                          {tool.categoryName}
                        </span>
                      </td>
                      <td class="px-10 py-8 border-l border-slate-200/50 dark:border-white/5 text-center">
                        <a
                          href={tool.href}
                          class="btn-primary !px-5 !py-2.5 !text-[9px] !rounded-xl active:scale-95"
                        >
                          {uiCopy.routeLabel}
                        </a>
                      </td>
                    </tr>
                  ))
                )}
              </tbody>
            </table>
          </div>
        </section>
      </div>
    </main>

    <Footer locale={locale} />
  </div>

  <MobileBottomNav client:load locale={locale} navMessages={mobileNavMessages} />
</BaseLayout>
