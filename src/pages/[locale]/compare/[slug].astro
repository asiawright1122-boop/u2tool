---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.svelte';
import StaticSidebar from '@/components/layout/StaticSidebar.astro';
import MobileBottomNav from '@/components/layout/MobileBottomNav.svelte';
import Footer from '@/components/layout/Footer.astro';
import Breadcrumb from '@/components/layout/Breadcrumb.astro';
import HreflangTags from '@/components/seo/HreflangTags.astro';
import StructuredData from '@/components/seo/StructuredData.astro';
import { categories, tools } from '@/config/tools';
import { locales } from '@/lib/i18n';
import type { Locale } from '@/lib/i18n';
import {
  comparisonSurfaceSlugs,
  getComparisonGuide,
  getComparisonUiCopy,
} from '@/lib/comparison-surfaces';
import { loadBaseMessages } from '@/lib/translations';
import { buildHeaderTranslations, buildMobileNavMessages } from '@/lib/layout-translations';
import { getPublicSiteUrl } from '@/lib/public-env';

export const prerender = true;

export const getStaticPaths: GetStaticPaths = () =>
  locales.flatMap((locale) =>
    comparisonSurfaceSlugs.map((slug) => ({
      params: { locale, slug },
      props: { locale, slug },
    }))
  );

const { locale, slug } = Astro.props as { locale: Locale; slug: string };
const baseMessages = await loadBaseMessages(locale);
const toolsObj = (baseMessages.tools as Record<string, unknown>) ?? {};
const categoryMessages = (baseMessages.categories as Record<string, string>) ?? {};
const navMessages = (baseMessages.nav as Record<string, string>) ?? {};
const siteMessages = (baseMessages.site as Record<string, string>) ?? {};
const headerTranslations = buildHeaderTranslations(baseMessages);
const mobileNavMessages = buildMobileNavMessages(navMessages);

const toolNames = Object.fromEntries(
  tools.map((tool) => {
    const entry = toolsObj[tool.slug] as Record<string, unknown> | undefined;
    return [tool.slug, (entry?.name as string) || tool.slug];
  })
);
const toolDescriptions = Object.fromEntries(
  tools.map((tool) => {
    const entry = toolsObj[tool.slug] as Record<string, unknown> | undefined;
    return [tool.slug, (entry?.seo_description as string) || (entry?.description as string) || ''];
  })
);

const guide = getComparisonGuide(locale, slug, categoryMessages, toolNames, toolDescriptions);
if (!guide) {
  return Astro.redirect(`/${locale}/compare`);
}

const uiCopy = getComparisonUiCopy(locale);
const BASE_URL = getPublicSiteUrl();
const breadcrumbItems = [
  { label: navMessages.home || 'Home', href: `/${locale}` },
  { label: uiCopy.comparisonSectionTitle, href: `/${locale}/compare` },
  { label: guide.title, href: guide.href },
];
const breadcrumbData = {
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    item: `${BASE_URL}${item.href}`,
  })),
};
const collectionData = {
  name: guide.title,
  description: guide.description,
  url: `${BASE_URL}${guide.href}`,
  numberOfItems: guide.workflows.reduce((count, workflow) => count + workflow.tools.length, 0),
  hasPart: guide.workflows.flatMap((workflow) =>
    workflow.tools.map((tool) => ({
      '@type': 'SoftwareApplication',
      name: tool.name,
      description: tool.description || undefined,
      url: `${BASE_URL}${tool.href}`,
    }))
  ),
};
---

<BaseLayout
  title={guide.title}
  description={guide.description}
  locale={locale}
  canonicalPath={`/compare/${guide.slug}`}
  siteDescription={siteMessages.description}
>
  <HreflangTags path={`/compare/${guide.slug}`} slot="head" />
  <StructuredData type="BreadcrumbList" data={breadcrumbData} slot="head" />
  <StructuredData type="CollectionPage" data={collectionData} slot="head" />
  <meta property="og:title" content={`${guide.title} | U2Tool`} slot="head" />
  <meta property="og:description" content={guide.description} slot="head" />
  <meta property="og:image" content={`${BASE_URL}/og-default.svg`} slot="head" />
  <meta property="og:type" content="website" slot="head" />
  <meta property="og:url" content={`${BASE_URL}${guide.href}`} slot="head" />
  <meta name="twitter:card" content="summary_large_image" slot="head" />

  <StaticSidebar
    locale={locale}
    categories={categories}
    categoryNames={categoryMessages}
    navMessages={navMessages}
    siteName={siteMessages.name || 'U2Tool'}
  />

  <div class="main-content-with-sidebar main-content-with-mobile-nav">
    <Header client:load locale={locale} translations={headerTranslations} />

    <main class="py-6 px-4 lg:px-0 lg:pr-6">
      <div class="w-full max-w-6xl">
        <div class="mb-6">
          <Breadcrumb locale={locale} items={breadcrumbItems} />
        </div>

        <section class="u2-surface p-6">
          <h1 class="text-3xl font-bold text-[color:rgb(var(--u2-ink))]">{guide.title}</h1>
          <p class="mt-4 max-w-4xl text-sm leading-7 text-[color:rgb(var(--u2-ink-soft))]">
            {guide.description}
          </p>

          <div class="mt-5 flex flex-wrap gap-2">
            {guide.relatedCategories.map((category) => (
              <a
                href={category.href}
                class="u2-chip u2-chip-warm"
              >
                {category.name}
              </a>
            ))}
          </div>
        </section>

        <section class="mt-8 u2-surface p-6">
          <h2 class="text-2xl font-bold text-[color:rgb(var(--u2-ink))]">{uiCopy.workflowTitle}</h2>
          <div class="mt-6 grid gap-5 lg:grid-cols-2">
            {guide.workflows.map((workflow) => (
              <article
                data-comparison-workflow={workflow.slug}
                class="u2-glass-panel"
              >
                <h3 class="text-base font-semibold text-[color:rgb(var(--u2-ink))]">
                  {workflow.title}
                </h3>
                <div class="mt-4 flex flex-wrap gap-2">
                  {workflow.tools.map((tool) => (
                    <a
                      href={tool.href}
                      data-comparison-tool={tool.slug}
                      title={tool.description || tool.name}
                      class="u2-glass-chip text-xs"
                    >
                      {tool.name}
                    </a>
                  ))}
                </div>
              </article>
            ))}
          </div>
        </section>

        <section class="mt-8 u2-surface p-6">
          <h2 class="text-2xl font-bold text-[color:rgb(var(--u2-ink))]">{uiCopy.tableTitle}</h2>
          <div class="mt-5 overflow-x-auto overflow-y-hidden">
            <table class="w-full text-sm min-w-[800px] table-auto">
              <thead class="bg-slate-50/50 dark:bg-slate-800/50">
                <tr class="text-left text-xs uppercase tracking-[0.18em] text-[color:rgb(var(--u2-ink-muted))]">
                  <th class="px-4 py-3 min-w-[240px] font-semibold">{uiCopy.tableToolLabel}</th>
                  <th class="px-4 py-3 whitespace-nowrap font-semibold border-l border-slate-200/50 dark:border-slate-700/50">{uiCopy.workflowTitle}</th>
                  <th class="px-4 py-3 whitespace-nowrap font-semibold border-l border-slate-200/50 dark:border-slate-700/50">{uiCopy.tableCategoryLabel}</th>
                  <th class="px-4 py-3 whitespace-nowrap font-semibold border-l border-slate-200/50 dark:border-slate-700/50">{uiCopy.routeLabel}</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-200/70 dark:divide-slate-700/70">
                {guide.workflows.flatMap((workflow) =>
                  workflow.tools.map((tool) => (
                    <tr class="hover:bg-[color:rgba(var(--u2-accent),0.02)] transition-colors">
                      <td class="px-4 py-4 min-w-[240px]">
                        <div class="flex flex-col gap-1.5">
                          <span class="font-bold text-[color:rgb(var(--u2-ink))]">
                            {tool.name}
                          </span>
                          <span class="text-xs leading-5 text-[color:rgb(var(--u2-ink-soft))]">
                            {tool.description}
                          </span>
                        </div>
                      </td>
                      <td class="px-4 py-4 border-l border-slate-200/30 dark:border-slate-700/30 w-max" style="white-space: nowrap;">
                        <span class="text-[13px] text-[color:rgb(var(--u2-ink-soft))] whitespace-nowrap inline-block" style="white-space: nowrap;">
                          {workflow.title}
                        </span>
                      </td>
                      <td class="px-4 py-4 w-auto whitespace-nowrap border-l border-slate-200/30 dark:border-slate-700/30" style="white-space: nowrap;">
                        <span class="text-[13px] text-[color:rgb(var(--u2-ink-muted))] whitespace-nowrap flex-shrink-0 inline-block" style="white-space: nowrap;">
                          {tool.categoryName}
                        </span>
                      </td>
                      <td class="px-4 py-4 w-min whitespace-nowrap border-l border-slate-200/30 dark:border-slate-700/30 text-right" style="white-space: nowrap;">
                        <a
                          href={tool.href}
                          class="u2-button-primary u2-button-compact text-xs cursor-pointer inline-flex items-center justify-center whitespace-nowrap flex-shrink-0 shadow-sm"
                          style="white-space: nowrap; word-break: keep-all; padding-left: 1rem; padding-right: 1rem; min-width: max-content;"
                        >
                          {uiCopy.routeLabel}
                        </a>
                      </td>
                    </tr>
                  ))
                )}
              </tbody>
            </table>
          </div>
        </section>
      </div>
    </main>

    <Footer locale={locale} />
  </div>

  <MobileBottomNav client:load locale={locale} navMessages={mobileNavMessages} />
</BaseLayout>
