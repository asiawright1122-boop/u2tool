---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.svelte';
import GlobalSearch from '@/components/ui/GlobalSearch.svelte';
import StaticSidebar from '@/components/layout/StaticSidebar.astro';
import Footer from '@/components/layout/Footer.astro';
import MobileBottomNav from '@/components/layout/MobileBottomNav.svelte';
import { categories } from '@/config/tools';
import { loadBaseMessages } from '@/lib/translations';
import { buildHeaderTranslations, buildMobileNavMessages } from '@/lib/layout-translations';

export const prerender = true;

const locale = 'en'; // Default for 404
const baseMessages = await loadBaseMessages(locale);
const navMessages = (baseMessages.nav as Record<string, string>) ?? {};
const siteMessages = (baseMessages.site as Record<string, string>) ?? {};
const categoryMessages = (baseMessages.categories as Record<string, string>) ?? {};
const headerTranslations = buildHeaderTranslations(baseMessages);
const mobileNavMessages = buildMobileNavMessages(navMessages);

Astro.response.status = 404;
---

<BaseLayout
  title="Page Not Found"
  description="The page you requested could not be found."
  locale={locale}
>
  <StaticSidebar
    slot="default"
    locale={locale}
    categories={categories}
    categoryNames={categoryMessages}
    navMessages={navMessages}
    siteName={siteMessages.name || 'U2Tool'}
  />

  <div class="main-content-with-sidebar main-content-with-mobile-nav min-h-screen flex flex-col items-center">
    <Header client:load locale={locale} translations={headerTranslations} />
    
    <main class="flex-1 flex items-center justify-center p-6 text-center">
      <div class="max-w-2xl">
        <div class="relative inline-block mb-10">
          <h1 class="text-[120px] md:text-[180px] font-black leading-none bg-gradient-to-b from-amber-400 via-amber-200 to-amber-600 bg-clip-text text-transparent opacity-20 dark:opacity-40 animate-pulse">
            404
          </h1>
          <div class="absolute inset-x-0 top-1/2 -translate-y-1/2 flex items-center justify-center pointer-events-none">
            <h2 class="text-2xl md:text-3xl font-black uppercase tracking-[0.3em] text-slate-900 dark:text-white drop-shadow-[0_4px_16px_rgba(0,0,0,0.5)]">
              LOST IN THE VOID
            </h2>
          </div>
        </div>
        
        <div class="max-w-md mx-auto mb-12">
          <p class="text-slate-600 dark:text-slate-400 text-base mb-8 font-medium italic">
            "Searching for a tool that isn't here? Try the search bar below."
          </p>
          <div class="glass-card p-2 rounded-2xl ring-1 ring-amber-500/20 shadow-[0_0_30px_rgba(245,158,11,0.05)]">
            <GlobalSearch client:load locale={locale} translations={headerTranslations} />
          </div>
        </div>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
          <a
            href={`/${locale}`}
            class="btn-primary w-full sm:w-auto h-14 px-10 flex items-center justify-center gap-2 group"
          >
            Go to Homepage
          </a>
          <a
            href={`/${locale}/tools`}
            class="btn-secondary w-full sm:w-auto h-14 px-10 flex items-center justify-center gap-2 group"
          >
            Browse All Tools
          </a>
        </div>
      </div>
    </main>

    <Footer locale={locale} />
  </div>

  <MobileBottomNav client:load locale={locale} navMessages={mobileNavMessages} />
</BaseLayout>
