# Base URL for sitemap and canonical URLs
NEXT_PUBLIC_BASE_URL=https://your-domain.com

# Google Analytics (optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google AdSense (optional)
NEXT_PUBLIC_ADSENSE_ID=ca-pub-XXXXXXXXXX

# ========================================
# 搜索引擎站长验证码 (SEO Verification)
# ========================================

# Google Search Console 验证码
# 获取地址: https://search.google.com/search-console
GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools 验证码
# 获取地址: https://www.bing.com/webmasters
BING_SITE_VERIFICATION=

# Bing Webmaster Tools API Key (用于 URL Submission API)
# 获取地址: Bing Webmaster Tools -> Settings -> API Access -> API Key
BING_API_KEY=

# 百度站长平台验证码
# 获取地址: https://ziyuan.baidu.com/
BAIDU_SITE_VERIFICATION=

# Yandex Webmaster 验证码
# 获取地址: https://webmaster.yandex.com/
YANDEX_SITE_VERIFICATION=

# 360站长平台验证码
# 获取地址: https://zhanzhang.so.com/
SO360_SITE_VERIFICATION=

# ========================================
# IndexNow 配置 (快速索引)
# ========================================

# IndexNow API Key
# 用于快速通知搜索引擎页面更新
# 需要在 public 目录下创建同名的 .txt 文件
# 例如: INDEXNOW_KEY=abc123 则需要创建 public/abc123.txt 文件，内容为 abc123
INDEXNOW_KEY=

# ========================================
# 百度站长 API 推送配置
# ========================================

# 百度站长推送 Token
# 获取地址: https://ziyuan.baidu.com/ -> 资源提交 -> 普通收录 -> API提交
# 从推送接口 URL 中获取 token 参数
BAIDU_PUSH_TOKEN=
BAIDU_SITE=https://your-domain.com

# ========================================
# AI 翻译配置 (SiliconFlow)
# ========================================

# SiliconFlow API Key
# 获取地址: https://cloud.siliconflow.cn/
# 免费额度: 注册即送，支持 Qwen2.5-7B 等免费模型
SILICONFLOW_API_KEY=
