# Base URL for sitemap and canonical URLs
NEXT_PUBLIC_BASE_URL=https://your-domain.com

# Google Analytics (optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google AdSense (optional)
NEXT_PUBLIC_ADSENSE_ID=ca-pub-XXXXXXXXXX

# ========================================
# 搜索引擎站长验证码 (SEO Verification)
# ========================================

# Google Search Console 验证码
# 获取地址: https://search.google.com/search-console
GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools 验证码
# 获取地址: https://www.bing.com/webmasters
BING_SITE_VERIFICATION=

# 百度站长平台验证码
# 获取地址: https://ziyuan.baidu.com/
BAIDU_SITE_VERIFICATION=

# Yandex Webmaster 验证码
# 获取地址: https://webmaster.yandex.com/
YANDEX_SITE_VERIFICATION=

# 360站长平台验证码
# 获取地址: https://zhanzhang.so.com/
SO360_SITE_VERIFICATION=
