{
  "name": "astro-u2tool",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/prepare-public-messages.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/prepare-public-messages.mjs",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 astro build",
    "postbuild": "node scripts/cleanup-public-messages.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "report:content-trust": "node scripts/validation/content-trust-audit.mjs",
    "report:gsc-coverage": "node --import tsx/esm scripts/seo/gsc-coverage-report.ts",
    "report:gsc-drilldown": "node --import tsx/esm scripts/seo/gsc-drilldown-url-report.ts",
    "report:gsc-recovery": "node --import tsx/esm scripts/seo/gsc-recovery-report.ts",
    "report:gsc-validation-matrix": "node --import tsx/esm scripts/seo/gsc-validation-action-matrix.ts",
    "report:gsc-technical-blockers": "node --import tsx/esm scripts/seo/gsc-technical-blocker-live-check.ts",
    "check:gsc-recovery-inputs": "node --import tsx/esm scripts/seo/check-gsc-recovery-inputs.ts",
    "report:runtime-debt": "node --import tsx/esm scripts/validation/generate-runtime-debt-inventory.ts",
    "report:seo-alignment": "node --import tsx/esm scripts/validation/generate-seo-alignment-report.ts",
    "validate:production-routes": "node scripts/validation/verify-production-routes.mjs",
    "validate:seo-alignment": "node --import tsx/esm scripts/validation/seo-alignment-audit.ts",
    "validate:technical-seo": "node --import tsx/esm scripts/validation/validate-technical-seo.ts",
    "validate:sitemap-url-health": "node --import tsx/esm scripts/validation/validate-sitemap-url-health.ts",
    "validate:llms-discovery": "node --import tsx/esm scripts/validation/validate-llms-discovery.ts",
    "validate:rendered-seo": "node --import tsx/esm scripts/validation/validate-rendered-seo.ts",
    "validate:localized-longtail-support": "node --import tsx/esm scripts/validation/validate-localized-longtail-support.ts",
    "validate:worker-ssr": "node --import tsx/esm scripts/validation/validate-worker-ssr-health.ts",
    "validate:growth-surfaces": "node --import tsx/esm scripts/validation/validate-growth-surfaces.ts",
    "validate:internal-link-canonicals": "node --import tsx/esm scripts/validation/validate-internal-link-canonicals.ts",
    "validate:html-links": "node --import tsx/esm scripts/validation/validate-html-links.ts",
    "validate:search-engine-compliance": "node --import tsx/esm scripts/validation/validate-search-engine-compliance.ts",
    "planning:traceability": "node --import tsx/esm scripts/planning/generate-traceability-report.ts",
    "qa:seo-governance": "npm run i18n:check-missing-keys && npm run validate:localized-longtail-support && npx vitest run src/messages/seo-governance.test.ts src/lib/seo.test.ts src/lib/translations.test.ts src/lib/category-support.test.ts src/lib/discovery-surface.test.ts src/lib/comparison-surfaces.test.ts src/lib/creator-seo-cluster.test.ts src/lib/image-tool-cluster.test.ts src/lib/chart-tool-cluster.test.ts src/lib/developer-data-tool-cluster.test.ts src/lib/online-calculator-cluster.test.ts src/lib/pdf-document-tool-cluster.test.ts src/lib/security-tool-cluster.test.ts src/lib/text-writing-tool-cluster.test.ts src/lib/support-content-fallback.test.ts src/components/tools/tools-grid-search.test.ts",
    "qa:theme-parity": "npx vitest run src/lib/theme.test.ts src/lib/theme-contract.test.ts src/hooks/useChartTheme.test.ts",
    "qa:runtime-integrity": "npx vitest run src/lib/tool-stubs-runtime.test.ts",
    "qa:tool-locales": "npx tsx scripts/validation/validate-tool-locales.ts",
    "qa:changed-tool-locales": "npx tsx scripts/validation/validate-changed-tool-locales.ts",
    "validate:runtime-placeholder-regressions": "node --import tsx/esm scripts/validation/validate-runtime-placeholder-regressions.ts",
    "validate:tool-svg-rendering": "node --import tsx/esm scripts/validation/validate-tool-svg-rendering.ts",
    "qa:production": "npm run check && npm run qa:seo-governance && npm run qa:theme-parity && npm run qa:runtime-integrity && npm run validate:runtime-placeholder-regressions && npm run validate:tool-svg-rendering && npm run build && npm run validate:html-links && npm run validate:production-routes && npm run validate:seo-alignment && npm run validate:technical-seo && npm run validate:llms-discovery && npm run validate:rendered-seo && npm run validate:worker-ssr && npm run validate:growth-surfaces && npm run validate:internal-link-canonicals && npm run validate:search-engine-compliance",
    "qa:smoke": "node --import tsx/esm scripts/validation/smoke-e2e.ts",
    "verify:production": "npm run qa:production && npm run qa:smoke && npm run report:seo-alignment && npm run planning:traceability && npm run health:check",
    "qa:ai-discovery": "npx vitest run src/lib/ai-discovery/*.test.ts && npm run build",
    "qa:ai-discovery:strict": "npm run qa:ai-discovery && npm run check",
    "qa:ai-discovery:regression": "npx vitest run src/lib/ai-discovery/regression-cases.test.ts",
    "qa:ai-discovery:analyze-telemetry": "node scripts/ai-discovery/analyze-telemetry.mjs",
    "qa:ai-discovery:seed-regression": "node scripts/ai-discovery/generate-regression-cases.mjs",
    "qa:ai-discovery:merge-regression": "node scripts/ai-discovery/merge-regression-cases.mjs",
    "qa:ai-discovery:quality-loop": "node scripts/ai-discovery/run-quality-loop.mjs",
    "cleanup:temp-files": "npx tsx scripts/cleanup/cleanup-temp-files.ts",
    "cleanup:dry-run": "npx tsx scripts/cleanup/cleanup-temp-files.ts --dry-run",
    "i18n:fill-missing-keys": "npx tsx scripts/maintenance/fill-missing-translation-keys.ts",
    "i18n:check-missing-keys": "npx tsx scripts/maintenance/fill-missing-translation-keys.ts --check",
    "tools:localize-spec": "npx tsx scripts/tools/localize-tool-spec.ts",
    "tools:onboard": "npx tsx scripts/tools/onboard-tool.ts",
    "tools:launch": "npx tsx scripts/tools/launch-tool-batch.ts",
    "tools:generate-import-map": "npx tsx scripts/generate-tool-import-map.ts",
    "spec:list": "npx tsx scripts/spec-lifecycle/list-active-specs.ts",
    "spec:archive": "npx tsx scripts/spec-lifecycle/archive-spec.ts",
    "spec:archive-all": "npx tsx scripts/spec-lifecycle/archive-all-completed.ts",
    "fix:types": "npx tsx scripts/type-fixes/fix-type-imports.ts",
    "validate:fixes": "npx tsx scripts/validation/validate-historical-fixes.ts",
    "health:check": "node --import tsx/esm scripts/maintenance/check-project-health.ts",
    "build:analyze": "npx tsx scripts/build-optimization/analyze-build.ts",
    "perf:benchmark": "npx tsx scripts/performance/benchmark.ts run",
    "perf:compare": "npx tsx scripts/performance/benchmark.ts compare",
    "deps:audit": "npm audit --omit=dev",
    "hooks:install": "npx tsx scripts/git-hooks/install-hooks.ts",
    "health:check:strict": "npm run verify:production",
    "submit:indexnow": "node scripts/submit-indexnow.js",
    "submit:indexnow:dry": "node scripts/submit-indexnow.js --dry-run",
    "validate:sitemap": "node scripts/validate-sitemap-fix.js"
  },
  "dependencies": {
    "dompurify": "^3.4.2",
    "echarts": "^6.0.0",
    "echarts-liquidfill": "^3.1.0",
    "echarts-wordcloud": "^2.1.0",
    "exifreader": "^4.36.2",
    "file-saver": "^2.0.5",
    "gif.js": "^0.2.0",
    "gifuct-js": "^2.1.2",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.14.0",
    "js-yaml": "^4.1.1",
    "jsbarcode": "^3.12.3",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-svelte": "^0.575.0",
    "mammoth": "^1.11.0",
    "marked": "^17.0.3",
    "opencc-js": "^1.0.5",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.624",
    "pinyin-pro": "^3.28.1",
    "qrcode": "^1.5.4",
    "svelte": "^5.55.5",
    "typescript": "^5.7.0",
    "uuid": "^13.0.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/cloudflare": "^13.3.1",
    "@astrojs/svelte": "^8.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.3.5",
    "@types/qrcode": "^1.5.6",
    "astro": "^6.2.2",
    "depcheck": "^1.4.7",
    "fast-check": "^4.6.0",
    "fs-extra": "^11.3.4",
    "glob": "^13.0.6",
    "ignore": "^7.0.5",
    "puppeteer": "^24.38.0",
    "tailwindcss": "^4.1.0",
    "ts-morph": "^27.0.2",
    "tsx": "^4.20.6",
    "vitest": "^4.0.18",
    "wrangler": "^4.88.0"
  }
}
